<Window x:Class="imgsaver.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Manager" Width="920" Height="660"
        MinWidth="760" MinHeight="520"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DownloadActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DownloadCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DownloadActionButtonStyle}">
            <Setter Property="Foreground" Value="#ff7a7a"/>
            <Setter Property="BorderBrush" Value="#7a3f45"/>
        </Style>

        <Style x:Key="DownloadChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#202833"/>
            <Setter Property="BorderBrush" Value="#35414f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,9,0">
                            <TextBlock Text="DM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Download Manager" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                            <TextBlock Text="Parallel parts, queue, and history" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="Settings" Click="BtnSettings_Click" Style="{StaticResource TitleBarButtonStyle}" Width="82" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="Folder" Click="BtnOpenFolder_Click" Style="{StaticResource TitleBarButtonStyle}" Width="70" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="X" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnTabActive" Content="Downloading" Click="BtnTabActive_Click" Height="31" Padding="16,0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" x:Name="BtnTabHistory" Content="Completed" Click="BtnTabHistory_Click" Height="31" Padding="16,0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" x:Name="BtnClearHistory" Content="Clear History" Click="BtnClearHistory_Click" Height="29" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Background="{StaticResource BackgroundBrush}">
                <ListBox x:Name="LstDownloads" BorderThickness="0" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="4" Width="40" Height="40" CornerRadius="6" Background="#1b3340" BorderBrush="#2f596b" BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="10" FontWeight="Bold" Foreground="#8ee6ff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource DownloadChipStyle}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding DisplayUrl}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/>

                                    <Grid Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,11,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ProgressBar Grid.Row="0" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="7" Background="#182029" Foreground="{StaticResource AccentBrush}"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Parts}" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="132" Margin="0,0,6,6" Padding="8,7" Background="#1b222c" BorderBrush="#2a3441" BorderThickness="1" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding PartLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="10" FontWeight="SemiBold" Foreground="#8ee6ff"/>

                                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Background="#151b22" Foreground="#4cd97b" Margin="0,6,0,4"/>

                                                            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding DownloadedSizeText}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                        <TextBlock Text=" / " FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                        <TextBlock Text="{Binding TotalSizeText}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding RemainingTime}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding PartSummaryText}" FontSize="11" Foreground="#8ee6ff"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Button x:Name="BtnPauseResume" Content="{Binding PauseResumeIcon}" Style="{StaticResource DownloadActionButtonStyle}" Click="BtnPauseResume_Click" Tag="{Binding}" Margin="0,0,7,0" IsEnabled="{Binding CanPauseResume}" ToolTip="Pause or resume"/>
                                        <Button x:Name="BtnCancel" Content="X" Style="{StaticResource DownloadCancelButtonStyle}" Click="BtnCancel_Click" Tag="{Binding}" IsEnabled="{Binding CanCancel}" ToolTip="Cancel download"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Border Width="58" Height="58" CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtEmptyIcon" Text="DM" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Downloads" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" TextAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="New downloads will appear here." FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStats" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Run Text="Active: "/>
                        <Run x:Name="TxtActiveCount" Text="0"/>
                    </TextBlock>
                    <Button Grid.Column="2" Content="Add Download" Click="BtnAddDownload_Click" Height="29" Padding="13,0" Style="{StaticResource SecondaryButtonStyle}" Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
