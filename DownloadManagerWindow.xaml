<Window x:Class="imgsaver.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Manager" Width="800" Height="600"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DownloadActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DownloadCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DownloadActionButtonStyle}">
            <Setter Property="Foreground" Value="#ff6b6b"/>
            <Setter Property="BorderBrush" Value="#664444"/>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="📥 Download Manager" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="Settings" Click="BtnSettings_Click" Style="{StaticResource TitleBarButtonStyle}" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="📂 Open Folder" Click="BtnOpenFolder_Click" Style="{StaticResource TitleBarButtonStyle}" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabs -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnTabActive" Content="📥 Downloading" Click="BtnTabActive_Click" Height="30" Padding="14,0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" x:Name="BtnTabHistory" Content="✓ Completed" Click="BtnTabHistory_Click" Height="30" Padding="14,0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" x:Name="BtnClearHistory" Content="🗑 Clear History" Click="BtnClearHistory_Click" Height="28" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="2">
                <ListBox x:Name="LstDownloads" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="2,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Row="0" Grid.RowSpan="4" Width="36" Height="36" CornerRadius="8" Background="{StaticResource InputBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- File Info -->
                                    <Grid Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                    </Grid>

                                    <!-- URL -->
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding DisplayUrl}" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                    <!-- Progress -->
                                    <ItemsControl Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Parts}" Margin="0,8,0,0" Height="10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="10" Margin="0,0,3,0" Background="#252b33" CornerRadius="4" ClipToBounds="True" BorderBrush="#303844" BorderThickness="1">
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" Background="Transparent" Foreground="#29c46a"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Stats -->
                                    <TextBlock Grid.Column="1" Grid.Row="3" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding DownloadedSizeText, Mode=OneWay}"/><Run Text=" / "/>
                                        <Run Text="{Binding TotalSizeText, Mode=OneWay}"/><Run Text=" - "/>
                                        <Run Text="{Binding SpeedText, Mode=OneWay}"/><Run Text=" - "/>
                                        <Run Text="{Binding RemainingTime}"/>
                                    </TextBlock>

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="BtnPauseResume" Content="{Binding PauseResumeIcon}" Style="{StaticResource DownloadActionButtonStyle}" Click="BtnPauseResume_Click" Tag="{Binding}" Margin="0,0,6,0" IsEnabled="{Binding CanPauseResume}" ToolTip="Pause / resume"/>
                                        <Button x:Name="BtnCancel" Content="✕" Style="{StaticResource DownloadCancelButtonStyle}" Click="BtnCancel_Click" Tag="{Binding}" IsEnabled="{Binding CanCancel}" ToolTip="Cancel download"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📥" FontSize="64" TextAlignment="Center"/>
                    <TextBlock Text="No Downloads" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" TextAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="Downloads will appear here" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStats" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Run Text="Active: "/>
                        <Run x:Name="TxtActiveCount" Text="0"/>
                    </TextBlock>
                    <Button Grid.Column="2" Content="Add Download..." Click="BtnAddDownload_Click" Height="28" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
