<Window x:Class="imgsaver.MiniNegativePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Negative Presets"
        Width="230"
        SizeToContent="Height"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Border CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}"
            Background="{StaticResource BackgroundBrush}"
            Opacity="0.98">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: Title -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: Active Prompt Display -->
                <RowDefinition Height="Auto" MinHeight="100"/>  <!-- Row 2: List Box -->
                <RowDefinition Height="Auto"/>  <!-- Row 3: Add Form -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Negative Presets" FontWeight="Bold" FontSize="11" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Click="BtnClose_Click" Width="18" Height="18" 
                        Background="Transparent" BorderThickness="0" Foreground="#556677" Cursor="Hand" FontSize="9"/>
            </Grid>

            <!-- Active Prompt Info -->
            <Border Grid.Row="1" Background="#141920" BorderBrush="#2A3A4A" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Active Negative:" FontSize="8" Foreground="#556677"/>
                        <TextBlock x:Name="TxtActiveNeg" Text="Empty" FontSize="9.5" Foreground="#CCDFF0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📋" Click="BtnCopyActive_Click" Width="20" Height="20" Margin="4,0,0,0"
                            Background="#1A252E" BorderBrush="#2A3A4A" BorderThickness="1" Foreground="#CCDFF0" FontSize="9" Cursor="Hand" ToolTip="Copy Active Negative Prompt">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#30445A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- List box of presets -->
            <Border Grid.Row="2" Background="#141920" CornerRadius="5" BorderBrush="#2A3A4A" BorderThickness="1" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="LstPresets" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" Width="190">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10.5" Foreground="#CCDFF0"/>
                                        <TextBlock Text="{Binding ShortContent}" FontSize="8.5" Foreground="#667788" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                        <Button Content="✔" Click="BtnApplyPreset_Click" Width="18" Height="18" Margin="2,0" Background="#1A3A2E" BorderBrush="#2A4A3A" Foreground="#89D185" FontSize="9.5" FontWeight="Bold" Cursor="Hand" ToolTip="Apply Preset"/>
                                        <Button Content="📋" Click="BtnCopyPreset_Click" Width="18" Height="18" Margin="2,0" Background="#1A252E" BorderBrush="#2A3A4A" Foreground="#CCDFF0" FontSize="8.5" Cursor="Hand" ToolTip="Copy to Clipboard"/>
                                        <Button Content="✕" Click="BtnDeletePreset_Click" Width="18" Height="18" Margin="2,0" Background="#3A1A1A" BorderBrush="#4A2A2A" Foreground="#FF6B6B" FontSize="8" Cursor="Hand" ToolTip="Delete Preset"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="3,2"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBd" Property="Background" Value="#1E2D3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- Add Preset Form -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="Add New Preset:" FontSize="9" Foreground="#556677" Margin="2,0,0,4"/>
                <TextBox x:Name="TxtNewName" FontSize="10" Height="22" Padding="5,1" Margin="0,0,0,4"
                         Foreground="#CCDFF0" Background="#252E3E" BorderBrush="#2A3A4A" BorderThickness="1"
                         VerticalContentAlignment="Center" ToolTip="Preset Name"/>
                <TextBox x:Name="TxtNewContent" FontSize="9.5" Height="40" Padding="5,3" Margin="0,0,0,6"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Foreground="#CCDFF0" Background="#252E3E" BorderBrush="#2A3A4A" BorderThickness="1"
                         VerticalContentAlignment="Top" ToolTip="Negative Prompt Content"/>
                <Button x:Name="BtnAddPreset" Content="💾 Add Preset" Height="24" FontSize="10" FontWeight="Bold" Click="BtnAddPreset_Click"
                        Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0891B2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
