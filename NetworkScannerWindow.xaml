<Window x:Class="imgsaver.NetworkScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Scanner"
        Width="1240" Height="760"
        MinWidth="920" MinHeight="620"
        Background="#090A0E"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Icon="{x:Null}"
        StateChanged="Window_StateChanged"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="10"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="0" BorderThickness="1" BorderBrush="#252B35" Margin="0" Background="#090A0E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#10131A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="18" Height="18" CornerRadius="5" Background="#0E7490" Margin="0,0,10,0">
                            <TextBlock Text="443" Foreground="#ECFEFF" FontSize="8" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Network Scanner" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="TCP service discovery" Foreground="#8B94A7" FontSize="12" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="-" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="□" Click="BtnMaximize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="X" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentHost" Grid.Row="1" ClipToBounds="True" Margin="18" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PageScaleTransform" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <Grid>
                    <Grid.Resources>
                        <Style x:Key="PanelStyle" TargetType="Border">
                            <Setter Property="Background" Value="#11141B"/>
                            <Setter Property="BorderBrush" Value="#252B35"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="16"/>
                        </Style>
                        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#93C5FD"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="LabelStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                        </Style>
                        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8B94A7"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style x:Key="ScannerTextBoxStyle" TargetType="TextBox">
                            <Setter Property="Background" Value="#090B10"/>
                            <Setter Property="BorderBrush" Value="#303848"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="CaretBrush" Value="#F8FAFC"/>
                            <Setter Property="SelectionBrush" Value="#0E7490"/>
                            <Setter Property="Padding" Value="9,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="ScannerMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ScannerTextBoxStyle}">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="ScanSourceRadioStyle" TargetType="RadioButton">
                            <Setter Property="Foreground" Value="#D8DEE9"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Root"
                                                Background="#0B0E15"
                                                BorderBrush="#2A3342"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,0"
                                                Margin="0,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#64748B" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="Root" Property="Background" Value="#111827"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#082F49"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#38BDF8"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,14" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="HTTPS PORT DISCOVERY" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Randomized TCP checks against port 443 with controlled concurrency and streamed results."
                                           Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnScan" Content="SCAN" Width="108" Height="38" Margin="0,0,8,0" Click="BtnScan_Click"
                                        Background="#0E7490" Foreground="White"/>
                                <Button Content="CANCEL" Width="96" Height="38" Margin="0,0,8,0" Click="BtnCancel_Click"
                                        IsEnabled="False" x:Name="BtnCancel" Background="#1F2937" Foreground="#E5E7EB"/>
                                <Button Content="COPY UP" Width="96" Height="38" Click="BtnCopyResponded_Click"
                                        x:Name="BtnCopyResponded" IsEnabled="False" Background="#166534" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" MinHeight="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" MinHeight="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="SCAN SOURCE" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                                    <RadioButton x:Name="RbManual" Content="IP list" IsChecked="True" GroupName="ScanSource"
                                                 Style="{StaticResource ScanSourceRadioStyle}" Checked="ScanSource_Checked"/>
                                    <RadioButton x:Name="RbFile" Content="Text file" GroupName="ScanSource"
                                                 Style="{StaticResource ScanSourceRadioStyle}" Checked="ScanSource_Checked"/>
                                    <RadioButton x:Name="RbRange" Content="IP range" GroupName="ScanSource"
                                                 Style="{StaticResource ScanSourceRadioStyle}" Checked="ScanSource_Checked"/>
                                </UniformGrid>

                                <Grid Grid.Row="2" MinHeight="0">
                                    <Grid x:Name="ManualPanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Targets" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Grid.Row="1" x:Name="TxtIpList" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" MinHeight="170"
                                                 Style="{StaticResource ScannerMultilineTextBoxStyle}"
                                                 ToolTip="One IP or host per line"/>
                                    </Grid>

                                    <Grid x:Name="FilePanel" Visibility="Collapsed" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Target file" Style="{StaticResource LabelStyle}"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtFilePath" Height="38" IsReadOnly="True"
                                                     Style="{StaticResource ScannerTextBoxStyle}"/>
                                            <Button Grid.Column="1" x:Name="BtnBrowseFile" Content="Browse" Width="86" Height="38" Margin="8,0,0,0"
                                                    Click="BtnBrowseFile_Click" Background="#1F2937" Foreground="#E5E7EB"/>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="RangePanel" Visibility="Collapsed" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Start IP" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Grid.Row="1" x:Name="TxtRangeStart" Height="38" Margin="0,0,0,10"
                                                 Style="{StaticResource ScannerTextBoxStyle}"
                                                 ToolTip="Start IP, for example 192.168.1.1"/>
                                        <TextBlock Grid.Row="2" Text="End IP" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Grid.Row="3" x:Name="TxtRangeEnd" Height="38"
                                                 Style="{StaticResource ScannerTextBoxStyle}"
                                                 ToolTip="End IP, for example 192.168.1.254"/>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="3" Background="#0B0E15" BorderBrush="#252F3E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SCAN CONTROLS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Timeout (ms)" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="TxtTimeoutMs" Text="1500" Height="34"
                                                         Style="{StaticResource ScannerTextBoxStyle}"
                                                         ToolTip="TCP connect timeout per IP in milliseconds"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Concurrency" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="TxtMaxConcurrentConnections" Text="75" Height="34"
                                                         Style="{StaticResource ScannerTextBoxStyle}"
                                                         ToolTip="Maximum number of simultaneous TCP connections"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Delay/IP (ms)" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="TxtPerIpDelayMs" Text="50" Height="34"
                                                         Style="{StaticResource ScannerTextBoxStyle}"
                                                         ToolTip="Delay before starting the next IP inside a 100-target batch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Batch rest (sec)" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="TxtBatchRestSeconds" Text="10" Height="34"
                                                         Style="{StaticResource ScannerTextBoxStyle}"
                                                         ToolTip="Rest time after every 100 scanned targets"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2" MinHeight="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelStyle}" Padding="14" Margin="0,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL" Style="{StaticResource MetricTitleStyle}"/>
                                        <TextBlock x:Name="TxtTotal" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#F8FAFC"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="14" Margin="7,0">
                                    <StackPanel>
                                        <TextBlock Text="UP" Style="{StaticResource MetricTitleStyle}"/>
                                        <TextBlock x:Name="TxtResponded" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#86EFAC"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="14" Margin="7,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="WHITELIST" Style="{StaticResource MetricTitleStyle}"/>
                                        <TextBlock x:Name="TxtWhitelisted" Text="0" Style="{StaticResource MetricValueStyle}" Foreground="#7DD3FC"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" MinHeight="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelStyle}" MinHeight="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="LIVE RESULTS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                        <ListView x:Name="LvResults" Grid.Row="1" MinHeight="126"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  Background="#090B10" BorderBrush="#303848" BorderThickness="1" Foreground="#E5E7EB">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Address}" Width="150"/>
                                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="90"/>
                                                    <GridViewColumn Header="TCP" DisplayMemberBinding="{Binding ConnectionText}" Width="140"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="2" MinHeight="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource PanelStyle}" MinHeight="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="RESPONDED IPS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="1" x:Name="TxtRespondedIps" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                     IsReadOnly="True" Style="{StaticResource ScannerMultilineTextBoxStyle}"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" MinHeight="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="EVENT LOG" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="1" x:Name="TxtLog" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                     IsReadOnly="True" Style="{StaticResource ScannerMultilineTextBoxStyle}"
                                                     Foreground="#A7F3D0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
