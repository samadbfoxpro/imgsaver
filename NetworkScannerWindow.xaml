<Window x:Class="imgsaver.NetworkScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Scanner"
        Width="1080" Height="760"
        MinWidth="920" MinHeight="640"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="{x:Null}"
        StateChanged="Window_StateChanged"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="10" BorderThickness="1" BorderBrush="#22262C" Margin="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070809" Offset="0"/>
                <GradientStop Color="#101214" Offset="0.6"/>
                <GradientStop Color="#050506" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.65" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171A1F" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Network Scanner" Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Border Background="#102638" BorderBrush="#1C5B7A" BorderThickness="1"
                                CornerRadius="4" Padding="7,1" Margin="10,0,0,0">
                            <TextBlock Text="PING WHITELIST" FontSize="9" FontWeight="Bold" Foreground="#7DD3FC"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="□" Click="BtnMaximize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentHost" Grid.Row="1" ClipToBounds="True" Margin="18"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PageScaleTransform" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style x:Key="ScannerPanelStyle" TargetType="Border">
                            <Setter Property="Background" Value="#121417"/>
                            <Setter Property="BorderBrush" Value="#262B33"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="14"/>
                        </Style>
                        <Style x:Key="ScannerMetricTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8B949E"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="ScannerMetricValueStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style x:Key="ScannerTextBoxStyle" TargetType="TextBox">
                            <Setter Property="Background" Value="#050607"/>
                            <Setter Property="BorderBrush" Value="#313741"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="CaretBrush" Value="#FFFFFF"/>
                            <Setter Property="SelectionBrush" Value="#0F766E"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="ScannerMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ScannerTextBoxStyle}">
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Border Grid.Row="0" Style="{StaticResource ScannerPanelStyle}" Margin="0,0,0,14" Padding="12">
                        <StackPanel>
                            <TextBlock Text="SCAN SOURCE" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbManual" Content="Manual list" IsChecked="True" GroupName="ScanSource"
                                             Margin="0,0,16,0" Foreground="#E5E7EB" Checked="ScanSource_Checked"/>
                                <RadioButton x:Name="RbFile" Content="Text file" GroupName="ScanSource"
                                             Margin="0,0,16,0" Foreground="#E5E7EB" Checked="ScanSource_Checked"/>
                                <RadioButton x:Name="RbRange" Content="IP range" GroupName="ScanSource"
                                             Foreground="#E5E7EB" Checked="ScanSource_Checked"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ManualPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="IP LIST" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBox Grid.Row="1" x:Name="TxtIpList" Height="132" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource ScannerMultilineTextBoxStyle}"
                                             ToolTip="One IP or host per line"/>
                                </Grid>

                                <Grid x:Name="FilePanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="TEXT FILE" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtFilePath" Height="38" IsReadOnly="True"
                                                 Style="{StaticResource ScannerTextBoxStyle}"/>
                                        <Button Grid.Column="1" x:Name="BtnBrowseFile" Content="Browse" Width="86" Height="38" Margin="8,0,0,0"
                                                Click="BtnBrowseFile_Click" Background="#1F2937" Foreground="#E5E7EB"/>
                                    </Grid>
                                </Grid>

                                <Grid x:Name="RangePanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="IP RANGE" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBox Grid.Row="1" x:Name="TxtRangeStart" Height="38" Margin="0,0,0,8"
                                             Style="{StaticResource ScannerTextBoxStyle}"
                                             ToolTip="Start IP, for example 192.168.1.1"/>
                                    <TextBox Grid.Row="2" x:Name="TxtRangeEnd" Height="38"
                                             Style="{StaticResource ScannerTextBoxStyle}"
                                             ToolTip="End IP, for example 192.168.1.254"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom" Width="170">
                                    <Border Background="#0B0D10" BorderBrush="#28313A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="SCAN TIMING" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,8"/>

                                            <TextBlock Text="Timeout (ms)" Foreground="#FFFFFF" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtTimeoutMs" Text="1500" Height="32" Margin="0,0,0,8"
                                                     Style="{StaticResource ScannerTextBoxStyle}"
                                                     ToolTip="Ping timeout per IP in milliseconds"/>

                                            <TextBlock Text="Delay / IP (ms)" Foreground="#FFFFFF" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPerIpDelayMs" Text="50" Height="32" Margin="0,0,0,8"
                                                     Style="{StaticResource ScannerTextBoxStyle}"
                                                     ToolTip="Delay before starting the next IP inside a 100-target batch"/>

                                            <TextBlock Text="Batch rest (sec)" Foreground="#FFFFFF" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtBatchRestSeconds" Text="10" Height="32"
                                                     Style="{StaticResource ScannerTextBoxStyle}"
                                                     ToolTip="Rest time after every 100 scanned targets"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnScan" Content="SCAN" Height="38" Margin="0,0,0,8" Click="BtnScan_Click"
                                            Background="#0F766E" Foreground="White"/>
                                    <Button Content="CANCEL" Height="38" Margin="0,0,0,8" Click="BtnCancel_Click" IsEnabled="False" x:Name="BtnCancel"
                                            Background="#1F2937" Foreground="#E5E7EB"/>
                                    <Button Content="COPY UP" Height="38" Click="BtnCopyResponded_Click" x:Name="BtnCopyResponded" IsEnabled="False"
                                            Background="#166534" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F1114" BorderBrush="#262B33" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL" Style="{StaticResource ScannerMetricTitleStyle}"/>
                                <TextBlock x:Name="TxtTotal" Text="0" Style="{StaticResource ScannerMetricValueStyle}" Foreground="#F3F4F6"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0B1410" BorderBrush="#1D4330" BorderThickness="1" CornerRadius="8" Padding="12" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="RESPONDED" Style="{StaticResource ScannerMetricTitleStyle}"/>
                                <TextBlock x:Name="TxtResponded" Text="0" Style="{StaticResource ScannerMetricValueStyle}" Foreground="#89D185"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0B1620" BorderBrush="#1B3D52" BorderThickness="1" CornerRadius="8" Padding="12" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="WHITELIST" Style="{StaticResource ScannerMetricTitleStyle}"/>
                                <TextBlock x:Name="TxtWhitelisted" Text="0" Style="{StaticResource ScannerMetricValueStyle}" Foreground="#7DD3FC"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource ScannerPanelStyle}" MinHeight="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="LvResults" Grid.Column="0" Margin="0,0,12,0" MinHeight="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="#08090B" BorderBrush="#313741" BorderThickness="1" Foreground="#E5E7EB">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="IP" DisplayMemberBinding="{Binding Address}" Width="140"/>
                                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="90"/>
                                        <GridViewColumn Header="Ping" DisplayMemberBinding="{Binding PingText}" Width="80"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Grid Grid.Column="1" MinHeight="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="RESPONDED IPs" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" x:Name="TxtRespondedIps" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         IsReadOnly="True" MinHeight="0" Margin="0,0,0,12"
                                         Style="{StaticResource ScannerMultilineTextBoxStyle}"/>
                                <TextBlock Grid.Row="2" Text="LOG" Foreground="#7DD3FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="3" x:Name="TxtLog" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         IsReadOnly="True" MinHeight="0"
                                         Style="{StaticResource ScannerMultilineTextBoxStyle}" Foreground="#A7F3D0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
