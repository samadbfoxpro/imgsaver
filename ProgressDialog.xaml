<Window x:Class="imgsaver.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing..." 
        Width="450" Height="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Processing..."
                       FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"
                       HorizontalAlignment="Center"/>

            <!-- Progress Bar -->
            <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="10" Height="20" BorderBrush="#444" BorderThickness="1">
                <Grid>
                    <Border x:Name="ProgressFill" Background="#4CAF50" CornerRadius="9" HorizontalAlignment="Left" Width="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6" Color="#4CAF50"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="TxtPercentage" Text="0%" FontSize="11" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Status Text -->
            <TextBlock x:Name="TxtStatus" Grid.Row="4" Text="Initializing..."
                       FontSize="12" Foreground="#B0B0B0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
