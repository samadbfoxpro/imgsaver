                                             <TextBlock x:Name="txt" Text="{DynamicResource Lbl_Toggle_Sfx}" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsAdditionalTitleVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="txt" Property="Foreground" Value="#00FFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#00FFFF"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <!-- Touch friendly page 1 dot -->
                        <Button Click="BtnExtraMenuPageOne_Click" Width="26" Height="26" Margin="4,0" Cursor="Hand" ToolTip="Page 1" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dot" Property="Fill" Value="#AAAAAA"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ExtraMenuPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                            <Setter TargetName="dot" Property="Width" Value="10"/>
                                            <Setter TargetName="dot" Property="Height" Value="10"/>
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Touch friendly page 2 dot -->
                        <Button Click="BtnExtraMenuPageTwo_Click" Width="26" Height="26" Margin="4,0" Cursor="Hand" ToolTip="Page 2" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dot" Property="Fill" Value="#AAAAAA"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ExtraMenuPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                            <Setter TargetName="dot" Property="Width" Value="10"/>
                                            <Setter TargetName="dot" Property="Height" Value="10"/>
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Touch friendly page 3 dot -->
                        <Button Click="BtnExtraMenuPageThree_Click" Width="26" Height="26" Margin="4,0" Cursor="Hand" ToolTip="Page 3" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dot" Property="Fill" Value="#AAAAAA"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ExtraMenuPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                            <Setter TargetName="dot" Property="Width" Value="10"/>
                                            <Setter TargetName="dot" Property="Height" Value="10"/>
                                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
