<Window x:Class="imgsaver.MiniClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Clipboard" 
        Width="240" Height="Auto"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Left="20" Top="100"
        SizeToContent="Height">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" BorderThickness="1" CornerRadius="10" 
            Background="{StaticResource BackgroundBrush}" Opacity="0.98"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="BorderBrush" Value="#444444"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title Section -->
                    <TextBlock x:Name="titleText" Grid.Column="0" Text="Mini Clip" Foreground="{StaticResource ForegroundMutedBrush}" 
                               FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,5,0" IsHitTestVisible="False"/>

                    <!-- Compact Network Speed Display -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                        <TextBlock Text="↓" FontSize="10" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock x:Name="TxtDownloadSpeed" Text="0.0 KB" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
 
                        <TextBlock Text="↑" FontSize="10" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock x:Name="TxtUploadSpeed" Text="0.0 KB" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnCompact" Click="BtnCompact_Click"
                                Width="28" Height="28" FontSize="9"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Toggle Compact Mode"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="txt" Text="▭" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Text" Value="❐"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnDisable" Click="BtnDisable_Click"
                                Width="28" Height="28" FontSize="9"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Disable/Enable Monitoring"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="txt" Text="||" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Text" Value=">"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Width="28" Height="28" FontSize="9"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,10,0,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="12,10,12,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image Preview Area -->
                <Border Grid.Row="0" Background="#080808" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Height="80" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock x:Name="TxtNoImage" Text="[IMG]" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ForegroundMutedBrush}" Opacity="0.2"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="2">
                            <StackPanel x:Name="ImageGrid" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Prompts Status Pills -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="6" Padding="6,8" Margin="0,0,4,0"
                            Cursor="Hand" MouseLeftButtonDown="PositivePrompt_MouseLeftButtonDown"
                            ToolTip="Positive Prompt (Click to clear)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPositiveCheck" Text="○" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" POS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BorderNegative" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="6" Padding="6,8" Margin="4,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="NegativePrompt_MouseLeftButtonDown"
                            ToolTip="Negative Prompt (Click to clear)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtNegativeCheck" Text="○" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" NEG" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnLockNegative" Click="BtnLockNegative_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Lock Negative Prompt">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="txtLock" Text="🔓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Opacity="0.6"/>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNegativeLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="txtLock" Property="Text" Value="🔒"/>
                                                <Setter TargetName="txtLock" Property="Foreground" Value="#F1C40F"/>
                                                <Setter TargetName="txtLock" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>


                <!-- Main Title -->
                <TextBox x:Name="TxtTitle" Grid.Row="2"
                         FontSize="12" Height="30" Padding="8,0"
                         VerticalContentAlignment="Center" 
                         Tag="Enter Title..."
                         IsEnabled="False"
                         KeyDown="TxtTitle_KeyDown"
                         ToolTip="Main Title (Enter to save)">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Additional Title Row -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdditionalTitleVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsAdditionalTitleEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enable Suffix Title"/>
                    <TextBox Grid.Column="1" x:Name="TxtAdditionalTitle" 
                             Text="{Binding AdditionalTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Height="26" Padding="6,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Additional Suffix (Auto-appended)"
                             KeyDown="AdditionalTitle_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsAdditionalTitleEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Description Row -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDescriptionVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsDescriptionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enable Description / Notes"/>
                    <TextBox Grid.Column="1" x:Name="TxtDescription" 
                             Text="{Binding DescriptionText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Height="26" Padding="6,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Description / Notes (saved to text file)"
                             KeyDown="AdditionalTitle_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsDescriptionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Action Buttons -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
 
                    <Button x:Name="BtnReset" Grid.Column="0" Content="✕"
                            Click="BtnReset_Click" Width="30" Height="34" FontSize="12"
                            ToolTip="Clear All" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#33E81123" BorderBrush="#E81123" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" TextElement.Foreground="#E81123"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
 
                    <Button x:Name="BtnSEO" Grid.Column="1" Content="{DynamicResource Btn_Save_To_Disk}"
                            Click="BtnSEO_Click" Height="34" FontSize="11" FontWeight="Bold"
                            Margin="6,0,0,0" IsEnabled="False"
                            ToolTip="Save to target directory (Ctrl + S)" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#2D2D2D" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#2ECC71"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
 
                    <Button x:Name="BtnPauseCountdown" Grid.Column="2" Content="⏸"
                            Click="BtnPauseCountdown_Click" Width="30" Height="34" FontSize="12"
                            Margin="6,0,0,0" ToolTip="Pause / Resume Auto-Save countdown" Cursor="Hand"
                            Visibility="Visible" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#AAA"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
 
                <!-- Menu Toggle -->
                <Button x:Name="BtnToggleMenu" Grid.Row="6" Click="BtnToggleMenu_Click"
                        Height="16" Width="50" Margin="0,6,0,0" HorizontalAlignment="Center" Cursor="Hand"
                        ToolTip="Extra Options">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent">
                                <TextBlock x:Name="txt" Text="•••" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="txt" Property="Foreground" Value="#AAA"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsExtraMenuOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="txt" Property="Text" Value="▴"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
 
                <!-- Extra Menu Grid -->
                <StackPanel Grid.Row="7" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExtraMenuOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                        <Condition Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExtraMenuPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExtraMenuPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                    <UniformGrid Columns="3" Rows="2">
                        <Button x:Name="BtnPlayRec" Click="BtnPlayRec_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Play Last Recording (Ctrl + E)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                                        <TextBlock x:Name="txtPlay" Text="▶ REC" FontSize="9" FontWeight="Bold" Foreground="#F1C40F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnLockAdditionalTitle" Click="BtnLockAdditionalTitle_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Lock Suffix">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                                         <TextBlock x:Name="txt" Text="{DynamicResource Lbl_Lock_Sfx}" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAdditionalTitleLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="#F1C40F"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#F1C40F"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnLockTitle" Click="BtnLockTitle_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Lock Main Title">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                                         <TextBlock x:Name="txt" Text="{DynamicResource Lbl_Lock_Ttl}" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsTitleLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="#F1C40F"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#F1C40F"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnLockDescription" Click="BtnLockDescription_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Lock Description">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                                         <TextBlock x:Name="txt" Text="{DynamicResource Lbl_Lock_Dsc}" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDescriptionLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="#F1C40F"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#F1C40F"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnSaveFromPersonaInjector" Click="BtnSaveFromPersonaInjector_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Persona Injector Sync (Ctrl + R)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#4B0082" CornerRadius="4" BorderBrush="#663399" BorderThickness="1">
                                         <TextBlock Text="{DynamicResource Lbl_Spi_Sync}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#7B68EE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnAutoFill" Click="BtnAutoFill_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Auto-Fill from Metadata">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
