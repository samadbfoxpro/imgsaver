<Window x:Class="imgsaver.MiniClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Clipboard" 
        Width="250" Height="Auto"
        MinWidth="210" MinHeight="100"
        MaxWidth="800"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        Left="20" Top="100"
        SizeToContent="Height">

    <Border x:Name="MainBorder" BorderThickness="1" CornerRadius="14" 
            Background="#090D1A" Opacity="0.98" Margin="8">
        <Border.Effect>
            <!-- Soft Windows-like ambient drop shadow -->
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.45" Color="#000000" Direction="270"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <!-- Sleek elegant darker slate-gray outline -->
                <Setter Property="BorderBrush" Value="#2A3447"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="BorderBrush" Value="#5C1D1D"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Title Bar Matching MainWindow Aesthetic -->
            <Border Grid.Row="0" Background="#0C1122" CornerRadius="13,13,0,0" 
                    BorderThickness="0,0,0,1" BorderBrush="#1E293B"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title Section with Gradient Badge Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0" IsHitTestVisible="False">
                        <Border CornerRadius="5" Width="18" Height="18" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="📋" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="titleText" Text="Mini Clip" Foreground="#F0F6FC" 
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Compact Network Speed Display with Glow Badges -->
                    <Border Grid.Column="1" Background="#060A14" CornerRadius="6" BorderBrush="#141C30" BorderThickness="1" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↓" FontSize="9.5" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBlock x:Name="TxtDownloadSpeed" Text="0.0 KB" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
     
                            <TextBlock Text="↑" FontSize="9.5" Foreground="#F43F5E" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBlock x:Name="TxtUploadSpeed" Text="0.0 KB" FontSize="9.5" FontWeight="SemiBold" Foreground="#F43F5E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button x:Name="BtnCompact" Click="BtnCompact_Click"
                                Width="26" Height="24" FontSize="9"
                                Background="Transparent" Foreground="#8A9BB2"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Toggle Compact Mode"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock x:Name="txt" Text="▭" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#121A30"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Text" Value="❐"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#38BDF8"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnDisable" Click="BtnDisable_Click"
                                Width="26" Height="24" FontSize="9"
                                Background="Transparent" Foreground="#8A9BB2"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Disable/Enable Monitoring"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock x:Name="txt" Text="⏸" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#121A30"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Text" Value="▶"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#F43F5E"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Width="26" Height="24" FontSize="9"
                                Background="Transparent" Foreground="#8A9BB2"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="12,10,12,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image Preview Area (Dynamic Height scaling with window width) -->
                <Border x:Name="BorderImagePreview" Grid.Row="0" Background="#060914" CornerRadius="8"
                        BorderBrush="#141C30" BorderThickness="1"
                        MinHeight="82" Height="82" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock x:Name="TxtNoImage" Text="🖼️" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#3B82F6" Opacity="0.3"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="4">
                            <StackPanel x:Name="ImageGrid" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Prompts Status Pills Matching Modern Card Style -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BorderPositive" Grid.Column="0" Background="#0B132B"
                            BorderBrush="#1E293B" BorderThickness="1"
                            CornerRadius="8" Padding="6,8" Margin="0,0,4,0"
                            Cursor="Hand" MouseLeftButtonDown="PositivePrompt_MouseLeftButtonDown"
                            ToolTip="Positive Prompt (Click to clear)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPositiveCheck" Text="○" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text=" POS" FontSize="10" FontWeight="Bold"
                                       Foreground="#38BDF8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BorderNegative" Grid.Column="1" Background="#0B132B"
                            BorderBrush="#1E293B" BorderThickness="1"
                            CornerRadius="8" Padding="6,8" Margin="4,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="NegativePrompt_MouseLeftButtonDown"
                            ToolTip="Negative Prompt (Click to clear)">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtNegativeCheck" Text="○" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text=" NEG" FontSize="10" FontWeight="Bold"
                                           Foreground="#FB7185" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnLockNegative" Click="BtnLockNegative_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Lock Negative Prompt">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="txtLock" Text="🔓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Opacity="0.6"/>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNegativeLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="txtLock" Property="Text" Value="🔒"/>
                                                <Setter TargetName="txtLock" Property="Foreground" Value="#FBBF24"/>
                                                <Setter TargetName="txtLock" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Main Title Input -->
                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBox x:Name="TxtTitle"
                             Background="#080D1D" Foreground="#F0F6FC" CaretBrush="#38BDF8"
                             BorderBrush="#1E293B" BorderThickness="1"
                             FontSize="13" FontWeight="Bold" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center"
                             Tag="عنوان اصلی..."
                             IsEnabled="True"
                             KeyDown="TxtTitle_KeyDown"
                             TextChanged="AutoDetectDirection_TextChanged"
                             ToolTip="Main Title (Enter to save)">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock x:Name="TxtTitleHint"
                               Text="{Binding Tag, ElementName=TxtTitle}"
                               Foreground="#64748B"
                               Opacity="0.7"
                               FontSize="13" FontWeight="Bold"
                               Margin="0,0,12,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtTitle}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Additional Title Row -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdditionalTitleVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsAdditionalTitleEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enable Suffix Title"/>
                    <TextBox Grid.Column="1" x:Name="TxtAdditionalTitle" 
                             Background="#080D1D" Foreground="#F0F6FC" CaretBrush="#38BDF8"
                             BorderBrush="#1E293B" BorderThickness="1"
                             Text="{Binding AdditionalTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" FontWeight="Bold" Height="30" Padding="8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Additional Suffix (Auto-appended)"
                             KeyDown="AdditionalTitle_KeyDown"
                             TextChanged="AutoDetectDirection_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsAdditionalTitleEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Description Row -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDescriptionVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsDescriptionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enable Description / Notes"/>
                    <TextBox Grid.Column="1" x:Name="TxtDescription" 
                             Background="#080D1D" Foreground="#F0F6FC" CaretBrush="#38BDF8"
                             BorderBrush="#1E293B" BorderThickness="1"
                             Text="{Binding DescriptionText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Height="28" Padding="8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Description / Notes (saved to text file)"
                             KeyDown="AdditionalTitle_KeyDown"
                             TextChanged="AutoDetectDirection_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsDescriptionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Action Buttons with Modern Gradient and Glow -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
 
                    <Button x:Name="BtnReset" Grid.Column="0"
                            Click="BtnReset_Click" Width="34" Height="34"
                            ToolTip="پاک کردن همه / Clear All" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#0C1324" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Sleek Modern Reset / Reload Vector Icon -->
                                        <Path x:Name="iconPath" 
                                              Data="M 12 4 A 7 7 0 1 1 5.5 8.5 M 5.5 4.5 L 5.5 8.5 L 9.5 8.5" 
                                              Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1A0D18"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#E11D48"/>
                                        <Setter TargetName="iconPath" Property="Stroke" Value="#FB7185"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#E11D48" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2D1122"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#F43F5E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
 
                    <Button x:Name="BtnSEO" Grid.Column="1"
                            Click="BtnSEO_Click" Height="34" FontSize="11" FontWeight="Bold"
                            Margin="6,0,0,0" IsEnabled="False"
                            ToolTip="ذخیره / Save (Ctrl + S)" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" BorderThickness="1" BorderBrush="#2563EB">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1D4ED8" Offset="0"/>
                                            <GradientStop Color="#0284C7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0284C7" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Crisp Vector Check-Download Icon -->
                                        <Path Data="M 3 10 L 7 14 L 15 5" 
                                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#38BDF8" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.28"/>
                                        <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
 
                    <Button x:Name="BtnPauseCountdown" Grid.Column="2" Content="⏸"
                            Click="BtnPauseCountdown_Click" Width="32" Height="34" FontSize="11"
                            Margin="6,0,0,0" ToolTip="Pause / Resume Auto-Save countdown" Cursor="Hand"
                            Visibility="Visible" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#94A3B8"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
 
                <!-- Menu Toggle -->
                <Button x:Name="BtnToggleMenu" Grid.Row="6" Click="BtnToggleMenu_Click"
                        Height="16" Width="50" Margin="0,6,0,0" HorizontalAlignment="Center" Cursor="Hand"
                        ToolTip="Extra Options">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent">
                                <TextBlock x:Name="txt" Text="•••" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="txt" Property="Foreground" Value="#AAA"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsExtraMenuOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="txt" Property="Text" Value="▴"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
 
                <!-- Extra Menu Grid -->
                <StackPanel Grid.Row="7" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExtraMenuOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                        <Condition Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
