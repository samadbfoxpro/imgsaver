                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnToggleAutoSavePanel" Click="BtnToggleAutoSavePanel_Click" Height="28" Margin="2" Cursor="Hand" ToolTip="Open Auto-Save Panel">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#2D2D2D" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                                             <TextBlock x:Name="txt" Text="{DynamicResource Lbl_Auto_Sv}" FontSize="9" FontWeight="Bold" Foreground="#FFD21F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
