<Window x:Class="imgsaver.PromptTaggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_PromptTagger_Title}" Width="500" Height="740"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ContextMenu x:Key="TextBoxContextMenu">
            <MenuItem Header="{DynamicResource Menu_Cut}" Command="ApplicationCommands.Cut"/>
            <MenuItem Header="{DynamicResource Menu_Copy}" Command="ApplicationCommands.Copy"/>
            <MenuItem Header="{DynamicResource Menu_Paste}" Command="ApplicationCommands.Paste"/>
            <Separator Background="#2A3A4A" Height="1" Margin="2,4"/>
            <MenuItem Header="{DynamicResource Menu_SelectAll}" Command="ApplicationCommands.SelectAll"/>
            <MenuItem Header="{DynamicResource Menu_Clear}" Click="MenuClear_Click"/>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                <RowDefinition Height="*"/> <!-- Content Panels -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{DynamicResource Lbl_PromptTagger_Title}" VerticalAlignment="Center" Margin="12,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Tab Headers -->
            <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnTabReplacer" Grid.Column="0" Content="{DynamicResource Btn_Tab_Replacer}" Click="BtnTabReplacer_Click" BorderThickness="0,0,0,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnTabDiff" Grid.Column="1" Content="{DynamicResource Btn_Tab_Diff}" Click="BtnTabDiff_Click" BorderThickness="0,0,0,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content Panels -->
            <Grid Grid.Row="2" Margin="15">
                
                <!-- TAB 1: TAG REPLACER PANEL -->
                <Grid x:Name="PanelReplacer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Label + Input 1 -->
                        <RowDefinition Height="Auto"/> <!-- Label + Input 2 -->
                        <RowDefinition Height="Auto"/> <!-- Tag Prefix + Process Button -->
                        <RowDefinition Height="*"/>    <!-- Output Area -->
                    </Grid.RowDefinitions>

                    <!-- Template Input -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Lbl_Template_Prompt}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTemplate" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Replacement Values Input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Lbl_Replacement_Values}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtValues" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Tag Prefix & Action -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tag Prefix:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtReplacerPrefix" Text="PH_" Width="60" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                     ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_Process_Replacer}" Click="BtnProcessReplacement_Click" Height="30" Margin="15,0,0,0" FontWeight="SemiBold"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- Output Prompt -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource Lbl_Result_Output}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="{DynamicResource Btn_Copy_Result}" Click="BtnCopyReplacerOutput_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <TextBox x:Name="TxtReplacerOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </Grid>
                </Grid>

                <!-- TAB 2: PROMPT DIFF PANEL -->
                <Grid x:Name="PanelDiff" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Input A & B Side-by-side or Stacked -->
                        <RowDefinition Height="Auto"/> <!-- Tag Prefix + Compare Button -->
                        <RowDefinition Height="*"/>    <!-- Outputs -->
                    </Grid.RowDefinitions>

                    <!-- Input Grid -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Lbl_Prompt_A}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPromptA" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Lbl_Prompt_B}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPromptB" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tag Prefix:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtDiffPrefix" Text="PH_" Width="60" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                     ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_Compare_Prompts}" Click="BtnComparePrompts_Click" Height="30" Margin="15,0,0,0" FontWeight="SemiBold"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- Diff Outputs -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/> <!-- Output template -->
                            <RowDefinition Height="Auto"/> <!-- Gap -->
                            <RowDefinition Height="Auto"/> <!-- Extracted list (changed to Auto) -->
                            <RowDefinition Height="Auto"/> <!-- Transfer Button -->
                        </Grid.RowDefinitions>

                         <!-- Output template -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Lbl_Generated_Template}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDiffTemplateOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>

                        <!-- Extracted list -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Lbl_Extracted_Diffs}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDiffValuesOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Height="80" Padding="8,6" ContextMenu="{StaticResource TextBoxContextMenu}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>

                        <!-- Actions -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{DynamicResource Btn_Transfer}" Click="BtnTransferToReplacer_Click" Height="32" FontWeight="Bold"
                                    Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0284C7" Offset="0"/>
                                                    <GradientStop Color="#0369A1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="Bold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="{DynamicResource Btn_Transfer_To_Extra}" Click="BtnTransferToExtra_Click" Height="32" FontWeight="Bold"
                                    Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0D9488" Offset="0"/>
                                                    <GradientStop Color="#0891B2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="Bold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
