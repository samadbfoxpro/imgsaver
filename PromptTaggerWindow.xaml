<Window x:Class="imgsaver.PromptTaggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Tagger &amp; Diff" Width="500" Height="680"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                <RowDefinition Height="*"/> <!-- Content Panels -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="🏷️ Prompt Tagger &amp; Diff" VerticalAlignment="Center" Margin="12,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Tab Headers -->
            <Grid Grid.Row="1" Background="#141920" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnTabReplacer" Grid.Column="0" Content="📝 Tag Replacer" Click="BtnTabReplacer_Click" BorderThickness="0,0,0,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnTabDiff" Grid.Column="1" Content="🔍 Prompt Diff" Click="BtnTabDiff_Click" BorderThickness="0,0,0,2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content Panels -->
            <Grid Grid.Row="2" Margin="15">
                
                <!-- TAB 1: TAG REPLACER PANEL -->
                <Grid x:Name="PanelReplacer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Label + Input 1 -->
                        <RowDefinition Height="Auto"/> <!-- Label + Input 2 -->
                        <RowDefinition Height="Auto"/> <!-- Tag Prefix + Process Button -->
                        <RowDefinition Height="*"/>    <!-- Output Area -->
                    </Grid.RowDefinitions>

                    <!-- Template Input -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Template Prompt (contains [PH_1], [PH_2], etc.):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTemplate" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Replacement Values Input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Replacement Values (comma-separated list):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtValues" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Tag Prefix & Action -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tag Prefix:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtReplacerPrefix" Text="PH_" Width="60" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Process Tag Replacement" Click="BtnProcessReplacement_Click" Height="30" Margin="15,0,0,0" FontWeight="SemiBold"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- Output Prompt -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="Result Output:" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="📋 Copy Result" Click="BtnCopyReplacerOutput_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="10" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <TextBox x:Name="TxtReplacerOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </Grid>
                </Grid>

                <!-- TAB 2: PROMPT DIFF PANEL -->
                <Grid x:Name="PanelDiff" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Input A & B Side-by-side or Stacked -->
                        <RowDefinition Height="Auto"/> <!-- Tag Prefix + Compare Button -->
                        <RowDefinition Height="*"/>    <!-- Outputs -->
                    </Grid.RowDefinitions>

                    <!-- Input Grid -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Prompt A (Clean Reference):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPromptA" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Prompt B (Modified/Detailed):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPromptB" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tag Prefix:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtDiffPrefix" Text="PH_" Width="60" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔍 Auto-Compare &amp; Generate Tags" Click="BtnComparePrompts_Click" Height="30" Margin="15,0,0,0" FontWeight="SemiBold"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- Diff Outputs -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/> <!-- Output template -->
                            <RowDefinition Height="Auto"/> <!-- Gap -->
                            <RowDefinition Height="80"/> <!-- Extracted list -->
                            <RowDefinition Height="Auto"/> <!-- Transfer Button -->
                        </Grid.RowDefinitions>

                         <!-- Output template -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Generated Template Prompt (with tags):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDiffTemplateOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>

                        <!-- Extracted list -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Extracted Differences (Values list):" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDiffValuesOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>

                        <!-- Actions -->
                        <Button Grid.Row="3" Content="🚀 Transfer Output &amp; Values to Tag Replacer" Click="BtnTransferToReplacer_Click" Height="32" FontWeight="Bold"
                                Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0284C7" Offset="0"/>
                                                <GradientStop Color="#0369A1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
