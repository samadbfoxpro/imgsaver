<Window x:Class="imgsaver.PromptTaggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت و جایگزینی تگ‌های پرامپت (Prompt Tagger)" Width="760" Height="840"
        MinHeight="500" MinWidth="600"
        Background="#131417"
        WindowStartupLocation="CenterScreen">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Persian Context Menu for TextBoxes -->
        <ContextMenu x:Key="TextBoxContextMenu" Background="#1C1E24" BorderBrush="#2F333D" BorderThickness="1">
            <MenuItem Header="بریدن (Cut)" Command="ApplicationCommands.Cut" Foreground="#E2E8F0"/>
            <MenuItem Header="کپی (Copy)" Command="ApplicationCommands.Copy" Foreground="#E2E8F0"/>
            <MenuItem Header="چسباندن (Paste)" Command="ApplicationCommands.Paste" Foreground="#E2E8F0"/>
            <Separator Background="#2F333D" Height="1" Margin="2,4"/>
            <MenuItem Header="انتخاب همه (Select All)" Command="ApplicationCommands.SelectAll" Foreground="#E2E8F0"/>
            <MenuItem Header="پاک کردن فیلد" Click="MenuClear_Click" Foreground="#F87171"/>
        </ContextMenu>

        <!-- Vector Icon Geometries -->
        <StreamGeometry x:Key="IconTagger">M5.5,7A1.5,1.5 0 0,1 4,5.5A1.5,1.5 0 0,1 5.5,4A1.5,1.5 0 0,1 7,5.5A1.5,1.5 0 0,1 5.5,7M21.41,11.58L12.41,2.58C12.05,2.22 11.55,2 11,2H4C2.89,2 2,2.89 2,4V11C2,11.55 2.22,12.05 2.59,12.41L11.58,21.41C11.95,21.78 12.45,22 13,22C13.55,22 14.05,21.78 14.41,21.41L21.41,14.41C21.78,14.05 22,13.55 22,13C22,12.45 21.77,11.94 21.41,11.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconFlash">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
        <StreamGeometry x:Key="IconSwap">M6.99,11L3,15L6.99,19V16H14V14H6.99V11M21,9L17.01,5V8H10V10H17.01V13L21,9Z</StreamGeometry>
        <StreamGeometry x:Key="IconEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconRocket">M2.81,14.12L5.64,11.29L8.46,14.12L5.64,16.95L2.81,14.12M21.39,2.61C21.45,4.84 20.61,7.11 18.88,8.84L17.46,10.25L13.75,6.54L15.16,5.12C16.89,3.39 19.16,2.55 21.39,2.61M12.34,7.96L16.04,11.66L8.97,18.73C8.24,19.46 7.24,19.93 6.16,20.08L2,22L3.92,17.84C4.07,16.76 4.54,15.76 5.27,15.03L12.34,7.96Z</StreamGeometry>
        <StreamGeometry x:Key="IconSend">M2,21L23,12L2,3V10L17,12L2,14V21Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M0,0 L10,0</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M1,1 L9,1 L9,9 L1,9 Z M0,0 L10,0 L10,10 L0,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M3,1 L9,1 L9,7 L8,7 L8,2 L3,2 Z M1,3 L7,3 L7,9 L1,9 Z M0,2 L8,2 L8,10 L0,10 Z</StreamGeometry>

        <!-- Dark TextBox Styling (Always LTR for Prompt Content) -->
        <Style x:Key="ModernDarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#121316"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#272A30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                                <Setter TargetName="border" Property="Background" Value="#15171C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Background Container -->
    <Border x:Name="MainBorder" Background="#131417" CornerRadius="8" BorderBrush="#25282E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>  <!-- Window Titlebar -->
                <RowDefinition Height="Auto"/> <!-- Segmented Tab Header -->
                <RowDefinition Height="*"/>    <!-- Main Content Panels -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- TOP TITLEBAR (Standard LTR: Icon/Title Left, Caption Buttons Right) -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#18191D" CornerRadius="12,12,0,0" BorderBrush="#22252B" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon (Left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#0C242B" BorderBrush="#0891B2" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTagger}" Fill="#06B6D4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="مدیریت و جایگزینی تگ‌های پرامپت (Prompt Tagger)" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <!-- Standard Windows Caption Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="کوچک کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconMinimize}" Fill="#94A3B8" Width="10" Height="2" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="بزرگ کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIconPath" Data="{StaticResource IconMaximize}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="بستن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 3-SEGMENTED TAB SWITCHER -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="16,12,16,0" Background="#181A1F" CornerRadius="8" Padding="3" BorderBrush="#25282F" BorderThickness="1">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tab 1: Replacer -->
                    <Button x:Name="BtnTabReplacer" Grid.Column="0" Click="BtnTabReplacer_Click" Margin="2" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFlash}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="جایگزین‌کننده تگ‌ها" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 2: Diff -->
                    <Button x:Name="BtnTabDiff" Grid.Column="1" Click="BtnTabDiff_Click" Margin="2" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSwap}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="استخراج تفاوت‌ها (Diff)" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 3: Interactive -->
                    <Button x:Name="BtnTabInteractive" Grid.Column="2" Click="BtnTabInteractive_Click" Margin="2" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconEdit}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تگ‌گذار تعاملی انتخابی" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- MAIN CONTENT AREA -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,12,16,16">

                <!-- ════════════════════════════════════════════════════════════════ -->
                <!-- TAB 1: TAG REPLACER PANEL -->
                <!-- ════════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelReplacer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/> <!-- Template Card -->
                        <RowDefinition Height="1*"/>   <!-- Values Card -->
                        <RowDefinition Height="Auto"/> <!-- Settings & Execute Action Bar -->
                        <RowDefinition Height="1.2*"/> <!-- Output Result Card -->
                    </Grid.RowDefinitions>

                    <!-- Card 1: Template Input -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#0E2D38" BorderBrush="#0891B2" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="۱" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                                <TextBlock Text="الگوی پرامپت (حاوی تگ‌های [PH_1]، [PH_2] و...)" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBox x:Name="TxtTemplate" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: Replacement Values Input -->
                    <Border Grid.Row="1" Margin="0,0,0,10" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#1C2D27" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="۲" FontSize="11" FontWeight="Bold" Foreground="#2DD4BF"/>
                                </Border>
                                <TextBlock Text="مقادیر جایگزین (جدا شده با کاما ,)" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBox x:Name="TxtValues" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- Card 3: Action Control Bar -->
                    <Border Grid.Row="2" Margin="0,0,0,10" Background="#181A20" CornerRadius="8" BorderBrush="#272A32" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Prefix Setting -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="پیشوند تگ:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtReplacerPrefix" Text="PH_" Width="65" Height="30" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" Style="{StaticResource ModernDarkTextBox}"/>
                            </StackPanel>

                            <!-- Process Button -->
                            <Button Grid.Column="1" Click="BtnProcessReplacement_Click" Height="36" Margin="14,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Padding="14,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0284C7" Offset="0"/>
                                                    <GradientStop Color="#0369A1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFlash}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="اعمال و جایگزینی تگ‌ها" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card 4: Output Result -->
                    <Border Grid.Row="3" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#0D2818" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconCheck}" Fill="#4ADE80" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="خروجی پرامپت نهایی:" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Button Click="BtnCopyReplacerOutput_Click" HorizontalAlignment="Right" Height="28" Padding="10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#1E222A" BorderBrush="#333842" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconCopy}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="کپی خروجی" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#282E38"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <TextBox x:Name="TxtReplacerOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════════ -->
                <!-- TAB 2: PROMPT DIFF PANEL -->
                <!-- ════════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelDiff" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/> <!-- Two-Column Prompts Grid -->
                        <RowDefinition Height="Auto"/> <!-- Action Control Bar -->
                        <RowDefinition Height="1.2*"/> <!-- Outputs Split Grid -->
                        <RowDefinition Height="Auto"/> <!-- Transfer Footer Bar -->
                    </Grid.RowDefinitions>

                    <!-- Split Input Prompts A & B -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Prompt A Card -->
                        <Border Grid.Column="0" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="پرامپت مبنا / مرجع (A):" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtPromptA" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                            </Grid>
                        </Border>

                        <!-- Prompt B Card -->
                        <Border Grid.Column="2" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="پرامپت جدید / هدف (B):" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtPromptB" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Control Bar -->
                    <Border Grid.Row="1" Margin="0,0,0,10" Background="#181A20" CornerRadius="8" BorderBrush="#272A32" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="پیشوند تگ:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtDiffPrefix" Text="PH_" Width="65" Height="30" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" Style="{StaticResource ModernDarkTextBox}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Click="BtnComparePrompts_Click" Height="36" Margin="14,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Padding="14,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                                    <GradientStop Color="#6366F1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconSwap}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="مقایسه و استخراج هوشمند تگ‌ها" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Split Outputs Grid -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- Output 1: Generated Template -->
                        <Border Grid.Row="0" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="الگوی تمپلیت تولید‌شده (Template):" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDiffTemplateOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                            </Grid>
                        </Border>

                        <!-- Output 2: Extracted Differences -->
                        <Border Grid.Row="2" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="مقادیر متغیر استخراج‌شده (Diff Values):" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDiffValuesOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernDarkTextBox}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Transfer Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Button Transfer to Replacer -->
                        <Button Grid.Column="0" Click="BtnTransferToReplacer_Click" Height="36" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Padding="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0284C7" Offset="0"/>
                                                <GradientStop Color="#0369A1" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFlash}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="انتقال به جایگزین‌کننده (تب ۱)" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Button Transfer to Extra Panels -->
                        <Button Grid.Column="2" Click="BtnTransferToExtra_Click" Height="36" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Padding="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0D9488" Offset="0"/>
                                                <GradientStop Color="#0891B2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSend}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ارسال به پنل‌های جانبی (Extra Panels)" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════════════ -->
                <!-- TAB 3: INTERACTIVE SELECTION TAGGER PANEL -->
                <!-- ════════════════════════════════════════════════════════════════ -->
                <Grid x:Name="PanelInteractive" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/> <!-- Interactive Prompt Editor Card -->
                        <RowDefinition Height="1*"/>   <!-- Live Extracted Diffs Card -->
                        <RowDefinition Height="Auto"/> <!-- Controls & Send to MiniClip -->
                    </Grid.RowDefinitions>

                    <!-- Card 1: Interactive Selection Prompt Editor -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#25173B" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconEdit}" Fill="#A78BFA" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ویرایشگر تعاملی انتخاب متن:" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Reset Base -->
                                    <Button x:Name="BtnSetBasePrompt" Click="BtnSetBasePrompt_Click" Height="28" Padding="10,0" Margin="0,0,8,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#1E222A" BorderBrush="#333842" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconRefresh}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="قفل متن مبنا" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#282E38"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Tag Selection -->
                                    <Button x:Name="BtnTagSelection" Click="BtnTagSelection_Click" Height="28" Padding="12,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconFlash}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="تبدیل انتخاب به تگ" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TxtInteractivePrompt" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtInteractivePrompt_TextChanged" Style="{StaticResource ModernDarkTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: Live Extracted Values / Diffs -->
                    <Border Grid.Row="1" Margin="0,0,0,10" Background="#16181D" CornerRadius="8" BorderBrush="#252830" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#0C261A" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconCheck}" Fill="#34D399" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تفاوت‌ها و مقادیر استخراج‌شده آنلاین:" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Border HorizontalAlignment="Right" Background="#0C2018" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="● همگام‌سازی زنده" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>

                            <TextBox x:Name="TxtLiveDifferences" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtLiveDifferences_TextChanged" Style="{StaticResource ModernDarkTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- Card 3: Action Control Bar & Send to MiniClip -->
                    <Border Grid.Row="2" Background="#181A20" CornerRadius="8" BorderBrush="#272A32" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="پیشوند:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtInteractivePrefix" Text="PH_" Width="60" Height="30" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" Style="{StaticResource ModernDarkTextBox}"/>
                            </StackPanel>

                            <!-- Copy Tagged Text -->
                            <Button Grid.Column="1" Click="BtnCopyInteractiveOutput_Click" Height="36" Margin="10,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1E222A" BorderBrush="#333842" BorderThickness="1" CornerRadius="6" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCopy}" Fill="#CBD5E1" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="کپی متن تگ‌گذاری‌شده" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#282E38"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Send to MiniClip -->
                            <Button Grid.Column="3" Click="BtnSendToMiniClip_Click" Height="36" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Padding="12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#059669" Offset="0"/>
                                                    <GradientStop Color="#10B981" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRocket}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ثبت و ارسال به مینی‌کلیپ" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
