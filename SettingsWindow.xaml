<Window x:Class="imgsaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lbl_Settings_Title}" Width="450" Height="760"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{DynamicResource Lbl_Settings_Title}" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Language Selection -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Lbl_Language}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,15,0"/>
                        <ComboBox x:Name="CmbLanguage" Width="120" Height="28" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="فارسی" Tag="fa"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Storage_Location}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSavePath" IsReadOnly="True" VerticalContentAlignment="Center" Height="32" Padding="8,0" 
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Lbl_Browse}" Click="BtnBrowse_Click" Width="80" Margin="8,0,0,0" Height="32" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Shared_Folder}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkUseCustomDataFolder" Content="{DynamicResource Chk_Custom_Folder}"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When enabled, prompt library JSON files are read from and saved to the selected folder. Program settings stay local to this app copy."/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCustomDataFolder" IsReadOnly="True" VerticalContentAlignment="Center" Height="32" Padding="8,0"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Lbl_Browse}" Click="BtnBrowseCustomDataFolder_Click" Width="80" Margin="8,0,0,0" Height="32" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Gallery_Folder}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Lbl_Gallery_Desc}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGalleryPath" IsReadOnly="True" VerticalContentAlignment="Center" Height="32" Padding="8,0"
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Lbl_Browse}" Click="BtnBrowseGallery_Click" Width="80" Margin="8,0,0,0" Height="32" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_MiniClip_Autosave}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkAutoSaveEnabled" Content="{DynamicResource Chk_Autosave_Enabled}" 
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ChkAutoCaptureExtraTemplate" Content="{DynamicResource Chk_AutoCapture_Extra}" IsChecked="True"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When Mini-Clip sees copied text containing [extra], it replaces the previous extra template automatically."/>
                    <CheckBox x:Name="ChkAutoCopyExtraTemplateOutput" Content="{DynamicResource Chk_AutoCopy_Extra}" IsChecked="True"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When Mini-Clip receives a copied [extra] template, it automatically combines it with the selected Extra and copies the final text back to Windows clipboard."/>
                    <CheckBox x:Name="ChkAutoCopyTagReplacerOutput" Content="{DynamicResource Chk_AutoCopy_TagReplacer}" IsChecked="True"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When Mini-Clip receives a copied tag (PH) template, it automatically replaces the placeholders and copies the final text back to Windows clipboard."/>
                    <CheckBox x:Name="ChkReplacePositivePromptOnClipboardText" Content="{DynamicResource Chk_Replace_Pos}" IsChecked="True"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When disabled, Mini-Clip keeps the first POS text until POS is cleared manually or after saving."/>
                    <CheckBox x:Name="ChkSpiSyncPreserveBasePrompt" Content="{DynamicResource Chk_Preserve_Base}"
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When enabled, SPI Sync keeps the current Mini-Clip POS/base text and only randomizes the Persona/Extra item. The selected item title is stored as Additional Title."/>
                    <CheckBox x:Name="ChkUseTagReplacerForMiniClip" Content="{DynamicResource Chk_Use_Tag_Replacer}" 
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"
                              ToolTip="When enabled, Mini-Clip will use sequential placeholder replacement (e.g. [PH_1], [PH_2]) instead of simple [extra] replacement."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Lbl_Tag_Prefix}" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtTagReplacerPrefix" Text="PH_" Width="60" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 Padding="2,0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Lbl_Collect_Before_Save}" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtAutoSaveCount" Text="1" Width="50" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 Padding="2,0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Min_Dimensions}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Lbl_Min_Dimensions_Desc}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Min Width (px):" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtMinImageWidth" Text="50" Width="60" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 Padding="2,0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock Text="Min Height (px):" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="20,0,10,0"/>
                        <TextBox x:Name="TxtMinImageHeight" Text="50" Width="60" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 Padding="2,0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>
                    <CheckBox x:Name="ChkAutoImportEnabled" Content="{DynamicResource Chk_AutoImport}" 
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAutoImportPath" IsReadOnly="True" VerticalContentAlignment="Center" Height="32" Padding="8,0" 
                                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Lbl_Browse}" Click="BtnBrowseAutoImport_Click" Width="80" Margin="8,0,0,0" Height="32" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Recorder_Settings}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkSequentialMode" Content="{DynamicResource Chk_Sequential}" 
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Lbl_Default_Slot}" VerticalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbDefaultSlot" Width="100" Height="28">
                            <ComboBoxItem Content="Slot 1"/>
                            <ComboBoxItem Content="Slot 2"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource Lbl_Injector_Settings}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkRandomOnlyFavorites" Content="{DynamicResource Chk_Favorites_Only}" 
                              Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button Content="{DynamicResource Btn_Save_Close}" Click="BtnSave_Click" HorizontalAlignment="Right" Width="120" Height="36" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
