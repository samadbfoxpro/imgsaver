<Window x:Class="imgsaver.MiniQuickSaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Quick Saver" 
        Width="220" Height="240"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Left="300" Top="100">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="24" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" CornerRadius="8" 
            Background="{StaticResource BackgroundBrush}" Opacity="0.95"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="BorderBrush" Value="#666666"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Mini Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⚡ Quick Save" Foreground="{StaticResource ForegroundMutedBrush}" 
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,30,0" IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnDisable" Click="BtnDisable_Click"
                                Width="28" Height="24" FontSize="11"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Disable/Enable Monitoring"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="txt" Text="⏸" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="txt" Property="Text" Value="▶"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Play in-memory recording once -->
                        <Button x:Name="BtnPlayRecordingMini" Click="BtnPlayRecordingMini_Click"
                                Width="28" Height="24" FontSize="11" Margin="4,0"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand" ToolTip="Play loaded recording once"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Width="28" Height="24" FontSize="11"
                                Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12,10,12,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>  <!-- Image Preview -->
                    <RowDefinition Height="Auto"/> <!-- Status -->
                    <RowDefinition Height="Auto"/> <!-- Reset Button -->
                </Grid.RowDefinitions>

                <!-- Image Preview -->
                <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="4" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,8"
                        Cursor="Hand" MouseLeftButtonDown="ImagePreview_MouseLeftButtonDown"
                        ToolTip="Click to clear preview">
                    <Grid>
                        <StackPanel x:Name="PnlNoImage" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📷" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{StaticResource ForegroundMutedBrush}" Opacity="0.3"/>
                            <TextBlock Text="Waiting..." FontSize="10" Margin="0,4,0,0"
                                       Foreground="{StaticResource ForegroundMutedBrush}" Opacity="0.5"/>
                        </StackPanel>
                        
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Status -->
                <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="" FontSize="11" 
                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

            </Grid>
        </Grid>
    </Border>
</Window>
