<Window x:Class="imgsaver.BrowserRecordingFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="152" Height="96"
        MinWidth="152" MinHeight="96" MaxWidth="152" MaxHeight="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#EE181818" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10" Padding="8"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Button x:Name="BtnPlayRecording" Click="BtnPlayRecording_Click" ToolTip="Play browser recording"
                    Cursor="Hand" Padding="0" BorderThickness="1.5" BorderBrush="#FFD400" Background="#FFD400">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="Icon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="34" Foreground="#111111" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock x:Name="Label" Text="PLAY REC" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#111111" HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE16A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFE16A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9A900"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D9A900"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
