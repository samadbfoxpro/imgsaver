<Window x:Class="imgsaver.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت اسنیپت‌های متن" Height="620" Width="920"
        MinHeight="500" MinWidth="760"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="pack://application:,,,/Fonts/#Vazirmatn, Segoe UI, Tahoma"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern ScrollViewer / ScrollBar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#475569" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#141517"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#2B2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="Background" Value="#111214"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#25282C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#31353B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2024"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Styles -->
        <Style x:Key="WindowMinimizeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                            <Path Data="{StaticResource IconMinimize}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,4">
                            <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18191C" BorderBrush="#2B2D30" BorderThickness="1.2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Modern Title Bar -->
                <RowDefinition Height="*"/>  <!-- Main Content Area -->
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Background="#1E1F22" BorderBrush="#2B2D30" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#16202E" BorderBrush="#2563EB" BorderThickness="1" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconSnippets}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="مدیریت اسنیپت‌های متن" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <TextBlock Text="Text Snippets Manager" FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minimize & Close Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource WindowMinimizeBtn}" ToolTip="کوچک کردن"/>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource WindowCloseBtn}" ToolTip="بستن"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (Split in 2 Columns) -->
            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Snippets List & Quick Search -->
                <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#2B2D30" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header + Counter -->
                            <RowDefinition Height="Auto"/> <!-- Search Box -->
                            <RowDefinition Height="*"/>    <!-- ListBox -->
                            <RowDefinition Height="Auto"/> <!-- Add New Button -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="2,0,2,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSnippets}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="اسنیپت‌ها" FontSize="12.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#16202E" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtSnippetCount" Text="0 اسنیپت" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>

                        <!-- Search Bar -->
                        <Border Grid.Row="1" Background="#141517" BorderBrush="#2B2D30" BorderThickness="1" CornerRadius="8" Height="36" Margin="0,0,0,10" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconSearch}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" 
                                         FontSize="12" VerticalContentAlignment="Center" CaretBrush="#38BDF8"
                                         TextChanged="TxtSearch_TextChanged"/>
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Click="BtnClearSearch_Click" Visibility="Collapsed"
                                        Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="پاک کردن جستجو">
                                    <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Snippets ListBox -->
                        <ListBox x:Name="LstSnippets" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstSnippets_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#25282C"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#3B4252"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#162A45"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#16202E" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Key}" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" Foreground="#94A3B8" 
                                                   Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="20"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add New Button -->
                        <Button Grid.Row="3" x:Name="BtnNew" Click="BtnNew_Click" Style="{StaticResource PrimaryAccentButton}" Height="38" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="افزودن اسنیپت جدید" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Column: Rich Snippet Editor -->
                <Border Grid.Column="2" Background="#1E1F22" BorderBrush="#2B2D30" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header / Mode Badge & Copy -->
                            <RowDefinition Height="Auto"/> <!-- Key Input -->
                            <RowDefinition Height="*"/>    <!-- Full Value Input -->
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Editor Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Border Background="#16202E" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathEditorMode" Data="{StaticResource IconEdit}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditorTitle" Text="ویرایش اسنیپت" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnCopy" Click="BtnCopy_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Height="32" Padding="10,0" Style="{StaticResource SecondaryDarkButton}" ToolTip="کپی متن در کلیپ‌بورد">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathCopyIcon" Data="{StaticResource IconCopy}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCopyLabel" Text="کپی متن" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Keyword Input Card -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                <Path Data="{StaticResource IconFlash}" Fill="#F59E0B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="کلیدواژه میانبر (Shortcut Keyword)" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="*" Foreground="#EF4444" Margin="4,0,0,0" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBox x:Name="TxtKey" Style="{StaticResource ModernTextBox}" Height="40" 
                                     FontFamily="Consolas, Segoe UI" FontSize="14.5" FontWeight="SemiBold" Foreground="#38BDF8" 
                                     VerticalContentAlignment="Center" ToolTip="مثال: /email یا /prompt"/>

                            <!-- Info Box -->
                            <Border Background="#141923" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconInfo}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="هنگام تایپ این کلیدواژه و زدن کلید Space، متن جایگزین می‌شود. پیشنهاد می‌شود با علامت / شروع شود (مانند /mymail)." 
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Replacement Text Editor -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="2,0,2,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconEdit}" Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="متن جایگزین (Expansion Text)" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtStats" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="۰ کاراکتر • ۰ سطر" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBox x:Name="TxtValue" Grid.Row="1" Style="{StaticResource ModernTextBox}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                     FontSize="13" Padding="12" VerticalContentAlignment="Top"
                                     TextChanged="TxtValue_TextChanged"/>
                        </Grid>

                        <!-- Action Buttons Footer -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Save Button -->
                            <Button Grid.Column="0" x:Name="BtnSave" Click="BtnSave_Click" Style="{StaticResource PrimaryAccentButton}" Height="42">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSave}" Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ذخیره اسنیپت (Save Changes)" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Reset Form / Clear Button -->
                            <Button Grid.Column="1" Click="BtnNew_Click" Style="{StaticResource SecondaryDarkButton}" Height="42" Padding="14,0" Margin="10,0,0,0" ToolTip="پاک کردن فرم برای اسنیپت جدید">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="فرم جدید" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Delete Button -->
                            <Button Grid.Column="2" x:Name="BtnDelete" Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Height="42" Padding="16,0" Margin="10,0,0,0" ToolTip="حذف این اسنیپت">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="حذف" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Particle Canvas (Overlay) -->
            <Canvas x:Name="ParticleCanvas" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="False"/>
        </Grid>
    </Border>
</Window>
