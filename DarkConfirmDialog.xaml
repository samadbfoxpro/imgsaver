<Window x:Class="imgsaver.DarkConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Height="220" Width="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderIcon" Text="⚠️" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTitle" Text="Confirm Action" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Message -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Are you sure?" TextWrapping="Wrap" FontSize="12" Foreground="#DDDDDD" VerticalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Width="80" Height="32" Margin="0,0,8,0"
                        Background="#252525" BorderBrush="#444444" BorderThickness="1" Foreground="#CCCCCC" Cursor="Hand" FontSize="11"/>
                <Button x:Name="BtnConfirm" Content="Confirm" Click="BtnConfirm_Click" Width="90" Height="32"
                        Background="#145A32" BorderBrush="#2ECC71" BorderThickness="1.2" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1D7A44"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
