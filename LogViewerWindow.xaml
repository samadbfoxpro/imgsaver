<Window x:Class="imgsaver.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت و مانیتورینگ رویدادهای سیستم" 
        Height="720" Width="1060"
        MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#14161C"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flat Dark GridViewColumnHeader Style (eliminates default Aero/white styling) -->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#1C1F26"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#292E38"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="HeaderContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Margin="0,5"
                                   Width="2">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="Transparent" Cursor="SizeWE">
                                            <Rectangle Width="1" Fill="#333A48" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#242933"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2A303C"/>
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1C1F26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Dark ListViewItem Style -->
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1C2028"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E232D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#232F42"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Pill RadioButton Style -->
        <Style x:Key="FilterSegmentRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,5" Margin="1,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#262B36"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303746"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toolbar Button Style -->
        <Style x:Key="LogToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1F232B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#2D333F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282E39"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3D4554"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181B22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Custom Title Bar -->
            <RowDefinition Height="40"/>
            <!-- 1: Action Toolbar -->
            <RowDefinition Height="48"/>
            <!-- 2: Filter Toolbar -->
            <RowDefinition Height="44"/>
            <!-- 3: Main Logs Grid (Master) -->
            <RowDefinition Height="*"/>
            <!-- 4: Splitter -->
            <RowDefinition Height="5"/>
            <!-- 5: Details Card (Detail) -->
            <RowDefinition Height="170" MinHeight="90"/>
            <!-- 6: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: CUSTOM TITLE BAR -->
        <Border Grid.Row="0" Background="#181A20" BorderBrush="#252A36" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="#202532" BorderBrush="#2D3547" BorderThickness="1" Width="26" Height="26" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconSnippets}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="گزارش عملکرد و ثبت رویدادها" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Text="Live System Monitor" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Middle: Recording Indicator Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1D212A" BorderBrush="#2A303E" BorderThickness="1" CornerRadius="12" Padding="10,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="RecordingIndicatorDot" Width="7" Height="7" CornerRadius="3.5" Background="#64748B" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="RecordingIndicatorGlow" Color="#EF4444" BlurRadius="6" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="TxtRecordingStatus" Text="وضعیت: ضبط غیرفعال است" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="کوچک کردن">
                        <Rectangle Width="10" Height="1.5" Fill="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="بزرگ کردن">
                        <Path Data="{StaticResource IconMaximize}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="بستن">
                        <Path Data="{StaticResource IconClose}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: PRIMARY ACTION TOOLBAR -->
        <Border Grid.Row="1" Background="#16181F" BorderBrush="#232733" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Recording Toggle & Clear -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleRecord" Style="{StaticResource LogToolbarButtonStyle}" Click="BtnToggleRecord_Click" ToolTip="شروع یا توقف ضبط لاگ">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRecordIcon" Text="⏺" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRecordBtnLabel" Text="شروع ضبط لاگ" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LogToolbarButtonStyle}" Click="BtnClear_Click" Margin="8,0,0,0" ToolTip="پاکسازی تمام لاگ‌ها">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDelete}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="پاک کردن لاگ‌ها" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Save & Export Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LogToolbarButtonStyle}" Click="BtnSaveToFile_Click" ToolTip="ذخیره لاگ‌ها در یک فایل متنی">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSave}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ذخیره در فایل متنی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LogToolbarButtonStyle}" Click="BtnOpenLogsFolder_Click" Margin="8,0,0,0" ToolTip="باز کردن پوشه لاگ‌ها">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="پوشه لاگ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LogToolbarButtonStyle}" Click="BtnCopyAll_Click" Margin="8,0,0,0" ToolTip="کپی کل متن گزارش در کلیپ‌بورد">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCopy}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="کپی همه" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: FILTER & SEARCH TOOLBAR -->
        <Border Grid.Row="2" Background="#14161C" BorderBrush="#20242E" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Category Tabs Segment -->
                <Border Grid.Column="0" Background="#1A1C24" BorderBrush="#272C38" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadioFilterAll" Content="همه" IsChecked="True" Checked="Filter_Changed"
                                     Style="{StaticResource FilterSegmentRadioStyle}" GroupName="LogFilterGroup"/>
                        <RadioButton x:Name="RadioFilterMiniClip" Content="مینی کلیپ‌برد" Checked="Filter_Changed"
                                     Style="{StaticResource FilterSegmentRadioStyle}" GroupName="LogFilterGroup"/>
                        <RadioButton x:Name="RadioFilterBrowser" Content="مرورگر" Checked="Filter_Changed"
                                     Style="{StaticResource FilterSegmentRadioStyle}" GroupName="LogFilterGroup"/>
                        <RadioButton x:Name="RadioFilterCombiner" Content="کمباینر" Checked="Filter_Changed"
                                     Style="{StaticResource FilterSegmentRadioStyle}" GroupName="LogFilterGroup"/>
                        <RadioButton x:Name="RadioFilterSystem" Content="سیستم" Checked="Filter_Changed"
                                     Style="{StaticResource FilterSegmentRadioStyle}" GroupName="LogFilterGroup"/>
                    </StackPanel>
                </Border>

                <!-- Center / Right: Search Box -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,16,0" Width="260"
                        Background="#1A1C24" BorderBrush="#272C38" BorderThickness="1" CornerRadius="6" Height="28" Padding="8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                     Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                                     FontSize="11.5" VerticalContentAlignment="Center" Padding="0" CaretBrush="#38BDF8"/>
                            <TextBlock Text="جستجو در لاگ‌ها..." FontSize="11" Foreground="#555E6D" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right: Auto-Scroll Toggle -->
                <CheckBox x:Name="ChkAutoScroll" Grid.Column="2" Content="اسکرول خودکار" IsChecked="True"
                          Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ROW 3: LOGS DATA LIST -->
        <ListView x:Name="ListLogs" Grid.Row="3" Background="#13151A" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionChanged="ListLogs_SelectionChanged"
                  Foreground="#CBD5E1" FontSize="11.5">
            <ListView.View>
                <GridView>
                    <!-- Time Column -->
                    <GridViewColumn Header="زمان" Width="95">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TimeString}" Foreground="#7E8B9B" FontFamily="Consolas, Segoe UI Mono" FontSize="11" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Level Badge Column -->
                    <GridViewColumn Header="سطح" Width="68">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="5,1.5" HorizontalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#171C26"/>
                                            <Setter Property="BorderBrush" Value="#2A3342"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                    <Setter Property="Background" Value="#0A2619"/>
                                                    <Setter Property="BorderBrush" Value="#134E33"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Background" Value="#2B1D06"/>
                                                    <Setter Property="BorderBrush" Value="#543A0C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Background" Value="#2E1114"/>
                                                    <Setter Property="BorderBrush" Value="#591E24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Level}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Category Badge Column -->
                    <GridViewColumn Header="بخش" Width="92">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,1.5" HorizontalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#161B24"/>
                                            <Setter Property="BorderBrush" Value="#283140"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="MiniClip">
                                                    <Setter Property="Background" Value="#0A2033"/>
                                                    <Setter Property="BorderBrush" Value="#123B5C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Browser">
                                                    <Setter Property="Background" Value="#1F1130"/>
                                                    <Setter Property="BorderBrush" Value="#3E1E63"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Combiner">
                                                    <Setter Property="Background" Value="#261A04"/>
                                                    <Setter Property="BorderBrush" Value="#4F3609"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Bridge">
                                                    <Setter Property="Background" Value="#09241E"/>
                                                    <Setter Property="BorderBrush" Value="#11473B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="MiniClip">
                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Browser">
                                                        <Setter Property="Foreground" Value="#C084FC"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Combiner">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Bridge">
                                                        <Setter Property="Foreground" Value="#2DD4BF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Action Column -->
                    <GridViewColumn Header="عملیات" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="#E2E8F0" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Message Preview Column -->
                    <GridViewColumn Header="شرح پیام و رویداد" Width="550">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ROW 4: SPLITTER -->
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="#181B22" Cursor="SizeNS"/>

        <!-- ROW 5: DETAILS CARD (DETAIL VIEW) -->
        <Border Grid.Row="5" Background="#15171D" BorderBrush="#232733" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header of Details Card -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconInfo}" Fill="#60A5FA" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="جزئیات رویداد انتخاب‌شده" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDetailMeta" Text="" Foreground="#38BDF8" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource LogToolbarButtonStyle}" Click="BtnCopyDetail_Click" Height="26" Padding="10,0" ToolTip="کپی جزئیات انتخاب‌شده">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCopy}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="کپی جزئیات" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Content Box -->
                <TextBox x:Name="TxtDetailContent" Grid.Row="1" Background="#0F1115" Foreground="#CBD5E1"
                         BorderBrush="#212632" BorderThickness="1" FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11.5"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10">
                </TextBox>
            </Grid>
        </Border>

        <!-- ROW 6: STATUS BAR -->
        <Border Grid.Row="6" Background="#111317" BorderBrush="#1D212B" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCount" Text="کل رویدادها: 0" FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock Text=" • " FontSize="10.5" Foreground="#333A48" Margin="4,0"/>
                    <TextBlock x:Name="TxtFilteredCount" Text="نمایش داده شده: 0" FontSize="10.5" Foreground="#64748B"/>
                </StackPanel>

                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="مانیتورینگ زنده تعاملات مینی‌کلیپ‌برد، مرورگر و ابزارهای هوشمند"
                           FontSize="10" Foreground="#475569"/>

                <TextBlock x:Name="TxtLastSavedPath" Grid.Column="2" Text="" FontSize="10" Foreground="#10B981" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
