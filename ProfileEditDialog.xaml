<Window x:Class="imgsaver.ProfileEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Account Profile" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="*"/>    <!-- Form Fields -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderIcon" Text="👤" FontSize="20" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Add Account Profile" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="BtnCancel_Click" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Foreground="#AAAAAA"
                        Cursor="Hand" FontSize="13" ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <!-- Name Field -->
                <TextBlock Text="Account Name" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAccountName" Height="36" FontSize="13" Foreground="#FFFFFF" Background="#141414"
                         BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,14" VerticalContentAlignment="Center">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="10,0">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2ECC71"/>
                                    <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Icon Picker -->
                <TextBlock Text="Profile Icon" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ItemsControl x:Name="IconsHost" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Color Picker -->
                <TextBlock Text="Color Accent" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ItemsControl x:Name="ColorsHost" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="32" Margin="0,0,8,0"
                        Background="#252525" BorderBrush="#444444" BorderThickness="1" Foreground="#CCCCCC" Cursor="Hand" FontSize="11"/>
                <Button x:Name="BtnSave" Content="Save Account" Click="BtnSave_Click" Width="110" Height="32"
                        Background="#145A32" BorderBrush="#2ECC71" BorderThickness="1.2" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1D7A44"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
