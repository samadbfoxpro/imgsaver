<Window x:Class="imgsaver.ClipboardSaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Clipboard Saver" Height="650" Width="600"
        MinHeight="550" MinWidth="500"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- VS Code Title Bar -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>

            <!-- VS Code Style Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Quick Clipboard Saver" Foreground="{StaticResource ForegroundBrush}" 
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMiniMode" Content="Mini" Click="BtnMiniMode_Click"
                                Style="{StaticResource TitleBarButtonStyle}" Width="40" FontSize="11"
                                ToolTip="Switch to Mini Mode (Always on Top)"/>
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Path Selection -->
                    <RowDefinition Height="Auto"/> <!-- Counter -->
                    <RowDefinition Height="Auto"/> <!-- Instructions -->
                    <RowDefinition Height="*"/>    <!-- Preview -->
                    <RowDefinition Height="Auto"/> <!-- Clear Button -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="QUICK CLIPBOARD SAVER" FontSize="22" FontWeight="SemiBold" 
                               Foreground="{StaticResource ForegroundBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Fast Image Collection (Max 50)" FontSize="12" 
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 2. Path Selection -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Save Path:" VerticalAlignment="Center" 
                                   Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,10,0"/>
                        
                        <TextBox x:Name="TxtClipboardPath" Grid.Column="1" IsReadOnly="True" Text="No path selected..." 
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource ForegroundBrush}"/>
                        
                        <Button x:Name="BtnSelectClipboardFolder" Grid.Column="2" Content="Browse" 
                                Click="BtnSelectClipboardFolder_Click" 
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- 3. Counter -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Images Saved" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="TxtCounter" Text="0 / 50" Foreground="{StaticResource AccentBrush}" 
                                       FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource SuccessBrush}" 
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtNextNumber" Text="Next: 001.png" 
                                       Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" 
                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Instructions -->
                <Border Grid.Row="3" Background="#0D3794FF" BorderBrush="{StaticResource AccentBrush}" 
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💡 HOW TO USE" Foreground="{StaticResource AccentBrush}" 
                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" Opacity="0.8">
                            <Run Text="1. Copy an image to clipboard"/>
                            <LineBreak/>
                            <Run Text="2. Click here and press Ctrl+V"/>
                            <LineBreak/>
                            <Run Text="3. Image auto-saves with sequential numbering"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 5. Preview Area -->
                <Border x:Name="PreviewBorder" Grid.Row="4" Margin="0,0,0,16" 
                        Background="#0A0A0A" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <!-- Placeholder -->
                        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Opacity="0.2"/>
                            <TextBlock Text="Press Ctrl+V to paste and save" 
                                       Foreground="{StaticResource ForegroundMutedBrush}" 
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- Preview Image -->
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 6. Clear Button -->
                <Button Grid.Row="5" x:Name="BtnClearSession" Content="CLEAR SESSION (RESET COUNTER)" 
                        Click="BtnClearSession_Click" 
                        Style="{StaticResource SecondaryButtonStyle}" Height="40" FontSize="13" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
