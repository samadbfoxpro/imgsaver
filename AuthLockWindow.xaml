<Window x:Class="imgsaver.AuthLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="امنیت و قفل برنامه (App Security)" Height="540" Width="470"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Icon="{x:Null}">

    <Window.Resources>
        <!-- Vector Icons -->
        <StreamGeometry x:Key="IconShieldLock">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8V9H16A1,1 0 0,1 17,10V15A1,1 0 0,1 16,16H8A1,1 0 0,1 7,15V10A1,1 0 0,1 8,9H9V8A3,3 0 0,1 12,5M12,7A1,1 0 0,0 11,8V9H13V8A1,1 0 0,0 12,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconKey">M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10C7.74,10 8.38,10.4 8.71,11H13V13H11V15H9V13H8.71C8.38,13.6 7.74,14 7,14M7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.5,18 11.66,16.47 12.54,14.32L17.5,19.28C18.67,20.45 20.57,20.45 21.74,19.28C22.91,18.11 22.91,16.21 21.74,15.04L19.5,12.8C19.82,12 20,11 20,10A6,6 0 0,0 14,4C11.5,4 9.34,5.53 8.46,7.68L7,6Z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeOff">M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.79 8.06,5.32L10.12,7.38C10.71,7.14 11.34,7 12,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z</StreamGeometry>
        <StreamGeometry x:Key="IconPattern">M4,4H10V10H4V4M14,4H20V10H14V4M4,14H10V20H4V14M14,14H20V20H14V14Z</StreamGeometry>
    </Window.Resources>

    <Border x:Name="ContainerBorder" Background="#141519" BorderBrush="#2F333E" BorderThickness="1" CornerRadius="12" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ContainerScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="WindowShakeTransform"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content Body -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#1A1C22" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Data="{StaticResource IconShieldLock}" Fill="#06B6D4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="امنیت برنامه (App Security)" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="خروج از برنامه">
                        <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="28,20,28,24" VerticalAlignment="Center">
                
                <!-- Shield Icon Badge -->
                <Border Background="#0C242B" BorderBrush="#0891B2" BorderThickness="1.5" CornerRadius="32" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource IconShieldLock}" Fill="#06B6D4" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Subtitle -->
                <TextBlock x:Name="TxtTitle" Text="ورود امن به برنامه" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSubtitle" Text="برای دسترسی به محیط برنامه، رمز عبور را وارد کنید." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid x:Name="AuthViewGrid" ClipToBounds="True">
                    <!-- Password View -->
                    <StackPanel x:Name="PasswordViewContainer" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PasswordViewTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <!-- Primary Password Box -->
                        <TextBlock Text="رمز عبور اصلی (Master Password)" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                        <Border Background="#1A1C24" BorderBrush="#2D3240" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="TxtPasswordBox" Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="13" VerticalAlignment="Center"
                                             FlowDirection="LeftToRight"
                                             PasswordChar="●" KeyDown="Input_KeyDown"/>

                                <TextBox x:Name="TxtPasswordPlain" Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="13" VerticalAlignment="Center"
                                         FlowDirection="LeftToRight" Visibility="Collapsed"
                                         KeyDown="Input_KeyDown"/>

                                <Button x:Name="BtnTogglePeek" Grid.Column="1" Click="BtnTogglePeek_Click"
                                        Width="28" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="نمایش/مخفی‌سازی رمز">
                                    <Path x:Name="PeekIconPath" Data="{StaticResource IconEye}" Fill="#64748B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Confirm Password Box (Setup Mode Only) -->
                        <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="تکرار رمز عبور (Confirm Password)" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                            <Border Background="#1A1C24" BorderBrush="#2D3240" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                <PasswordBox x:Name="TxtConfirmPasswordBox" Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="13" VerticalAlignment="Center"
                                             FlowDirection="LeftToRight"
                                             PasswordChar="●" KeyDown="Input_KeyDown"/>
                            </Border>
                        </StackPanel>

                        <!-- Submit Action Button -->
                        <Button x:Name="BtnSubmit" Click="BtnSubmit_Click" Height="38" Cursor="Hand" Style="{StaticResource PrimaryButtonStyle}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconKey}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSubmitButton" Text="ورود به برنامه" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pattern View -->
                    <StackPanel x:Name="PatternViewContainer" Visibility="Visible" HorizontalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PatternViewTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <Canvas x:Name="PatternCanvas" Width="260" Height="260" Background="Transparent"
                                MouseLeftButtonDown="PatternCanvas_PointerDown"
                                MouseMove="PatternCanvas_PointerMove"
                                MouseLeftButtonUp="PatternCanvas_PointerUp"
                                MouseLeave="PatternCanvas_PointerLeave"
                                TouchDown="PatternCanvas_PointerDown"
                                TouchMove="PatternCanvas_PointerMove"
                                TouchUp="PatternCanvas_PointerUp"
                                TouchLeave="PatternCanvas_PointerLeave">
                        </Canvas>
                        <TextBlock x:Name="TxtPatternStatus" Text="الگوی خود را رسم کنید" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <!-- Typing hint -->
                        <TextBlock Text="یا هر کلیدی بزنید..." Foreground="#3F4860" FontSize="10.5" HorizontalAlignment="Center" Margin="0,6,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>

                <!-- Error / Status Message Alert -->
                <Border x:Name="ErrorBadge" Background="#2B1115" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErrorMessage" Text="رمز عبور اشتباه است." Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"/>
                </Border>

                <!-- Switch Auth Mode Button -->
                <Button x:Name="BtnSwitchAuthMode" Click="BtnSwitchAuthMode_Click" Height="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path x:Name="SwitchIconPath" Data="{StaticResource IconPattern}" Fill="#0ea5e9" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSwitchAuthMode" Text="ورود با الگوی ۹ نقطه‌ای" FontSize="11.5" Foreground="#0ea5e9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Cancel / Exit Button -->
                <Button Click="BtnClose_Click" Height="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
                    <TextBlock Text="خروج از برنامه (Exit)" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
