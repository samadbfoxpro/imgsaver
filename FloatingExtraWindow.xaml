<Window x:Class="imgsaver.FloatingExtraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extra Float"
        Width="300" Height="420"
        MinWidth="240" MinHeight="260"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        Left="20" Top="140">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
            Background="{StaticResource BackgroundBrush}" Opacity="0.98">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>   <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="🧩" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Extra Float" Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnClose" Grid.Column="2" Content="✕" Click="BtnClose_Click"
                            Style="{StaticResource TitleBarCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="10,8,10,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Mode toggle -->
                    <RowDefinition Height="*"/>    <!-- List / Custom area -->
                    <RowDefinition Height="Auto"/> <!-- Title override -->
                    <RowDefinition Height="Auto"/> <!-- Confirm button -->
                </Grid.RowDefinitions>

                <!-- Mode toggle -->
                <CheckBox x:Name="ChkUseCustomText" Grid.Row="0" Content="Use custom text instead"
                          Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"
                          Margin="2,0,0,6" Checked="ChkUseCustomText_CheckedChanged" Unchecked="ChkUseCustomText_CheckedChanged"/>

                <!-- List of Extras (multi-select via checkboxes) -->
                <Border x:Name="BorderExtraList" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox x:Name="LstExtras" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,3"
                                          Checked="ExtraCheck_Changed" Unchecked="ExtraCheck_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                        <TextBlock Text="{Binding Text}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource ForegroundMutedBrush}" MaxWidth="220"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- Custom text area -->
                <Grid x:Name="PanelCustomText" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtCustomText" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="6"
                             ToolTip="Enter your custom Extra text"/>
                </Grid>

                <!-- Title override -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Title:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}" Margin="2,0,6,0"/>
                    <TextBox x:Name="TxtCustomTitle" Grid.Column="1" Height="26" FontSize="11" Padding="6,3"
                             ToolTip="Optional — overrides the displayed title"/>
                </Grid>

                <Button x:Name="BtnConfirm" Grid.Row="3" Content="✔ Confirm Extra" Click="BtnConfirm_Click"
                        Margin="0,8,0,0" Height="32" FontWeight="SemiBold"/>
            </Grid>

            <!-- Footer: last confirmed title -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last: " FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}"/>
                    <TextBlock x:Name="TxtLastConfirmedTitle" Text="—" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
