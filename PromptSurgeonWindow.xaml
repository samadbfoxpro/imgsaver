<Window x:Class="imgsaver.PromptSurgeonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Surgeon" Height="700" Width="1040"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="14"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="14" BorderThickness="1" BorderBrush="#1C2640" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000818" BlurRadius="30" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090D1A" Offset="0"/>
                <GradientStop Color="#05070F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 1. CUSTOM TOP TITLEBAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#0C1122" CornerRadius="14,14,0,0"
                    FlowDirection="LeftToRight"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderThickness="0,0,0,1" BorderBrush="#161E34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Border CornerRadius="8" Width="26" Height="26" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                            <Path Data="{StaticResource IconCut}" Style="{StaticResource VectorIconSmall}" Fill="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Prompt Surgeon" Foreground="#F0F6FC" FontSize="13.5" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="□" Click="BtnMaximize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 2. MAIN WORKSPACE -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Top Action Pills -->
                    <RowDefinition Height="1.2*"/> <!-- 1: 3 Neon Editor Cards -->
                    <RowDefinition Height="Auto"/> <!-- 2: Translation Toggle Strip -->
                    <RowDefinition Height="Auto"/> <!-- 3: AI/Persian Input Strip -->
                    <RowDefinition Height="Auto"/> <!-- 4: Target Selection & Persian Action Strip -->
                    <RowDefinition Height="Auto"/> <!-- 5: Bottom Persian Meaning Card -->
                </Grid.RowDefinitions>

                <!-- ── 0. TOP ACTION PILLS (ROW 0) ── -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Paste (Blue/Violet Neon Pill) -->
                    <Button Grid.Column="0" x:Name="BtnPaste" Click="BtnPaste_Click" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#0C142E" BorderThickness="1.5" BorderBrush="#3B82F6" Padding="10,0">
                                    <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCopy}" Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Paste (ورودی)" FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#142044"/><Setter TargetName="b" Property="BorderBrush" Value="#60A5FA"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Copy Output (Cyan/Blue Neon Pill) -->
                    <Button Grid.Column="2" x:Name="BtnCopy" Click="BtnCopy_Click" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#081A36" BorderThickness="1.5" BorderBrush="#0284C7" Padding="10,0">
                                    <Border.Effect><DropShadowEffect Color="#0284C7" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconShare}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copy Output (کپی خروجی)" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0E2850"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Clear All (Crimson/Magenta Neon Pill) -->
                    <Button Grid.Column="4" x:Name="BtnClear" Click="BtnClear_Click" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#260C14" BorderThickness="1.5" BorderBrush="#E11D48" Padding="10,0">
                                    <Border.Effect><DropShadowEffect Color="#E11D48" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDelete}" Fill="#FB7185" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Clear All (پاکسازی)" FontSize="11.5" FontWeight="SemiBold" Foreground="#FDA4AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#38101E"/><Setter TargetName="b" Property="BorderBrush" Value="#FB7185"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. Reset Edit to Input (Teal Neon Pill) -->
                    <Button Grid.Column="6" x:Name="BtnResetEdit" Click="BtnResetEdit_Click" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#061E1E" BorderThickness="1.5" BorderBrush="#0D9488" Padding="10,0">
                                    <Border.Effect><DropShadowEffect Color="#0D9488" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#2DD4BF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reset Edit to Input" FontSize="11.5" FontWeight="SemiBold" Foreground="#5EEAD4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0A2C2C"/><Setter TargetName="b" Property="BorderBrush" Value="#2DD4BF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── 1. 3 NEON GLASS EDITOR PANELS (ROW 1) ── -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel 1: Input Box (Neon Blue) -->
                    <Border Grid.Column="0" CornerRadius="14" Background="#081024" BorderThickness="1.5" BorderBrush="#2563EB" Padding="10">
                        <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,8" FlowDirection="RightToLeft">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#1D4ED8" Margin="0,0,7,0">
                                        <Path Data="{StaticResource IconBrowser}" Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ورودی (ورودی)" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="کپی متن ورودی"
                                        Click="BtnCopyInput_Click">
                                    <Path Data="{StaticResource IconCopy}" Fill="#60A5FA" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="#050B18" CornerRadius="10" Padding="8">
                                <TextBox x:Name="TxtInput" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         FontSize="12" FontFamily="Consolas"
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         TextChanged="TxtInput_TextChanged"
                                         ToolTip="متن خام پرامپت خود را اینجا وارد کنید"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Panel 2: Surgery Edit Box (Neon Amber) -->
                    <Border Grid.Column="2" CornerRadius="14" Background="#1A1106" BorderThickness="1.5" BorderBrush="#D97706" Padding="10">
                        <Border.Effect><DropShadowEffect Color="#D97706" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,8" FlowDirection="RightToLeft">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#D97706" Margin="0,0,7,0">
                                        <Path Data="{StaticResource IconSettings}" Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="اصلاح و ویرایش (اتصال)" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="کپی متن اصلاح‌شده"
                                        Click="BtnCopyEdit_Click">
                                    <Path Data="{StaticResource IconCopy}" Fill="#FBBF24" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="#0F0B04" CornerRadius="10" Padding="8">
                                <TextBox x:Name="TxtEdit" Background="Transparent" Foreground="#FEF08A" BorderThickness="0"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         FontSize="12" FontFamily="Consolas"
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         TextChanged="TxtEdit_TextChanged"
                                         ToolTip="بخشی از متن را انتخاب و برای ترجمه و جایگزینی راست‌کلیک کنید">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🌐 جایگزینی ترجمه" Click="MenuSendToTranslate_Click" Foreground="#3794FF" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <MenuItem Header="📍 درج ترجمه" Click="MenuInsertAtCursor_Click" Foreground="#00D2D3" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <MenuItem Header="🔍 معنی فارسی" Click="MenuTranslateSelectionToPersian_Click" Foreground="#FFD700" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <Separator Background="#33363F" Margin="4,2"/>
                                            <MenuItem Command="Cut" Header="✂️ برش (Cut)" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <MenuItem Command="Copy" Header="📑 کپی (Copy)" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <MenuItem Command="Paste" Header="📋 چسباندن (Paste)" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                            <MenuItem Command="SelectAll" Header="🔲 انتخاب همه (Select All)" FontFamily="{StaticResource AppFontFamily}" FontSize="13"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Panel 3: Output Box (Neon Emerald/Teal) -->
                    <Border Grid.Column="4" CornerRadius="14" Background="#061814" BorderThickness="1.5" BorderBrush="#059669" Padding="10">
                        <Border.Effect><DropShadowEffect Color="#059669" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,8" FlowDirection="RightToLeft">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#059669" Margin="0,0,7,0">
                                        <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="خروجی نهایی (خروجی)" FontSize="12" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="کپی خروجی نهایی"
                                        Click="BtnCopy_Click">
                                    <Path Data="{StaticResource IconCopy}" Fill="#34D399" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <Border x:Name="BorderOutput" Grid.Row="1" Background="#030E0C" CornerRadius="10" Padding="8"
                                    Cursor="Hand" MouseEnter="RtfOutput_MouseEnter" MouseLeave="RtfOutput_MouseLeave" PreviewMouseLeftButtonDown="RtfOutput_PreviewMouseLeftButtonDown">
                                <RichTextBox x:Name="RtfOutput" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                             IsReadOnly="True" IsDocumentEnabled="True" Focusable="False"
                                             FontSize="12" FontFamily="Consolas" Cursor="Hand"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <RichTextBox.Resources>
                                        <Style TargetType="{x:Type Paragraph}"><Setter Property="Margin" Value="0"/></Style>
                                    </RichTextBox.Resources>
                                    <FlowDocument PagePadding="0">
                                        <Paragraph><Run Text=""/></Paragraph>
                                    </FlowDocument>
                                </RichTextBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 2. TRANSLATION TOGGLE STRIP (ROW 2) ── -->
                <Border Grid.Row="2" CornerRadius="10" Background="#081024" BorderThickness="1" BorderBrush="#162548" Padding="12,7" Margin="0,0,0,8">
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Right: Toggle Display -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="نمایش ترجمه و جایگزینی در پرامپت" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#1D4ED8" CornerRadius="10" Width="34" Height="18">
                                <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Right" Margin="2,0"/>
                            </Border>
                        </StackPanel>

                        <!-- Center Info Text -->
                        <TextBlock x:Name="TxtTranslateStatus" Grid.Column="1" Text="پشتیبانی ترجمه فارسی به انگلیسی و جایگزینی در پرامپت" FontSize="11" Foreground="#7E90B0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Left: Google Translate Badge -->
                        <Border Grid.Column="2" Background="#132B5E" BorderThickness="1" BorderBrush="#2563EB" CornerRadius="7" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGlobe}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Google Translate" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── 3. AI / PERSIAN INPUT STRIP (ROW 3) ── -->
                <Grid Grid.Row="3" Margin="0,0,0,8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Button: ترجمه (Left) -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/> <!-- Target Chip (Center-Left) -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>    <!-- Main Persian Input Box (Right) -->
                    </Grid.ColumnDefinitions>

                    <!-- Translate Action Button (Glowing Purple - Far Left) -->
                    <Button Grid.Column="0" x:Name="BtnTranslateAndReplace" Click="BtnTranslateAndReplace_Click" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#6B21A8" Padding="16,0">
                                    <Border.Effect><DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconShare}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ترجمه" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#7E22CE"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Target Selection Chip -->
                    <Border Grid.Column="2" Background="#0C1428" BorderThickness="1" BorderBrush="#1C2C50" CornerRadius="10" Height="42" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Path Data="{StaticResource IconGlobe}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedTargetPreview" Text="(بدون انتخاب)" MaxWidth="180" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="BtnClearTarget" Content="✕" Click="BtnClearTarget_Click" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="10" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Main Persian Text Box Input (Far Right) -->
                    <Border Grid.Column="4" Background="#070B18" BorderThickness="1" BorderBrush="#162240" CornerRadius="10" Height="42" Padding="12,2">
                        <Grid>
                            <TextBox x:Name="TxtPersianInput" Background="Transparent" Foreground="#FDE047" CaretBrush="#FDE047" BorderThickness="0"
                                     FontSize="13" FontFamily="{StaticResource AppFontFamily}" FontWeight="SemiBold"
                                     FlowDirection="RightToLeft" TextAlignment="Right"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                                     TextWrapping="NoWrap" KeyDown="TxtPersianInput_KeyDown"
                                     Padding="0,0,24,0"
                                     ToolTip="متن جایگزین به فارسی را اینجا بنویسید و دکمه Enter را بزنید..."/>
                            <Path Data="{StaticResource IconFlash}" Fill="#A855F7" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 4. TARGET SELECTION & PERSIAN ACTION STRIP (ROW 4) ── -->
                <Grid Grid.Row="4" Margin="0,0,0,8" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Amber Action Button -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/> <!-- Label -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>    <!-- Middle Status & English Preview Chip -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/> <!-- Copy Persian Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Amber Action Button: ترجمه به فارسی -->
                    <Button Grid.Column="0" Click="MenuTranslateSelectionToPersian_Click" Height="38" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="#451A03" BorderThickness="1.5" BorderBrush="#D97706" Padding="12,0">
                                    <Border.Effect><DropShadowEffect Color="#D97706" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTagger}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ترجمه به فارسی" FontSize="11" FontWeight="Bold" Foreground="#FDE047" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#5C2304"/><Setter TargetName="b" Property="BorderBrush" Value="#F59E0B"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Label: معنی فارسی عبارت انگلیسی -->
                    <Border Grid.Column="2" Background="#0C1428" BorderThickness="1" BorderBrush="#1C2A48" CornerRadius="8" Padding="10,0" Height="38">
                        <TextBlock Text="معنی فارسی عبارت انگلیسی" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Middle Status & English Preview Chip -->
                    <Border Grid.Column="4" Background="#081024" BorderThickness="1" BorderBrush="#162444" CornerRadius="8" Height="38" Padding="12,0">
                        <Grid FlowDirection="RightToLeft">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="متن انگلیسی: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEnSourcePreview" Text="(متن انتخاب‌نشده است) - بخشی از پرامپت را سلکت کنید" MaxWidth="450" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Blue Button: کپی معنی فارسی -->
                    <Button Grid.Column="6" x:Name="BtnCopyPersianTranslation" Click="BtnCopyPersianTranslation_Click" Height="38" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="#0E1A34" BorderThickness="1.5" BorderBrush="#2563EB" Padding="12,0">
                                    <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCopy}" Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="کپی معنی فارسی" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#16274E"/><Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── 5. BOTTOM PERSIAN MEANING DISPLAY BANNER (ROW 5) ── -->
                <Border Grid.Row="5" CornerRadius="12" Background="#160F05" BorderThickness="1.5" BorderBrush="#B45309" Padding="14,10">
                    <Border.Effect><DropShadowEffect Color="#D97706" BlurRadius="12" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Glowing Magic Wand / Sparkle Badge -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#3D1A06" BorderThickness="1" BorderBrush="#D97706" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFlash}" Fill="#FBBF24" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Persian Meaning Live Text -->
                        <TextBox x:Name="TxtPersianMeaningDisplay" Grid.Column="1" Background="Transparent" Foreground="#FDE047" BorderThickness="0"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Cursor="IBeam"
                                 FontSize="12.5" FontFamily="{StaticResource AppFontFamily}" FontWeight="SemiBold"
                                 FlowDirection="RightToLeft" TextAlignment="Right"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="ترجمه فارسی عبارت انتخاب‌شده در اینجا نمایش داده می‌شود..."/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
