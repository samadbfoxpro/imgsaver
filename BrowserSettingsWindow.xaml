<Window x:Class="imgsaver.BrowserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Settings" Width="400" Height="720"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⚙ Browser Configuration" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Content Filtering" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <CheckBox x:Name="ChkLoadImages" Content="Load Images" Margin="0,0,0,12" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkLoadMedia" Content="Load Video &amp; Audio Media" Margin="0,0,0,12" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkEnableJS" Content="Enable JavaScript" Margin="0,0,0,12" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkMuteAudio" Content="Mute Browser Audio" Margin="0,0,0,12" Foreground="{StaticResource ForegroundBrush}"/>
                    <CheckBox x:Name="ChkAutoHideStatus" Content="Auto-hide Status Bar (Bottom)" Margin="0,0,0,12" Foreground="{StaticResource ForegroundBrush}"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,10"/>

                    <TextBlock Text="Proxy Configuration" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,10"/>
                    <CheckBox x:Name="ChkEnableProxy" Content="Enable Proxy Server" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Type" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbProxyType" Height="32">
                                <ComboBoxItem Content="HTTP" Tag="http"/>
                                <ComboBoxItem Content="SOCKS5" Tag="socks5"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Proxy Address" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtProxyAddress" Height="32" Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="5,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtProxyPort" Height="32" Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="5,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Note: Proxy changes require browser restart to take full effect." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,-10,0,10"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,10"/>

                    <TextBlock Text="Site-Specific Cache" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,10"/>
                    <TextBlock Text="No-Cache Sites (only cookies/login cache):" FontSize="11" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstNoCacheSites" Height="100" Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="TxtNewNoCacheSite" Height="28" Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,8,0"/>
                        <Button Content="➕ Add" Click="BtnAddNoCacheSite_Click" Height="28" Width="70" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="BtnRemoveNoCacheSite" Content="➖ Remove" Click="BtnRemoveNoCacheSite_Click" Height="28" Width="80" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,10"/>

                    <TextBlock Text="Cached Sites" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,10"/>
                    <ListBox x:Name="LstCachedSites" Height="120" Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Info}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="BtnClearSelectedSite" Content="🗑 Clear Selected Site Cache" Click="BtnClearSelectedSite_Click" 
                            Height="32" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,15"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,10"/>

                    <TextBlock Text="Global Maintenance" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"/>
                    <Button x:Name="BtnClearData" Content="🔥 Clear ALL Browsing Data" Click="BtnClearData_Click" 
                            Height="32" Style="{StaticResource SecondaryButtonStyle}" Foreground="#FF5555"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="32" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Save Settings" Click="BtnSave_Click" Width="110" Height="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>