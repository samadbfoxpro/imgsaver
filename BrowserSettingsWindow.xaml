<Window x:Class="imgsaver.BrowserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Settings" Width="980" Height="700" MinWidth="760" MinHeight="560"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SettingsMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border" 
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path Name="Arrow"
                                                      Grid.Column="1"     
                                                      Fill="#F1F1F1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="SubMenu"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder"
                                            Background="#252526"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TxtTitleBarHeader" Text="Browser Settings" VerticalAlignment="Center" Margin="14,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <Button Content="X" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="TxtSidebarHeader" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <TextBlock x:Name="TxtSidebarSubHeader" Text="Browser configuration and storage controls" Style="{StaticResource SettingsMutedTextStyle}" FontSize="12" Margin="0,0,0,16"/>

                            <!-- Segmented Rectangular 2-Part Language Toggle -->
                            <Border Background="#252526" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,16" Padding="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnLangEN" Grid.Column="0" Content="English" Click="BtnLangEN_Click" Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11" FontWeight="Bold" Padding="0"/>
                                    <Button x:Name="BtnLangFA" Grid.Column="1" Content="فارسی" Click="BtnLangFA_Click" Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11" FontWeight="Bold" Padding="0"/>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnNavGeneral" Tag="GeneralPanel" Click="SidebarNav_Click" Style="{StaticResource SettingsNavButtonStyle}">
                                <TextBlock x:Name="TxtNavGeneral" Text="General"/>
                            </Button>
                            <Button x:Name="BtnNavProxy" Tag="ProxyPanel" Click="SidebarNav_Click" Style="{StaticResource SettingsNavButtonStyle}">
                                <TextBlock x:Name="TxtNavProxy" Text="Proxy"/>
                            </Button>
                            <Button x:Name="BtnNavSiteRules" Tag="SiteRulesPanel" Click="SidebarNav_Click" Style="{StaticResource SettingsNavButtonStyle}">
                                <TextBlock x:Name="TxtNavSiteRules" Text="Site Rules"/>
                            </Button>
                            <Button x:Name="BtnNavCache" Tag="CachePanel" Click="SidebarNav_Click" Style="{StaticResource SettingsNavButtonStyle}">
                                <TextBlock x:Name="TxtNavCache" Text="Cache Management"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="0" Margin="28,24,28,24">
                    <Grid x:Name="ContentHost">
                        <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TxtSectionGeneralTitle" Text="General" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBlock x:Name="TxtSectionGeneralDesc" Text="Content loading and browser behavior." Style="{StaticResource SettingsMutedTextStyle}" Margin="0,0,0,18"/>

                                <Border Style="{StaticResource SettingsPanelStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkLoadImages" Content="Load Images" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkLoadMedia" Content="Load Video and Audio Media" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkEnableJS" Content="Enable JavaScript" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkMuteAudio" Content="Mute Browser Audio" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkAutoImportImagesToMiniClip" Content="Automatically import browser images to Mini Clip" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkShowMiniClipImageImportButtons" Content="Show Mini Clip import button on large images" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkReplaceMiniClipImageOnImport" Content="Replace current Mini Clip image when importing from browser" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkShowFloatingRecordPlayer" Content="Show floating browser recording player" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkShowQuickPasteButton" Content="Show BR Paste button on input fields" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkEnableAutoQuickPaste" Content="Enable Auto Quick Paste &amp; Action from Clipboard" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkShowAutoPastePins" Content="Show floating location pins (Input 1 &amp; Action 2)" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="24,0,0,14">
                                            <TextBlock x:Name="TxtPinsOpacityLabel" Text="Pins Opacity:" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider x:Name="SldPinsOpacity" Minimum="0" Maximum="100" Value="100" Width="140" VerticalAlignment="Center" ValueChanged="SldPinsOpacity_ValueChanged"/>
                                            <TextBlock x:Name="TxtPinsOpacityValue" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Width="36"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkEnableCombinerBar" Content="Enable Smart Prompt Combiner toolbar at bottom of browser" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkAutoFocusMiniClip" Content="Automatically focus main Mini Clip window when capturing data" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkAutoHideStatus" Content="Hide Status Bar" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ProxyPanel" Visibility="Collapsed" Opacity="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Proxy" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBlock Text="Configure the proxy used by browser tabs and downloads." Style="{StaticResource SettingsMutedTextStyle}" Margin="0,0,0,18"/>

                                <Border Style="{StaticResource SettingsPanelStyle}">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="Proxy Mode" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CmbProxyMode" Height="34" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CmbProxyMode_SelectionChanged">
                                                <ComboBoxItem Content="Use Windows System Proxy (Default)" Tag="system" Background="#252526" Foreground="#F1F1F1"/>
                                                <ComboBoxItem Content="No Proxy (Direct Connection)" Tag="off" Background="#252526" Foreground="#F1F1F1"/>
                                                <ComboBoxItem Content="Use Custom Proxy Server" Tag="custom" Background="#252526" Foreground="#F1F1F1"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Grid x:Name="GridCustomProxySettings">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Type" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="CmbProxyType" Height="34" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="HTTP" Tag="http" Background="#252526" Foreground="#F1F1F1"/>
                                                    <ComboBoxItem Content="SOCKS5" Tag="socks5" Background="#252526" Foreground="#F1F1F1"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="Proxy Address" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtProxyAddress" Height="34" Padding="10,4" Foreground="White" CaretBrush="White" Focusable="True" IsHitTestVisible="True" PreviewMouseDown="TextBox_PreviewMouseDown"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource ForegroundMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtProxyPort" Height="34" Padding="10,4" Foreground="White" CaretBrush="White" Focusable="True" IsHitTestVisible="True" PreviewMouseDown="TextBox_PreviewMouseDown"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Proxy changes reload tabs so the active WebView profile can use the new network configuration." Style="{StaticResource SettingsMutedTextStyle}" FontSize="12" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="SiteRulesPanel" Visibility="Collapsed" Opacity="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Site Rules" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <TextBlock Text="Exclude selected hosts from the custom file cache while keeping normal site login data available." Style="{StaticResource SettingsMutedTextStyle}" Margin="0,0,0,18"/>

                                <Border Style="{StaticResource SettingsPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="No-Cache Sites" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ListBox x:Name="LstNoCacheSites" Height="190" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtNewNoCacheSite" Height="34" Padding="10,4" Foreground="White" CaretBrush="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Add" Click="BtnAddNoCacheSite_Click" Height="34" Width="78" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnRemoveNoCacheSite" Grid.Column="2" Content="Remove" Click="BtnRemoveNoCacheSite_Click" Height="34" Width="90" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="CachePanel" Visibility="Collapsed" Opacity="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Cache Management" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                        <TextBlock Text="Remove saved browser cache files without signing out of websites." Style="{StaticResource SettingsMutedTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Click="BtnRefreshCache_Click" Height="34" Width="92" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"/>
                                </Grid>

                                <Border Style="{StaticResource SettingsPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Total cache" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="TxtTotalCacheSize" Text="0 B" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Cached sites" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="TxtCachedSiteCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cached files" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="TxtCachedFileCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsPanelStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Saved Website Cache" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Sort by" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbCacheSort" Width="150" Height="32" SelectionChanged="CmbCacheSort_SelectionChanged">
                                                    <ComboBoxItem Content="Site name" Tag="name"/>
                                                    <ComboBoxItem Content="Cache size" Tag="size"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <ListView x:Name="LstCachedSites" Height="260" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SelectionMode="Single">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Website" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                                    <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeText}"/>
                                                    <GridViewColumn Header="Files" Width="90" DisplayMemberBinding="{Binding FileCount}"/>
                                                    <GridViewColumn Header="Action" Width="120">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Delete" Click="BtnDeleteSiteCache_Click" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,3" Tag="{Binding}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <CheckBox x:Name="ChkDeleteLoginData" Content="Delete Login Data and Cookies" Margin="0,14,0,8" Checked="ChkDeleteLoginData_Changed" Unchecked="ChkDeleteLoginData_Changed"/>
                                        <TextBlock Text="Leave this off to delete only files saved in the custom cache folder. Turn it on only when you also want WebView browsing data, cookies, and login sessions cleared." Style="{StaticResource SettingsMutedTextStyle}" FontSize="12" Margin="0,0,0,14"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnClearSelectedSite" Content="Delete Selected Site Cache" Click="BtnClearSelectedSite_Click" Height="34" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnClearData" Content="Delete All Cache" Click="BtnClearData_Click" Height="34" Foreground="#F14C4C" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Padding="20,14" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Click="BtnClose_Click" Width="86" Height="34" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="Save Settings" Click="BtnClose_Click" Width="122" Height="34" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
