<Window x:Class="imgsaver.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Tutorial" Height="650" Width="800"
        MinHeight="550" MinWidth="700"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🎓" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="User Guide &amp; Tutorial" Foreground="{StaticResource ForegroundBrush}" 
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/> <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="*"/>   <!-- Detail View -->
                </Grid.ColumnDefinitions>

                <!-- Sidebar Nav -->
                <Border Grid.Column="0" Background="{StaticResource ActivityBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ListBox x:Name="LstNav" SelectionChanged="LstNav_SelectionChanged" Padding="8">
                        <ListBoxItem IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" Margin="0,0,8,0"/>
                                    <TextBlock Text="Overview"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" Margin="0,0,8,0"/>
                                    <TextBlock Text="Manual Saving"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Margin="0,0,11,0"/>
                                    <TextBlock Text="Text Shortcuts"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,8,0"/>
                                    <TextBlock Text="Mini Clipboard"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,13,0"/>
                                    <TextBlock Text="Quick Save Mode"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️" Margin="0,0,10,0"/>
                                    <TextBlock Text="Gallery Manager"/>
                                </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎭" Margin="0,0,10,0"/>
                                    <TextBlock Text="Persona Injector"/>
                                </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <!-- Detail View Content -->
                <Grid Grid.Column="1" Margin="24">
                    <!-- Default Section (Overview) -->
                    <ScrollViewer x:Name="ScollContent" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="ContentArea">
                            <!-- Content will be updated dynamically via SelectionChanged -->
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- Content Templates definitions (Internal to simplify file management) -->
    <Window.Resources>
        <!-- 1. Overview -->
        <DataTemplate x:Key="OverviewTemplate">
            <StackPanel>
                <TextBlock Text="Welcome to Image Saver Pro" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="This professional tool is designed to help AI artists and researchers efficiently collect and organize image datasets with full metadata (prompts, descriptions, and more)." TextWrapping="Wrap" Margin="0,0,0,20" Opacity="0.8"/>
                
                <Border Background="{StaticResource SurfaceBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="✨ Core Capabilities" FontWeight="Bold" Margin="0,0,0,8"/>
                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet><TextBlock Text="•" Margin="0,0,8,0"/></BulletDecorator.Bullet>
                            <TextBlock Text="System-wide text expansion for frequently used prompts." TextWrapping="Wrap"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet><TextBlock Text="•" Margin="0,0,8,0"/></BulletDecorator.Bullet>
                            <TextBlock Text="Automatic clipboard monitoring for hands-free saving." TextWrapping="Wrap"/>
                        </BulletDecorator>
                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet><TextBlock Text="•" Margin="0,0,8,0"/></BulletDecorator.Bullet>
                            <TextBlock Text="Integrated gallery with metadata search and calendar navigation." TextWrapping="Wrap"/>
                        </BulletDecorator>
                    </StackPanel>
                </Border>
                
                <TextBlock Text="Select a category from the sidebar to dive deeper into each feature." Foreground="{StaticResource ForegroundMutedBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 2. Manual Saving -->
        <DataTemplate x:Key="ManualSavingTemplate">
            <StackPanel>
                <TextBlock Text="Manual Saving Interface" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="The main window is your control center for manual dataset entry." TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <GroupBox Header="Step-by-Step Guide" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource AccentBrush}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="1. Select Directory" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Text="Choose where your images and text files will be stored permanently." Margin="12,0,0,8" Opacity="0.7"/>
                        
                        <TextBlock Text="2. Paste Image Name (Ctrl+V)" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Text="Paste the filename of the image you just saved. The app will automatically try to find a preview for it." Margin="12,0,0,8" Opacity="0.7"/>
                        
                        <TextBlock Text="3. Enter Prompts" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Text="Type or paste your Positive and Negative prompts into the respective fields." Margin="12,0,0,8" Opacity="0.7"/>
                        
                        <TextBlock Text="4. Save" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Text="Click 'SAVE' to create a .txt file alongside your image. The app clears fields for the next entry." Margin="12,0,0,0" Opacity="0.7"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <!-- 3. Text Shortcuts -->
        <DataTemplate x:Key="ShortcutsTemplate">
            <StackPanel>
                <TextBlock Text="Text Expansion (Snippets)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="The most powerful feature for prompt engineers. Save time by using abbreviations." TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <Border Background="{StaticResource SurfaceBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,16">
                    <TextBlock Text="How it works:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                </Border>
                
                <TextBlock VerticalAlignment="Top" Margin="0,0,0,20">
                    <Run Text="1. Open the SNIPPETS manager." FontWeight="Bold"/>
                    <LineBreak/>
                    <Run Text="2. Create a key (e.g., '/n1') and a value (your long prompt)." Foreground="{StaticResource ForegroundMutedBrush}"/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="3. EXPANSION:" FontWeight="Bold"/>
                    <LineBreak/>
                    <Run Text="Type '/n1' followed by " Foreground="{StaticResource ForegroundMutedBrush}"/>
                    <Run Text="Space" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text=" or " Foreground="{StaticResource ForegroundMutedBrush}"/>
                    <Run Text="Enter" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text=" in ANY application (Chrome, Notepad, Discord). It will instantly replace '/n1' with your full prompt text!" Foreground="{StaticResource ForegroundMutedBrush}"/>
                </TextBlock>

                <TextBlock Text="💡 Tip: You can see a yellow leaf animation when a shortcut expands." Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontStyle="Italic"/>
            </StackPanel>
        </DataTemplate>

        <!-- 4. Mini Clipboard -->
        <DataTemplate x:Key="MiniClipboardTemplate">
            <StackPanel>
                <TextBlock Text="Mini Clipboard Mode" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="A floating overlay that watches your clipboard for images and text." TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="📋 Automatic Tracking" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="When you copy an image, it appears in the preview. When you copy text, it maps to Positive or Negative fields automatically based on content." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🔒 Lock Negative" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Click the lock icon next to the Negative Prompt to keep it persistent across saves. Perfect for reusing the same negative prompt for multiple images." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🚫 Disable Button" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Pause monitoring if you need to copy-paste passwords or private data without the app tracking it." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🏷️ Additional Title" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Enable this to automatically append a fixed phrase (like '@artist' or 'high quality') to every saved image title." Margin="12,0,0,0" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 5. Quick Save Mode -->
        <DataTemplate x:Key="QuickSaveTemplate">
            <StackPanel>
                <TextBlock Text="Mini Quick Save (Silent Mode)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="Designed for rapid-fire image collection without managing text files." TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <Border Background="#1089D185" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Padding="12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Just copy any image from your browser or anywhere in Windows. The app will immediately save it to your selected folder with sequential naming (001.png, 002.png...)." TextWrapping="Wrap" Opacity="0.9"/>
                        <TextBlock Text="No confirmation needed. Absolute speed." FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 6. Gallery Manager -->
        <DataTemplate x:Key="GalleryTemplate">
            <StackPanel>
                <TextBlock Text="Integrated Gallery" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="Explore and manage your collection with ease." TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <StackPanel>
                    <TextBlock Text="📅 Date Filtering" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Use the built-in calendar to see exactly what you saved on specific days." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🔍 Advanced Search" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Search through your images by looking into the keywords inside their associated text prompt files." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🗑️ Bulk Management" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Enable selection mode to delete multiple images and their text files in one click." Margin="12,0,0,0" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <!-- 7. Persona Injector -->
        <DataTemplate x:Key="PersonaInjectorTemplate">
            <StackPanel>
                <TextBlock Text="Persona Injector" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="Craft complex prompts by injecting character personas into predefined templates." TextWrapping="Wrap" Margin="0,0,0,16"/>

                <StackPanel>
                    <TextBlock Text="📌 The [character] Placeholder" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="In your Raw Prompt, use '[character]' where you want the character's details to appear. You can use it multiple times!" Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="🌟 Favorites &amp; Sorting" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Click the star (☆/★) to move your most used characters/templates to the very top for quick access." Margin="12,0,0,12" Opacity="0.8"/>

                    <TextBlock Text="✏️ Direct Editing" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Notice a typo? Click the pencil icon (✏️) in the list to jump straight into the editor for that specific item." Margin="12,0,0,12" Opacity="0.8"/>
                    
                    <TextBlock Text="📋 One-Click Copy" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="Once injected, just click the green output box at the bottom to instantly copy the final prompt to your clipboard." Margin="12,0,0,0" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
</Window>
