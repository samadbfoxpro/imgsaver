<Window x:Class="imgsaver.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:imgsaver"
        Title="Browser" Width="1024" Height="768"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style x:Key="MainBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ThinGreenHorizontalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    Grid.Row="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    VerticalAlignment="Center"
                                                    Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Height="2" Margin="0,0,0,2">
                                <ScrollBar.Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Opacity="0" Focusable="False"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Height="3" Background="#2ECC71" Cursor="Hand">
                                                                <Thumb.Style>
                                                                    <Style TargetType="Thumb">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#58D68D"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Thumb.Style>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.LineRightCommand}" Opacity="0" Focusable="False"/>
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollBar.Style>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Style="{StaticResource MainBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🌐 Dataset Browser" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,12,0"/>

                        <!-- Active Account Profile Badge Button -->
                        <Button x:Name="BtnAccountProfile" Click="BtnAccountProfile_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                Height="22" Padding="8,0" Cursor="Hand" ToolTip="Click to switch or launch Account Profile">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#25FFFFFF" BorderBrush="#2ECC71" BorderThickness="1.2" CornerRadius="11">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock x:Name="TxtProfileIcon" Text="👤" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TxtProfileName" Text="Account 1" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Left Buttons -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnBack_Click" ToolTip="Back">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnForward_Click" ToolTip="Forward">
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnReload_Click" ToolTip="Reload">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnStop" Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnStop_Click" ToolTip="Stop">
                            <TextBlock Text="⏹" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,8,0" Click="BtnNewTab_Click" ToolTip="New Tab">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Right Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="44" Height="36" Margin="8,0,0,0" Click="BtnGo_Click" ToolTip="Go" Padding="0">
                            <TextBlock Text="&#xE751;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddBookmark_Click" ToolTip="Bookmark this page" Padding="0">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClearSiteData" Width="36" Height="36" Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearSiteData_Click" ToolTip="Clear data for this site" Padding="0">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnSplitView" Width="36" Height="36" Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSplitView_Click" ToolTip="Split View / Dual Screen (Ctrl+Shift+S)" Padding="0">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserRecord" Width="36" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Record browser mouse and keyboard" Click="BtnBrowserRecord_Click" Padding="0">
                            <TextBlock x:Name="TxtBrowserRecordIcon" Text="●" Foreground="{StaticResource ForegroundBrush}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserPlayRec" Width="36" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Play browser recording" Click="BtnBrowserPlayRec_Click" Padding="0">
                            <TextBlock Text="▶" Foreground="{StaticResource ForegroundBrush}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnOpenMainMiniClip" Width="36" Height="36" Margin="4,0,0,0" 
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Open Main Mini Clip Window" Click="BtnOpenMainMiniClip_Click" Padding="0">
                            <TextBlock Text="📋" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserSettings" Width="36" Height="36" Margin="4,0,0,0" 
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Browser Settings" Click="BtnBrowserSettings_Click" Padding="0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Modern Omnibox Address Bar (Chrome/Edge Rounded Style) -->
                    <Border Background="#1A1B20" BorderBrush="#2D2F38" BorderThickness="1" CornerRadius="17" Height="34" Margin="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="TxtUrl" Grid.Column="1" Padding="4,0,10,0" VerticalContentAlignment="Center" 
                                     FontSize="13" Foreground="#F1F5F9" Background="Transparent" BorderThickness="0" 
                                     CaretBrush="#00E5FF" KeyDown="TxtUrl_KeyDown" ToolTip="Search or enter web address"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Bookmarks Bar -->
            <Border x:Name="BookmarksBorder" Grid.Row="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="32" SizeChanged="BookmarksBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel x:Name="BookmarksPanel" Orientation="Horizontal" Margin="4,0" ClipToBounds="True" />
                    
                    <Button x:Name="BtnBookmarksOverflow" Grid.Column="1" Width="24" Height="24" Margin="2,0,4,0" Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="BtnBookmarksOverflow_Click" ToolTip="More bookmarks">
                        <TextBlock Text="⋮" Foreground="{StaticResource ForegroundBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Popup x:Name="BookmarksOverflowPopup" PlacementTarget="{Binding ElementName=BtnBookmarksOverflow}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel x:Name="BookmarksOverflowPanel" Orientation="Vertical" Margin="2" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Tabs and WebView -->
            <Grid Grid.Row="3">
                <TabControl x:Name="BrowserTabs" Background="Transparent" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="New Tab"/>
                            <Setter Property="Foreground" Value="#8A8F9D"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="#141418" BorderBrush="#2D2F36" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Margin="2,2,2,0" Padding="8,4" MouseRightButtonUp="TabItem_MouseRightButtonUp" Cursor="Hand">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Close" Click="BtnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Border x:Name="TopAccent" Height="2" VerticalAlignment="Top" Background="#00E5FF" CornerRadius="1,1,0,0" Visibility="Collapsed" Margin="-8,-4,-8,0"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="2,0,6,0"/>
                                                    <Button x:Name="BtnCloseTab" Content="✕" Width="18" Height="18" FontSize="9" Opacity="0"
                                                            Style="{StaticResource TitleBarCloseButtonStyle}" 
                                                            Click="BtnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1C1D24"/>
                                                <Setter TargetName="BtnCloseTab" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1F26"/>
                                                <Setter TargetName="TopAccent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnCloseTab" Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
                <!-- Particle Canvas (Overlay) -->
                <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="False"/>
        <!-- Floating Docked Base Prompt Popup (Renders ON TOP of WebView2 HWND Airspace) -->
        <Popup x:Name="PopInlineBaseCombiner" 
               PlacementTarget="{Binding ElementName=BtnOpenCombinerManager}" 
               Placement="Top" 
               HorizontalOffset="-320" 
               VerticalOffset="-16"
               AllowsTransparency="True" 
               StaysOpen="True" 
               PopupAnimation="Fade">
            <Border x:Name="PnlInlineBaseCombiner" 
                    Width="350" Height="375" 
                    Background="#F8121720" BorderBrush="#00E5FF" BorderThickness="1.2" 
                    CornerRadius="10" Padding="12,12,12,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Short Title, Auto-Base & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Foreground="#00E5FF" Margin="0,0,6,0"/>
                            <TextBlock Text="Base Prompt" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkBrowserAutoBase" Content="Auto Base" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkBrowserAutoBase_Click" ToolTip="دریافت اتوماتیک متن اولیه کپی‌شده هنگام ترکیب"/>
                            <Button Content="✕" Width="20" Height="20" Click="BtnCloseInlineBaseCombiner_Click" Foreground="#AAA" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Summary Status Badge -->
                    <Border Grid.Row="1" Margin="0,0,0,8" Background="#0F172A" CornerRadius="5" BorderBrush="#334155" BorderThickness="1" Padding="8,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBrowserCombinerIcon" Text="🧩" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBrowserCombinerSummary" Text="Checking active combiner options..." FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Text Box Editor -->
                    <TextBox x:Name="TxtBrowserBasePrompt" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="8,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8" TextChanged="TxtBrowserBasePrompt_TextChanged"/>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button x:Name="BtnBrowserCombineAndCopy" Grid.Row="0" Content="⚡ Combine &amp; Copy to Clipboard" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="0" Margin="0,0,0,6" FontWeight="Bold" Click="BtnBrowserCombineAndCopy_Click"/>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📋 Copy Base" Style="{StaticResource SecondaryButtonStyle}" Height="30" FontSize="11" Padding="0" Click="BtnBrowserCopyBaseOnly_Click"/>
                            <Button Grid.Column="2" Content="🗑️ Clear" Style="{StaticResource SecondaryButtonStyle}" Height="30" FontSize="11" Padding="0" Click="BtnBrowserClearBase_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
            </Grid>

            <!-- Smart Prompt Combiner Toolbar -->
            <Border x:Name="CombinerBar" Grid.Row="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="46" Visibility="Collapsed">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master Combiner Toggle -->
                    <ToggleButton x:Name="ChkCombinerEnable" Grid.Column="0" Height="26" Padding="10,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Enable / Disable Smart Prompt Combiner" Checked="ChkCombinerEnable_Changed" Unchecked="ChkCombinerEnable_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="BorderBrush" Value="#454545"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Content" Value="🧩 Combiner OFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1.2"
                                                    CornerRadius="13"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="txtContent" 
                                                               Text="{TemplateBinding Content}" 
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Circle Badge for Active Selection Count -->
                                                    <Border x:Name="bdCountBadge" Width="18" Height="18" CornerRadius="9" Margin="6,0,0,0"
                                                            Background="#454545" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            ToolTip="Number of active items selected for combining">
                                                        <TextBlock x:Name="TxtCombinerActiveCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A382B"/>
                                                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Setter Property="Content" Value="🧩 Combiner ON"/>
                                                    <Setter TargetName="bdCountBadge" Property="Background" Value="#2ECC71"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Active Folder Category Selector -->
                    <ComboBox x:Name="CboCombinerFolders" Grid.Column="1" Height="26" Width="140" Margin="0,0,8,0" 
                              SelectionChanged="CboCombinerFolders_SelectionChanged" ToolTip="Select Prompt Category Folder" MaxDropDownHeight="160">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                              Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                                <Path Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A0A0A0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#333337"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                  Margin="8,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <Popup Name="Popup" Placement="Top" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                    <Grid Name="SubMenu" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,0,6">
                                                        <!-- Glassmorphism Container with original #252526 background, 14px rounded corners and 1px white border -->
                                                        <Border Name="DropDownBorder" Background="#F2252526" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="4">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                                                            </Border.Effect>
                                                        </Border>
                                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                                                      RequestBringIntoView="CombinerFolderScrollViewer_RequestBringIntoView"
                                                                      PreviewMouseWheel="CombinerFolderScrollViewer_PreviewMouseWheel">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <EventSetter Event="RequestBringIntoView" Handler="ComboBoxItem_RequestBringIntoView"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="2,1.5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#332ECC71"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4D2ECC71"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtActiveCount" Grid.Column="1" Text="{Binding DisplayActiveCount}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#2ECC71" 
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Scrollable Container for Snippet Buttons -->
                    <ScrollViewer x:Name="SvcCombinerButtons" Grid.Column="2" Style="{StaticResource ThinGreenHorizontalScrollViewerStyle}" Focusable="False" PreviewMouseWheel="CombinerButtonsScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="PnlCombinerButtons" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Custom Text Input (When Custom Mode is Active) -->
                    <Grid x:Name="PnlCombinerCustomInput" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCombinerCustomInput" Grid.Column="0" Height="28" Background="#1E1E20" Foreground="#2ECC71" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,2" FontSize="12" FontWeight="SemiBold" CaretBrush="#2ECC71" VerticalContentAlignment="Center" TextChanged="TxtCombinerCustomInput_TextChanged" ToolTip="Type custom text to inject/combine automatically"/>
                        <TextBox x:Name="TxtCombinerCustomTitle" Grid.Column="1" Height="28" Background="#1E1E20" Foreground="#3794FF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,2" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" CaretBrush="#3794FF" VerticalContentAlignment="Center" TextChanged="TxtCombinerCustomTitle_TextChanged" ToolTip="Custom Title for Mini Clip (leave empty for default 'متن سفارشی')"/>
                        <Button x:Name="BtnClearCustomInput" Grid.Column="2" Content="✕" Width="24" Height="28" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Padding="0" Click="BtnClearCustomInput_Click" ToolTip="Clear Custom Text &amp; Title"/>
                    </Grid>

                    <!-- Fast Combine Action Buttons: MIX ⚡ | Base 📝 | Settings ⚙ -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#0F2838" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="5" Height="28" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCombBase" Content="⚡ MIX" Height="26" Padding="10,0" FontSize="11" FontWeight="Bold" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Click="BtnCombBase_Click" MouseRightButtonUp="BtnCombBase_MouseRightButtonUp" ToolTip="Combine Base Prompt with active snippets (Right-click to view/edit Base Prompt)"/>
                                <Border Width="1" Background="#00E5FF" Opacity="0.4" Margin="0,3"/>
                                <Button x:Name="BtnViewBasePrompt" Content="📝" Height="26" Width="28" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Padding="0" FontSize="11" Click="BtnViewBasePrompt_Click" ToolTip="View &amp; Edit Base Prompt Text"/>
                            </StackPanel>
                        </Border>

                        <!-- Hidden Placement Rule Badge (Rule is configured inside Manager) -->
                        <Button x:Name="BtnCombinerRuleBadge" Visibility="Collapsed" Click="BtnCombinerRuleBadge_Click"/>

                        <!-- Manager Button (Gear Icon Only) -->
                        <Button x:Name="BtnOpenCombinerManager" Content="⚙" Style="{StaticResource SecondaryButtonStyle}" Height="28" Width="30" Padding="0" FontSize="14" FontWeight="Bold" Margin="6,0,0,0" Click="BtnOpenCombinerManager_Click" ToolTip="Open Prompt Combiner Manager"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Network Status Bar -->
            <Border x:Name="StatusOverlay" Grid.Row="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="36" Opacity="0" Visibility="Collapsed">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusUrl" Foreground="{StaticResource ForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.75" MaxWidth="500"/>
                        <Button x:Name="BtnSkipRequest" Content="✕ Skip" Style="{StaticResource SecondaryButtonStyle}" Height="22" Padding="8,0" FontSize="10" Margin="10,0,0,0" Click="BtnSkipRequest_Click" ToolTip="Skip and block this request address" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCacheUsage" Grid.Column="1" Foreground="#FF4CAF50" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtDownloadUsage" Grid.Column="2" Foreground="#FFF44336" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtTotalUsage" Grid.Column="3" Foreground="#FF64B5F6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
