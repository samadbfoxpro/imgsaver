<Window x:Class="imgsaver.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:imgsaver"
        Title="Browser" Width="1024" Height="768"
        MinHeight="500" MinWidth="700"
        Background="#18191C"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style x:Key="MainBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ThinGreenHorizontalScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    Grid.Row="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    VerticalAlignment="Center"
                                                    Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Height="2" Margin="0,0,0,2">
                                <ScrollBar.Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Opacity="0" Focusable="False"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Height="3" Background="#2ECC71" Cursor="Hand">
                                                                <Thumb.Style>
                                                                    <Style TargetType="Thumb">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#58D68D"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Thumb.Style>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.LineRightCommand}" Opacity="0" Focusable="False"/>
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollBar.Style>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Style="{StaticResource MainBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: TITLE BAR -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#18191C" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Profile Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Globe Icon -->
                        <Path Data="{StaticResource IconGlobe}" Fill="#949BA4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Dataset Browser" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,12,0"/>

                        <!-- Active Account Profile Badge Button -->
                        <Button x:Name="BtnAccountProfile"
                                Style="{StaticResource ProfileAvatarBtnStyle}"
                                Click="BtnAccountProfile_Click"
                                ToolTip="حساب کاربری و تغییر پروفایل"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="UserProfileAvatarBorder" Width="22" Height="22" CornerRadius="11" Background="#3B82F6" Margin="0,0,6,0">
                                    <Path x:Name="UserProfileAvatarPath" Data="{StaticResource IconUser}" Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtProfileName" Text="Account 1" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center Network Speed Monitor Matching Mini Clipboard Style -->
                    <Border Grid.Column="1" Background="#060A14" CornerRadius="6" BorderBrush="#141C30" BorderThickness="1" 
                            Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↓" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock x:Name="TxtDownloadSpeed" Text="0.0 KB" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <TextBlock Text="↑" FontSize="10" Foreground="#F43F5E" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock x:Name="TxtUploadSpeed" Text="0.0 KB" FontSize="10" FontWeight="SemiBold" Foreground="#F43F5E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Caption Buttons (Lock, Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnAppLock" Style="{StaticResource CaptionBtnStyle}" Click="BtnAppLock_Click" ToolTip="قفل برنامه (Ctrl + L)" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconLock}" Fill="#F87171" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="کوچک کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconMinimize}" Fill="#949BA4" Width="10" Height="2" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="بزرگ کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIconPath" Data="{StaticResource IconMaximize}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="بستن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconClose}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: NAVIGATION & OMNIBOX BAR -->
            <Border Grid.Row="1" Background="#2B2D30" BorderBrush="#36393E" BorderThickness="0,0,0,1" VerticalAlignment="Stretch">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Navigation Buttons -->
                        <ColumnDefinition Width="*"/>    <!-- Omnibox Address Bar -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Action Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Navigation Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="BtnBack" Style="{StaticResource NavIconButton}" Click="BtnBack_Click" ToolTip="بازگشت (Alt+Left)">
                            <Path Data="{StaticResource IconBack}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="BtnForward" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnForward_Click" ToolTip="جلو (Alt+Right)">
                            <Path Data="{StaticResource IconForward}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="BtnReload" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnReload_Click" ToolTip="تازه‌سازی (F5)">
                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="BtnStop" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnStop_Click" ToolTip="توقف">
                            <Path Data="{StaticResource IconStop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <Button Width="34" Height="34" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnNewTab_Click" ToolTip="تب جدید (Ctrl+T)">
                            <Path Data="{StaticResource IconPlus}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Modern Omnibox Address Bar (Webino Style) -->
                    <Border Grid.Column="1"
                            Background="#25272B"
                            BorderBrush="#36393E"
                            BorderThickness="1"
                            CornerRadius="18"
                            Height="34"
                            Margin="4,0"
                            VerticalAlignment="Center">
                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Security Lock -->
                                <ColumnDefinition Width="*"/>    <!-- Text Input -->
                                <ColumnDefinition Width="Auto"/> <!-- Bookmark Star -->
                            </Grid.ColumnDefinitions>

                            <!-- Security Lock Icon -->
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconLock}"
                                  Fill="#10B981"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  ToolTip="اتصال امن (HTTPS)"/>

                            <!-- Address Input -->
                            <TextBox x:Name="TxtUrl"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F2F3F5"
                                     CaretBrush="#00E5FF"
                                     FontSize="13"
                                     Padding="4,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtUrl_KeyDown"
                                     ToolTip="Search or enter web address">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#F2F3F5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="CaretBrush" Value="#00E5FF"/>
                                        <Setter Property="SelectionBrush" Value="#3B82F6"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Hidden"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Bookmark Current Page Star Button -->
                            <Button x:Name="BtnAddBookmark"
                                    Grid.Column="2"
                                    Style="{StaticResource NavIconButton}"
                                    Width="28" Height="28"
                                    Click="BtnAddBookmark_Click"
                                    ToolTip="افزودن به بوک‌مارک‌ها (Ctrl+D)">
                                <Path Data="{StaticResource IconStarOutline}"
                                      Fill="#949BA4"
                                      Width="14" Height="14"
                                      Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right Action Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Button x:Name="BtnGo" Style="{StaticResource NavIconButton}" Click="BtnGo_Click" ToolTip="برو">
                            <Path Data="{StaticResource IconChevronRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <!-- Quick Toggle for Auto Quick Paste & Action (visible when feature is enabled in Settings) -->
                        <Button x:Name="BtnToggleAutoQuickPaste"
                                Style="{StaticResource NavIconButton}"
                                Margin="3,0,0,0"
                                Click="BtnToggleAutoQuickPaste_Click"
                                ToolTip="پیست و کلیک خودکار: فعال (برای توقف موقت کلیک کنید)"
                                Visibility="Collapsed">
                            <Grid>
                                <Path x:Name="IconAutoQuickPasteActive" Data="{StaticResource IconFlash}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform"/>
                                <Path x:Name="IconAutoQuickPastePaused" Data="{StaticResource IconFlashOff}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnSplitView" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnSplitView_Click" ToolTip="نمای دوگانه (Ctrl+Shift+S)">
                            <Path Data="{StaticResource IconGallery}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnBrowserRecord" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnBrowserRecord_Click" ToolTip="ضبط مرورگر">
                            <TextBlock x:Name="TxtBrowserRecordIcon" Text="●" Foreground="{StaticResource ForegroundBrush}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserPlayRec" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnBrowserPlayRec_Click" ToolTip="پخش ضبط">
                            <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnOpenMainMiniClip" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnOpenMainMiniClip_Click" ToolTip="کلیپ‌بورد اصلی">
                            <Path Data="{StaticResource IconCopy}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnBrowserSettings" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnBrowserSettings_Click" ToolTip="تنظیمات">
                            <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnBrowserLock" Style="{StaticResource NavIconButton}" Margin="3,0,0,0" Click="BtnAppLock_Click" ToolTip="قفل سریع برنامه (Ctrl+L)">
                            <Path Data="{StaticResource IconLock}" Fill="#F87171" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2: BOOKMARKS BAR -->
            <Border x:Name="BookmarksBorder" Grid.Row="2" Background="#2B2D30" BorderBrush="#36393E" BorderThickness="0,0,0,1" Height="32" SizeChanged="BookmarksBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel x:Name="BookmarksPanel" Orientation="Horizontal" Margin="8,0" ClipToBounds="True" />
                    
                    <Button x:Name="BtnBookmarksOverflow" Grid.Column="1" Width="24" Height="24" Margin="2,0,4,0" Padding="0"
                            Style="{StaticResource NavIconButton}" Visibility="Collapsed" Click="BtnBookmarksOverflow_Click" ToolTip="بوک‌مارک‌های بیشتر">
                        <TextBlock Text="⋮" Foreground="#F2F3F5" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Popup x:Name="BookmarksOverflowPopup" PlacementTarget="{Binding ElementName=BtnBookmarksOverflow}" Placement="Bottom" StaysOpen="False">
                        <Border Background="#25272B" BorderBrush="#36393E" BorderThickness="1" CornerRadius="6">
                            <StackPanel x:Name="BookmarksOverflowPanel" Orientation="Vertical" Margin="2" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ROW 3: TABS & WEBVIEW -->
            <Grid Grid.Row="3" Background="#121316">
                <TabControl x:Name="BrowserTabs" Background="#121316" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="New Tab"/>
                            <Setter Property="Foreground" Value="#949BA4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder"
                                                Height="34"
                                                MinWidth="120"
                                                MaxWidth="200"
                                                Margin="2,4,2,0"
                                                CornerRadius="8,8,0,0"
                                                Cursor="Hand"
                                                MouseRightButtonUp="TabItem_MouseRightButtonUp">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="#25272B" Foreground="#F2F3F5">
                                                    <MenuItem Header="Close Tab" Click="BtnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid Margin="10,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Globe Icon -->
                                                    <ColumnDefinition Width="*"/>    <!-- Title -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Close Button -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Globe Icon -->
                                                <Path x:Name="GlobeIcon" Grid.Column="0"
                                                      Data="{StaticResource IconGlobe}"
                                                      Fill="{TemplateBinding Foreground}"
                                                      Width="13" Height="13"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>

                                                <!-- Tab Title -->
                                                <ContentPresenter Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  TextElement.FontSize="12"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  Margin="0,0,6,0"/>

                                                <!-- Close Tab Button -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource TabCloseBtnStyle}"
                                                        Click="BtnCloseTab_Click"
                                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                        ToolTip="بستن تب (Ctrl+W)"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#25272B"/>
                                                <Setter Property="Foreground" Value="#F2F3F5"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#2B2D30"/>
                                                <Setter Property="Foreground" Value="#F2F3F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
                <!-- Particle Canvas (Overlay) -->
                <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="False"/>
        <!-- Floating Docked Base Prompt Popup (Renders ON TOP of WebView2 HWND Airspace) -->
        <Popup x:Name="PopInlineBaseCombiner" 
               PlacementTarget="{Binding ElementName=BtnOpenCombinerManager}" 
               Placement="Top" 
               HorizontalOffset="-320" 
               VerticalOffset="-16"
               AllowsTransparency="True" 
               StaysOpen="True" 
               PopupAnimation="Fade">
            <Border x:Name="PnlInlineBaseCombiner" 
                    Width="350" Height="375" 
                    Background="#F8121720" BorderBrush="#00E5FF" BorderThickness="1.2" 
                    CornerRadius="10" Padding="12,12,12,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Short Title, Auto-Base & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFlash}" Fill="#00E5FF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Base Prompt" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkBrowserAutoBase" Content="Auto Base" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkBrowserAutoBase_Click" ToolTip="دریافت اتوماتیک متن اولیه کپی‌شده هنگام ترکیب"/>
                            <Button Style="{StaticResource TabCloseBtnStyle}" Width="20" Height="20" Click="BtnCloseInlineBaseCombiner_Click" ToolTip="بستن"/>
                        </StackPanel>
                    </Grid>

                    <!-- Summary Status Badge -->
                    <Border Grid.Row="1" Margin="0,0,0,8" Background="#0F172A" CornerRadius="5" BorderBrush="#334155" BorderThickness="1" Padding="8,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="IcoBrowserCombinerStatus" Data="{StaticResource IconCombiner}" Fill="#00E5FF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBrowserCombinerSummary" Text="Checking active combiner options..." FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Text Box Editor -->
                    <TextBox x:Name="TxtBrowserBasePrompt" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="8,6" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8" TextChanged="TxtBrowserBasePrompt_TextChanged"/>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button x:Name="BtnBrowserCombineAndCopy" Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="0" Margin="0,0,0,6" FontWeight="Bold" Click="BtnBrowserCombineAndCopy_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFlash}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Combine &amp; Copy to Clipboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Height="30" FontSize="11" Padding="0" Click="BtnBrowserCopyBaseOnly_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy Base" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" FontSize="11" Padding="0" Click="BtnBrowserClearBase_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="{StaticResource ForegroundBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
            </Grid>

            <!-- Smart Prompt Combiner Toolbar -->
            <Border x:Name="CombinerBar" Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="46" Visibility="Collapsed">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master Combiner Toggle -->
                    <ToggleButton x:Name="ChkCombinerEnable" Grid.Column="0" Height="26" Padding="10,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Enable / Disable Smart Prompt Combiner" Checked="ChkCombinerEnable_Changed" Unchecked="ChkCombinerEnable_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="BorderBrush" Value="#454545"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1.2"
                                                    CornerRadius="13"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path x:Name="icoCombiner" Data="{StaticResource IconCombiner}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtContent" 
                                                               Text="Combiner OFF" 
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Circle Badge for Active Selection Count -->
                                                    <Border x:Name="bdCountBadge" Width="18" Height="18" CornerRadius="9" Margin="6,0,0,0"
                                                            Background="#454545" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            ToolTip="Number of active items selected for combining">
                                                        <TextBlock x:Name="TxtCombinerActiveCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A382B"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#2ECC71"/>
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Setter TargetName="txtContent" Property="Text" Value="Combiner ON"/>
                                                    <Setter TargetName="icoCombiner" Property="Fill" Value="#2ECC71"/>
                                                    <Setter TargetName="bdCountBadge" Property="Background" Value="#2ECC71"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Active Folder Category Selector -->
                    <ComboBox x:Name="CboCombinerFolders" Grid.Column="1" Height="26" Width="140" Margin="0,0,8,0" 
                              SelectionChanged="CboCombinerFolders_SelectionChanged" ToolTip="Select Prompt Category Folder" MaxDropDownHeight="160">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                              Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                                <Path Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A0A0A0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#333337"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                  Margin="8,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <Popup Name="Popup" Placement="Top" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                    <Grid Name="SubMenu" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,0,6">
                                                        <!-- Glassmorphism Container with original #252526 background, 14px rounded corners and 1px white border -->
                                                        <Border Name="DropDownBorder" Background="#F2252526" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="4">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                                                            </Border.Effect>
                                                        </Border>
                                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                                                      RequestBringIntoView="CombinerFolderScrollViewer_RequestBringIntoView"
                                                                      PreviewMouseWheel="CombinerFolderScrollViewer_PreviewMouseWheel">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <EventSetter Event="RequestBringIntoView" Handler="ComboBoxItem_RequestBringIntoView"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="2,1.5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#332ECC71"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#4D2ECC71"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtActiveCount" Grid.Column="1" Text="{Binding DisplayActiveCount}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#2ECC71" 
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Scrollable Container for Snippet Buttons -->
                    <ScrollViewer x:Name="SvcCombinerButtons" Grid.Column="2" Style="{StaticResource ThinGreenHorizontalScrollViewerStyle}" Focusable="False" PreviewMouseWheel="CombinerButtonsScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="PnlCombinerButtons" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Custom Text Input (When Custom Mode is Active) -->
                    <Grid x:Name="PnlCombinerCustomInput" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCombinerCustomInput" Grid.Column="0" Height="28" Background="#1E1E20" Foreground="#2ECC71" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,2" FontSize="12" FontWeight="SemiBold" CaretBrush="#2ECC71" VerticalContentAlignment="Center" TextChanged="TxtCombinerCustomInput_TextChanged" ToolTip="Type custom text to inject/combine automatically"/>
                        <TextBox x:Name="TxtCombinerCustomTitle" Grid.Column="1" Height="28" Background="#1E1E20" Foreground="#3794FF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,2" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" CaretBrush="#3794FF" VerticalContentAlignment="Center" TextChanged="TxtCombinerCustomTitle_TextChanged" ToolTip="Custom Title for Mini Clip (leave empty for default 'متن سفارشی')"/>
                        <Button x:Name="BtnClearCustomInput" Grid.Column="2" Content="✕" Width="24" Height="28" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Padding="0" Click="BtnClearCustomInput_Click" ToolTip="Clear Custom Text &amp; Title"/>
                    </Grid>

                    <!-- Fast Combine Action Buttons: MIX | Base | Settings -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#0F2838" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Height="28" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCombBase" Height="26" Padding="8,0" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Click="BtnCombBase_Click" MouseRightButtonUp="BtnCombBase_MouseRightButtonUp" ToolTip="Combine Base Prompt with active snippets (Right-click to view/edit Base Prompt)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFlash}" Fill="#00E5FF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MIX" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Background="#00E5FF" Opacity="0.3" Margin="0,4"/>
                                <Button x:Name="BtnViewBasePrompt" Height="26" Width="28" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Padding="0" Click="BtnViewBasePrompt_Click" ToolTip="View &amp; Edit Base Prompt Text">
                                    <Path Data="{StaticResource IconEdit}" Fill="#00E5FF" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Hidden Placement Rule Badge (Rule is configured inside Manager) -->
                        <Button x:Name="BtnCombinerRuleBadge" Visibility="Collapsed" Click="BtnCombinerRuleBadge_Click"/>

                        <!-- Manager Button (Gear Vector Icon) -->
                        <Button x:Name="BtnOpenCombinerManager" Style="{StaticResource SecondaryButtonStyle}" Height="28" Width="30" Padding="0" Margin="6,0,0,0" Click="BtnOpenCombinerManager_Click" ToolTip="Open Prompt Combiner Manager">
                            <Path Data="{StaticResource IconSettings}" Fill="{StaticResource ForegroundBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Network Status Bar (Compact Sleek Persian Metrics) -->
            <Border x:Name="StatusOverlay" Grid.Row="5" Background="#131417" BorderBrush="#22252B" BorderThickness="0,1,0,0" Height="26" Opacity="0" Visibility="Collapsed">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: URL / Activity Status & Skip Button -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="5" Height="5" CornerRadius="2.5" Background="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusUrl" Foreground="#94A3B8" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="500"/>
                        <Button x:Name="BtnSkipRequest" Style="{StaticResource SecondaryButtonStyle}" Height="18" Padding="6,0" Margin="8,0,0,0" Click="BtnSkipRequest_Click" ToolTip="رد کردن و مسدودسازی موقت این درخواست" Cursor="Hand" Background="#1A1C22" BorderBrush="#2A2D36">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="7" Height="7" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="رد کردن" FontSize="9.5" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Ultra-Compact Metrics Badges (Cache, Download, Total) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cache Saved Badge -->
                        <Border Background="#0C2417" BorderBrush="#14532D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" ToolTip="حجم داده‌های خوانده شده از کش محلی">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Fill="#4ADE80" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="کش: " Foreground="#86EFAC" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCacheUsage" Foreground="#4ADE80" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Usage Badge -->
                        <Border Background="#28180E" BorderBrush="#7C2D12" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" ToolTip="حجم داده‌های دانلود شده از شبکه">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDownload}" Fill="#FB923C" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="دانلود: " Foreground="#FDBA74" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDownloadUsage" Foreground="#FB923C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Tab Traffic Badge -->
                        <Border Background="#0E1D2E" BorderBrush="#075985" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" ToolTip="مجموع کل ترافیک این تب">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGlobe}" Fill="#38BDF8" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="کل: " Foreground="#7DD3FC" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalUsage" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
