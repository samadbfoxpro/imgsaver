<Window x:Class="imgsaver.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:imgsaver"
        Title="Browser" Width="1024" Height="768"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style x:Key="MainBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Style="{StaticResource MainBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🌐 Dataset Browser" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,12,0"/>

                        <!-- Active Account Profile Badge Button -->
                        <Button x:Name="BtnAccountProfile" Click="BtnAccountProfile_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                Height="22" Padding="8,0" Cursor="Hand" ToolTip="Click to switch or launch Account Profile">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#25FFFFFF" BorderBrush="#2ECC71" BorderThickness="1.2" CornerRadius="11">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock x:Name="TxtProfileIcon" Text="👤" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TxtProfileName" Text="Account 1" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Left Buttons -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnBack_Click" ToolTip="Back">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnForward_Click" ToolTip="Forward">
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnReload_Click" ToolTip="Reload">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnStop" Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,4,0" Click="BtnStop_Click" ToolTip="Stop">
                            <TextBlock Text="⏹" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,8,0" Click="BtnNewTab_Click" ToolTip="New Tab">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Right Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="44" Height="36" Margin="8,0,0,0" Click="BtnGo_Click" ToolTip="Go" Padding="0">
                            <TextBlock Text="&#xE751;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="36" Height="36" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddBookmark_Click" ToolTip="Bookmark this page" Padding="0">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClearSiteData" Width="36" Height="36" Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearSiteData_Click" ToolTip="Clear data for this site" Padding="0">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnSplitView" Width="36" Height="36" Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSplitView_Click" ToolTip="Split View / Dual Screen (Ctrl+Shift+S)" Padding="0">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserRecord" Width="36" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Record browser mouse and keyboard" Click="BtnBrowserRecord_Click" Padding="0">
                            <TextBlock x:Name="TxtBrowserRecordIcon" Text="●" Foreground="{StaticResource ForegroundBrush}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserPlayRec" Width="36" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Play browser recording" Click="BtnBrowserPlayRec_Click" Padding="0">
                            <TextBlock Text="▶" Foreground="{StaticResource ForegroundBrush}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnOpenMainMiniClip" Width="36" Height="36" Margin="4,0,0,0" 
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Open Main Mini Clip Window" Click="BtnOpenMainMiniClip_Click" Padding="0">
                            <TextBlock Text="📋" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnBrowserSettings" Width="36" Height="36" Margin="4,0,0,0" 
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Browser Settings" Click="BtnBrowserSettings_Click" Padding="0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Address Bar (Fills remaining space) -->
                    <TextBox x:Name="TxtUrl" Height="36" Padding="10,0" VerticalContentAlignment="Center" 
                             FontSize="14" KeyDown="TxtUrl_KeyDown" 
                             Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}"/>
                </DockPanel>
            </Border>

            <!-- Bookmarks Bar -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="32">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BookmarksPanel" Orientation="Horizontal" Margin="4,0"/>
                </ScrollViewer>
            </Border>

            <!-- Tabs and WebView -->
            <Grid Grid.Row="3">
                <TabControl x:Name="BrowserTabs" Background="Transparent" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Header" Value="New Tab"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="2,0"
                                                MouseRightButtonUp="TabItem_MouseRightButtonUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Close" Click="BtnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                <Button Content="✕" Margin="8,0,0,0" Width="16" Height="16" FontSize="10" 
                                                        Style="{StaticResource TitleBarCloseButtonStyle}" 
                                                        Click="BtnCloseTab_Click" Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource InputBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
                <!-- Particle Canvas (Overlay) -->
                <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="False"/>
            </Grid>

            <!-- Smart Prompt Combiner Toolbar -->
            <Border x:Name="CombinerBar" Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="40" Visibility="Collapsed">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master Combiner Toggle -->
                    <ToggleButton x:Name="ChkCombinerEnable" Grid.Column="0" Height="26" Padding="10,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Enable / Disable Smart Prompt Combiner" Checked="ChkCombinerEnable_Changed" Unchecked="ChkCombinerEnable_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="BorderBrush" Value="#454545"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Content" Value="🧩 Combiner OFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1.2"
                                                    CornerRadius="13"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="txtContent" 
                                                           Text="{TemplateBinding Content}" 
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A382B"/>
                                                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Setter Property="Content" Value="🧩 Combiner ON"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Category / Folder Dropdown -->
                    <ComboBox x:Name="CboCombinerFolders" Grid.Column="1" Height="26" Width="140" Margin="0,0,8,0" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="CboCombinerFolders_SelectionChanged"/>

                    <!-- Snippet Buttons ScrollViewer & WrapPanel -->
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <StackPanel x:Name="PnlCombinerButtons" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Placement Rule Badge -->
                    <Button x:Name="BtnCombinerRuleBadge" Grid.Column="3" Content="📍 After Comma #1" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" Margin="8,0" FontSize="11" Click="BtnCombinerRuleBadge_Click" ToolTip="Click to cycle placement rule"/>

                    <!-- Manager Button -->
                    <Button x:Name="BtnOpenCombinerManager" Grid.Column="4" Content="⚙ Manager" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="10,0" FontSize="11" Click="BtnOpenCombinerManager_Click" ToolTip="Open Prompt Combiner Manager"/>
                </Grid>
            </Border>

            <!-- Embedded MiniClip Bar -->
            <local:BrowserMiniClipControl x:Name="EmbeddedMiniClip" Grid.Row="5" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"/>

            <!-- Network Status Bar -->
            <Border x:Name="StatusOverlay" Grid.Row="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="36" Opacity="0" Visibility="Collapsed">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusUrl" Foreground="{StaticResource ForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.75" MaxWidth="500"/>
                        <Button x:Name="BtnSkipRequest" Content="✕ Skip" Style="{StaticResource SecondaryButtonStyle}" Height="22" Padding="8,0" FontSize="10" Margin="10,0,0,0" Click="BtnSkipRequest_Click" ToolTip="Skip and block this request address" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCacheUsage" Grid.Column="1" Foreground="#FF4CAF50" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtDownloadUsage" Grid.Column="2" Foreground="#FFF44336" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtTotalUsage" Grid.Column="3" Foreground="#FF64B5F6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
