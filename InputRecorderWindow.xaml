<Window x:Class="imgsaver.InputRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Recorder" Height="430" Width="540" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="12" Padding="16" BorderThickness="1" 
            BorderBrush="{DynamicResource BorderBrush}"
            Background="#18181A">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Slot / Mode Bar -->
                <RowDefinition Height="*"/>    <!-- 2: Main Content / Panels -->
                <RowDefinition Height="Auto"/> <!-- 3: Footer Status & Actions -->
            </Grid.RowDefinitions>

            <!-- 0: Header & TitleBar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#26262B" CornerRadius="6" Margin="0,0,8,0">
                        <TextBlock Text="⏺" FontSize="14" Foreground="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Macro &amp; Input Recorder" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live Status Chip -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#222226" BorderBrush="#333338" BorderThickness="1" CornerRadius="12" Padding="10,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RecIndicator" Width="8" Height="8" Fill="#FF4444" Opacity="0.0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Idle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{DynamicResource TitleBarCloseButtonStyle}" Width="28" Height="28" Click="BtnClose_Click" ToolTip="Close Recorder">
                    <TextBlock Text="✕" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 1: Slot Selection & Mode Bar -->
            <Border Grid.Row="1" Background="#202024" BorderBrush="#2D2D33" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Slot Selector -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Target Slot:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="RadSlot1" Content="Slot 1" IsChecked="True" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,12,0" Checked="RadSlot_Changed"/>
                        <RadioButton x:Name="RadSlot2" Content="Slot 2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,8,0" Checked="RadSlot_Changed"/>
                        
                        <Border Background="#121214" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Events: " FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEventCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#3794FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Options: Loop & Sequential -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkLoop" Content="🔁 Infinite Loop" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Keep repeating playback until stopped or ESC is pressed"/>
                        <CheckBox x:Name="ChkSequential" Content="Sequential (1 ➔ 2)" FontSize="11" FontWeight="SemiBold" Foreground="#3498DB" VerticalAlignment="Center" Checked="ChkSequential_Changed" Unchecked="ChkSequential_Changed" ToolTip="Alternates between Slot 1 and Slot 2 automatically on playback"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2: Main Panels: Record Card + Playback Card -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Recording Actions Card -->
                <Border Grid.Column="0" Background="#1D1D21" BorderBrush="#2B2B30" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🔴 Recording Controls" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,10"/>

                        <!-- Primary Rec / Stop Buttons -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="BtnStart" Grid.Row="0" Height="36" Click="BtnStart_Click" Style="{DynamicResource PrimaryButtonStyle}" Background="#E53935" BorderBrush="#FF5252" ToolTip="Start recording mouse &amp; keyboard actions into selected slot">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⏺" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Record Slot" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnStop" Grid.Row="2" Height="34" Click="BtnStop_Click" IsEnabled="False" Style="{DynamicResource SecondaryButtonStyle}" ToolTip="Stop and save recorded actions">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="■" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FFD400"/>
                                    <TextBlock Text="Stop Recording" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Slot File Operations -->
                        <Grid Grid.Row="2" Height="30" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSave" Grid.Column="0" Content="💾 Save File" Height="30" Padding="4,0" Click="BtnSave_Click" IsEnabled="False" Style="{DynamicResource SecondaryButtonStyle}" FontSize="11" ToolTip="Save current slot to a JSON file"/>
                            <Button x:Name="BtnLoad" Grid.Column="2" Content="📂 Load File" Height="30" Padding="4,0" Click="BtnLoad_Click" Style="{DynamicResource SecondaryButtonStyle}" FontSize="11" ToolTip="Load a saved JSON recording file into slot"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Column: Playback Actions Card -->
                <Border Grid.Column="2" Background="#1D1D21" BorderBrush="#2B2B30" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="⚡ Playback Controls" FontSize="11" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,10"/>

                        <!-- Primary Play / Stop Buttons -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="BtnPlay" Grid.Row="0" Height="36" Click="BtnPlay_Click" IsEnabled="False" Style="{DynamicResource PrimaryButtonStyle}" Background="#1E824C" BorderBrush="#2ECC71" ToolTip="Play the recorded actions in slot">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Play Macro" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnStopPlay" Grid.Row="2" Height="34" Click="BtnStopPlay_Click" IsEnabled="False" Style="{DynamicResource SecondaryButtonStyle}" ToolTip="Stop active playback (or press ESC)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⏹" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop Playback" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Speed Slider & Loop Toggle -->
                        <StackPanel Grid.Row="2" Height="30" Margin="0,10,0,0" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Speed:" FontSize="10" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="SldSpeed" Grid.Column="1" Minimum="0.2" Maximum="3" Value="1" Margin="8,0" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSpeed" Grid.Column="2" Text="1.0x" FontSize="10" FontWeight="Bold" Foreground="#2ECC71" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3: Help / Tip Banner -->
            <Border Grid.Row="3" Background="#141416" BorderBrush="#242428" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💡 Tip:" FontSize="10" FontWeight="Bold" Foreground="#3794FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Press ESC at any time to instantly abort loop or playback." FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>