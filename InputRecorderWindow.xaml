<Window x:Class="imgsaver.InputRecorderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Input Recorder" Height="380" Width="520" WindowStartupLocation="CenterOwner"
 Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Border CornerRadius="10" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
	Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="⏺ Input Recorder" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Ellipse x:Name="RecIndicator" Width="12" Height="12" Fill="#FF4444" Opacity="0.0" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Idle" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="6,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Slot Selection -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Target Slot:" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="RadSlot1" Content="Slot 1" IsChecked="True" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,15,0" Checked="RadSlot_Changed"/>
                <RadioButton x:Name="RadSlot2" Content="Slot 2" Foreground="{DynamicResource ForegroundBrush}" Checked="RadSlot_Changed"/>
                <CheckBox x:Name="ChkSequential" Content="Sequential Play (1-2-1-2)" Margin="20,0,0,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Checked="ChkSequential_Changed" Unchecked="ChkSequential_Changed"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,12">
                    <Button x:Name="BtnStart" Content="Start Rec" Width="100" Height="44" Click="BtnStart_Click"
					Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"/>
                    <Button x:Name="BtnStop" Content="Stop Rec" Width="100" Height="44" Click="BtnStop_Click" IsEnabled="False"
					Background="#2E2E2E" Foreground="White" Margin="5,0"/>
                    <Button x:Name="BtnSave" Content="Save Slot" Width="100" Height="44" Click="BtnSave_Click" IsEnabled="False"
					Background="#3A3A3A" Foreground="White"/>
                    <Button x:Name="BtnLoad" Content="Load Slot" Width="100" Height="44" Click="BtnLoad_Click" Margin="5,0"
					Background="#3A3A3A" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="BtnPlay" Content="Play" Width="120" Height="40" Click="BtnPlay_Click" IsEnabled="False"
					Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"/>
                    <Button x:Name="BtnStopPlay" Content="Stop" Width="120" Height="40" Click="BtnStopPlay_Click" IsEnabled="False"
					Margin="8,0" Background="#2E2E2E" Foreground="White"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Speed:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,6,0"/>
                        <Slider x:Name="SldSpeed" Minimum="0.2" Maximum="3" Value="1" Width="120" TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                        <TextBlock x:Name="TxtSpeed" Text="1.0x" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <CheckBox x:Name="ChkLoop" Content="Loop playback" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    <TextBlock Text="Events in Slot:" Margin="18,0,0,0" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtEventCount" Text="0" Margin="6,0" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="Select a Slot to Record/Load. If 'Sequential Play' is on, clicking Play will alternate between Slot 1 and Slot 2 automatically." TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close" Width="88" Height="34" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>