<Window x:Class="imgsaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Saver Pro" Width="600"
        SizeToContent="Height"
        MinHeight="400" MinWidth="550"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="8" BorderThickness="1" BorderBrush="#333" Margin="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E1E" Offset="0"/>
                <GradientStop Color="#121212" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="📷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Image Saver Pro" Foreground="{StaticResource ForegroundBrush}" 
                                   FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>

                        <!-- Version Box in Title Bar -->
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersion" Text="v1.0.0" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="□" Click="BtnMaximize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Attractive Header Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="IMAGE SAVER PRO" FontSize="34" FontWeight="Black" 
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Lbl_Suite}" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8" Margin="4,4">
                                            <Grid>
                                                <Border x:Name="HoverLayer" Background="Black" Opacity="0" CornerRadius="7"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontSize="20" 
                                                               Foreground="{TemplateBinding Foreground}"
                                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="9" FontWeight="SemiBold" 
                                                               Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Btn_MiniClip}" Tag="📋" Click="BtnMiniClipboard_Click" Style="{StaticResource NavButtonStyle}" Background="#1B5E20" Foreground="White"/>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_ExtraFloat}" Tag="🧩" Click="BtnExtraFloat_Click" Style="{StaticResource NavButtonStyle}" Background="#0E7A6E" Foreground="White"/>
                        <Button Grid.Column="2" Content="{DynamicResource Btn_Persona}" Tag="🎭" Click="BtnPersona_Click" Style="{StaticResource NavButtonStyle}" Background="#4A148C" Foreground="White"/>
                    </Grid>

                    <Button Grid.Row="1" Content="{DynamicResource Btn_Gallery}" Tag="🖼️" Click="BtnGallery_Click" Style="{StaticResource NavButtonStyle}" Margin="0,4"/>

                    <UniformGrid Grid.Row="2" Columns="4">
                        <Button Content="{DynamicResource Btn_ClipSaver}" Tag="⚡" Click="BtnQuickClipboard_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_Snippets}" Tag="📜" Click="BtnSnippets_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_QuickSave}" Tag="⚡📸" Click="BtnMiniQuickSave_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_Remote}" x:Name="BtnRemote" Tag="📱" Click="BtnRemote_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_CloudLink}" Tag="☁️" Click="BtnCloudLink_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_Archive}" Tag="📦" Click="BtnArchive_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}"/>
                        <Button Content="{DynamicResource Btn_ZipShare}" Tag="📤" Click="BtnZipShare_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="#8B8000" Foreground="White"/>
                        <Button Content="{DynamicResource Btn_Browser}" Tag="🌐" Click="BtnBrowser_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="#005A9E" Foreground="White"/>
                        <Button Content="{DynamicResource Btn_Tutorial}" Tag="🎓" Click="BtnTutorial_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_InputRecorder}" Tag="⏺️" Click="BtnOpenRecorder_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{DynamicResource Btn_PromptTags}" Tag="🏷️" Click="BtnPromptTags_Click" Style="{StaticResource NavButtonStyle}" Background="#0284C7" Foreground="White"/>
                        <Button Content="{DynamicResource Btn_Settings}" Tag="⚙️" Click="BtnSettings_Click" Style="{StaticResource NavButtonStyle}"/>
                    </UniformGrid>
                </Grid>

                <StatusBar Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                    <StatusBarItem>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#444" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtServerStatus" Text="Remote Server: Offline" FontSize="10" 
                                       Foreground="{StaticResource ForegroundMutedBrush}"/>
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
