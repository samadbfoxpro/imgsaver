<Window x:Class="imgsaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Saver Pro" Width="1020"
        Height="700"
        MinHeight="600" MinWidth="880"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="14"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="14" BorderThickness="1" BorderBrush="#1C2438" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000818" BlurRadius="30" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090D1A" Offset="0"/>
                <GradientStop Color="#05070F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 1. CUSTOM TOP TITLEBAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#0C1122" CornerRadius="14,14,0,0"
                    FlowDirection="LeftToRight"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderThickness="0,0,0,1" BorderBrush="#161E34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Border CornerRadius="8" Width="26" Height="26" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                            <Path Data="{StaticResource IconCamera}" Style="{StaticResource VectorIconSmall}" Fill="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Image Saver Pro" Foreground="#F0F6FC" 
                                   FontSize="13.5" VerticalAlignment="Center" FontWeight="Bold"/>

                        <!-- Version Badge -->
                        <Border Background="#122040" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersion" Text="v2.1.7" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnLockApp" Click="BtnLockApp_Click"
                                Style="{StaticResource TitleBarButtonStyle}" ToolTip="قفل سریع برنامه (Ctrl + L)" Width="36">
                            <Border Background="#132347" CornerRadius="6" Width="24" Height="24">
                                <Path Data="{StaticResource IconLock}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="□" Click="BtnMaximize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 2. MAIN WORKSPACE WITH SIDEBAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT NAVIGATION SIDEBAR ── -->
                <Border Grid.Column="0" Background="#080C18" BorderThickness="0,0,1,0" BorderBrush="#141C30">
                    <Grid Margin="10,12,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nav Menu Buttons -->
                        <StackPanel Grid.Row="0" FlowDirection="RightToLeft">

                            <!-- Active Home Tab -->
                            <Button Click="BtnHome_Click" Height="40" Margin="0,0,0,8" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1D4ED8" CornerRadius="10">
                                            <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                                            <Grid Margin="12,0" FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{StaticResource IconBrowser}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="خانه" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Download / Browser -->
                            <Button Click="BtnBrowser_Click" Height="38" Margin="0,0,0,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="12,0">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="ico" Data="{StaticResource IconArrowDown}" Fill="#8A9BB2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Grid.Column="1" Text="دانلود / مرورگر" FontSize="11" FontWeight="SemiBold" Foreground="#8A9BB2" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#121A30"/>
                                                <Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- File Management / Archive -->
                            <Button Click="BtnArchive_Click" Height="38" Margin="0,0,0,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="12,0">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="ico" Data="{StaticResource IconFolder}" Fill="#8A9BB2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Grid.Column="1" Text="مدیریت فایل" FontSize="11" FontWeight="SemiBold" Foreground="#8A9BB2" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#121A30"/>
                                                <Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Settings -->
                            <Button Click="BtnSettings_Click" Height="38" Margin="0,0,0,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="12,0">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="ico" Data="{StaticResource IconSettings}" Fill="#8A9BB2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Grid.Column="1" Text="{DynamicResource Btn_Settings}" FontSize="11" FontWeight="SemiBold" Foreground="#8A9BB2" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#121A30"/>
                                                <Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tutorial / Help -->
                            <Button Click="BtnTutorial_Click" Height="38" Margin="0,0,0,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="12,0">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="ico" Data="{StaticResource IconInfo}" Fill="#8A9BB2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Grid.Column="1" Text="{DynamicResource Btn_Tutorial}" FontSize="11" FontWeight="SemiBold" Foreground="#8A9BB2" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#121A30"/>
                                                <Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Exit Button -->
                            <Button Click="BtnExit_Click" Height="38" Margin="0,0,0,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="12,0">
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="ico" Data="{StaticResource IconClose}" Fill="#A05050" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txt" Grid.Column="1" Text="خروج" FontSize="11" FontWeight="SemiBold" Foreground="#A05050" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#221014"/>
                                                <Setter TargetName="ico" Property="Fill" Value="#FF6B6B"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FF6B6B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>

                        <!-- Bottom Sidebar Promo Card -->
                        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="#1E2A4A" Padding="10,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0E1730" Offset="0"/>
                                    <GradientStop Color="#160E2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#1D4ED8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="10" Opacity="0.5"/></Border.Effect>
                                    <Path Data="{StaticResource IconGallery}" Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Image Saver Pro" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="ذخیره، مدیریت، با سرعت و دقت بیشتر" FontSize="8.5" Foreground="#7E90B0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,8"/>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#1A2440" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconShare}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- ── MAIN DASHBOARD VIEW ── -->
                <ScrollViewer x:Name="DashboardView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="16,12,16,14">

                        <!-- ══ HERO BANNER ══ -->
                        <Border CornerRadius="16" Height="98" ClipToBounds="True" BorderThickness="1" BorderBrush="#1D4ED8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#091C4A" Offset="0"/>
                                    <GradientStop Color="#0E2D78" Offset="0.5"/>
                                    <GradientStop Color="#150E3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- Background Ambient Light -->
                                <Ellipse Width="160" Height="160" Fill="#2563EB" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,-40,0,0">
                                    <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
                                </Ellipse>

                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Glowing Logo Badge -->
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="14" Background="#143075" BorderThickness="1" BorderBrush="#3B82F6" VerticalAlignment="Center">
                                        <Border.Effect><DropShadowEffect Color="#3B82F6" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                                        <Path Data="{StaticResource IconCamera}" Fill="White" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Center Welcome Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" FlowDirection="RightToLeft">
                                        <TextBlock Text="به Image Saver Pro خوش آمدید!" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="ابزار حرفه‌ای شما برای ساخت، مدیریت و پردازش تصاویر و پرامپت‌ها از سراسر وب" FontSize="11" Foreground="#93C5FD" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Right Stylized Mountain / Sun Graphic -->
                                    <Canvas Grid.Column="2" Width="100" Height="80" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="60" Canvas.Top="8" Width="16" Height="16" Fill="#F59E0B">
                                            <Ellipse.Effect><DropShadowEffect Color="#F59E0B" BlurRadius="12" Opacity="0.8"/></Ellipse.Effect>
                                        </Ellipse>
                                        <Path Data="M 10,70 L 45,25 L 75,70 Z" Fill="#3B82F6" Opacity="0.8"/>
                                        <Path Data="M 40,70 L 70,35 L 95,70 Z" Fill="#8B5CF6" Opacity="0.7"/>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ══ SECTION: دسترسی سریع ══ -->
                        <TextBlock Text="⚡ دسترسی سریع" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="4,14,4,8" FlowDirection="RightToLeft"/>

                        <!-- 4 NEON CARDS (VIOLET, BLUE, TEAL, ORANGE) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Gallery (Purple Neon) -->
                            <Button Grid.Column="0" Click="BtnGallery_Click" Height="142" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="14" Background="#120E28" BorderThickness="1.5" BorderBrush="#5B21B6" Padding="12">
                                            <Border.Effect><DropShadowEffect x:Name="sh" Color="#7C3AED" BlurRadius="12" ShadowDepth="2" Opacity="0.2"/></Border.Effect>
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#7C3AED" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource IconGallery}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock Text="گالری تصاویر" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="مشاهده و مدیریت تصاویر ذخیره‌شده" FontSize="9.5" Foreground="#A78BFA" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="#2E1065" HorizontalAlignment="Left">
                                                    <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#1C143C"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="#8B5CF6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Card 2: AI Browser (Blue Neon) -->
                            <Button Grid.Column="2" Click="BtnBrowser_Click" Height="142" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="14" Background="#09152C" BorderThickness="1.5" BorderBrush="#1E40AF" Padding="12">
                                            <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource IconBrowser}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock Text="مرورگر هوشمند وب" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="کاوش و دانلود مستقیم تصاویر وب" FontSize="9.5" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="#1E3A8A" HorizontalAlignment="Left">
                                                    <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#0E2146"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Card 3: Mini Clipboard (Teal Neon) -->
                            <Button Grid.Column="4" Click="BtnMiniClipboard_Click" Height="142" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="14" Background="#061A18" BorderThickness="1.5" BorderBrush="#065F46" Padding="12">
                                            <Border.Effect><DropShadowEffect Color="#059669" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#059669" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource IconCopy}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock Text="مدیریت کلیپ‌بورد" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="ذخیره و استفاده از متن‌ها و لینک‌ها" FontSize="9.5" Foreground="#6EE7B7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="#064E3B" HorizontalAlignment="Left">
                                                    <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#0A2824"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="#10B981"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Card 4: Persona Injector (Orange Neon) -->
                            <Button Grid.Column="6" Click="BtnPersona_Click" Height="142" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="14" Background="#1D1206" BorderThickness="1.5" BorderBrush="#92400E" Padding="12">
                                            <Border.Effect><DropShadowEffect Color="#D97706" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                                            <Grid FlowDirection="RightToLeft">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#D97706" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource IconPersona}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock Text="شخصیت‌ساز پرامپت" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="تزریق و ساخت پرسونای هوشمند" FontSize="9.5" Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="#78350F" HorizontalAlignment="Left">
                                                    <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="#FCD34D" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#2D1B0A"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="#F59E0B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ══ SECTION: سایر ابزارها و امکانات ══ -->
                        <TextBlock Text="🛠️ سایر ابزارها و امکانات" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="4,16,4,8" FlowDirection="RightToLeft"/>

                        <!-- 8 Secondary Tools Grid (4 Columns x 2 Rows) -->
                        <Grid FlowDirection="RightToLeft">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 1 -->
                            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnPromptSurgeon" Content="جراحی پرامپت" Tag="{StaticResource IconCut}" Click="BtnPromptSurgeon_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Btn_PromptTags}" Tag="{StaticResource IconTagger}" Click="BtnPromptTags_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="4" Content="{DynamicResource Btn_Snippets}" Tag="{StaticResource IconSnippets}" Click="BtnSnippets_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="6" Content="{DynamicResource Btn_ZipShare}" Tag="{StaticResource IconShare}" Click="BtnZipShare_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <!-- Row 2 -->
                            <Button Grid.Row="2" Grid.Column="0" Content="{DynamicResource Btn_ExtraFloat}" Tag="{StaticResource IconCombiner}" Click="BtnExtraFloat_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Btn_CloudLink}" Tag="{StaticResource IconGlobe}" Click="BtnCloudLink_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="2" Grid.Column="4" Content="{DynamicResource Btn_InputRecorder}" Tag="{StaticResource IconRecord}" Click="BtnOpenRecorder_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>

                            <Button Grid.Row="2" Grid.Column="6" x:Name="BtnRemote" Content="{DynamicResource Btn_Remote}" Tag="{StaticResource IconGlobe}" Click="BtnRemote_Click" Height="44" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="#0C1222" BorderThickness="1" BorderBrush="#1C2744" Padding="10,0"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="#8FA0BA" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="txt" Grid.Column="1" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#162240"/><Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="ico" Property="Fill" Value="#FFFFFF"/><Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                            </Button>
                        </Grid>

                        <!-- ══ MINIMAL STATUS BAR ══ -->
                        <Border Margin="0,16,0,0" CornerRadius="10" Background="#070B16" BorderThickness="1" BorderBrush="#121828" Padding="14,8">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Live Server / System Status -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ServerStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtServerStatus" Text="Remote Server: Offline" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="Image Saver Pro Suite" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════════════════════════════════════════════════ -->
                <!-- 3. IN-PLACE SETTINGS VIEW (EMBEDDED IN WORKSPACE COLUMN 1) -->
                <!-- ════════════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="SettingsView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,12,20,12" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="SettingsCardStyle" TargetType="Border">
                            <Setter Property="Background" Value="#1A1B20"/>
                            <Setter Property="BorderBrush" Value="#292C35"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Padding" Value="14"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Settings Top Navigation Bar -->
                    <Border Background="#15161A" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back to Dashboard Button -->
                            <Button x:Name="BtnBackFromSettings" Click="BtnBackFromSettings_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconArrowLeft}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="بازگشت به منوی اصلی" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Center Title -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="#06B6D4" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تنظیمات برنامه (Settings)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Save Settings Button -->
                            <Button x:Name="BtnSaveSettings" Click="BtnSaveSettings_Click" 
                                    Grid.Column="2" Height="34" Padding="14,0" Cursor="Hand" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ذخیره تنظیمات" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card 1: Security & Master Password -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconLock}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="امنیت و رمز عبور اصلی (Security)" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSecurityStatus" Text="وضعیت: محافظت شده با رمز عبور اصلی (PBKDF2 + DPAPI)" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                    <TextBlock Text="برنامه قبل از ورود و در حین کار با کلید میانبر Ctrl + L قفل می‌شود." FontSize="10.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnChangeMasterPassword" Click="BtnChangeMasterPassword_Click" 
                                            Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,0" Margin="8,0,0,0" Cursor="Hand">
                                        <TextBlock Text="تغییر رمز عبور" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                                    </Button>

                                    <Button x:Name="BtnChangeMasterPattern" Click="BtnChangeMasterPattern_Click" 
                                            Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand">
                                        <TextBlock Text="تغییر الگو" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                                    </Button>
                                </StackPanel>

                                <Button Click="BtnLockApp_Click" 
                                        Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand">
                                    <TextBlock Text="قفل برنامه اکنون" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                                </Button>
                            </Grid>

                            <!-- Lock Behavior Policy -->
                            <Border Background="#141519" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="زمان اجرای قفل برنامه (Lock Activation Policy):" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        <TextBlock Text="تعیین کنید قفل برنامه در چه زمانی فعال و پرسیده شود." FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbLockTriggerMode" Grid.Column="1" Width="280" Height="28" Background="#1E2028" Foreground="White" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="🔒 همیشه هنگام باز شدن برنامه (پیش‌فرض)" Tag="0"/>
                                        <ComboBoxItem Content="⚡ فقط با قفل دستی یا تا ریستارت سیستم" Tag="1"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Lock Method Policy -->
                            <Border Background="#141519" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="روش پیش‌فرض قفل (Default Lock Method):" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        <TextBlock Text="روش اصلی برای ورود را مشخص کنید (الگو یا رمز عبور)." FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbLockAuthType" Grid.Column="1" Width="280" Height="28" Background="#1E2028" Foreground="White" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="💠 قفل الگوی ۹ نقطه‌ای (Pattern)" Tag="0"/>
                                        <ComboBoxItem Content="🔑 رمز عبور متنی (Password)" Tag="1"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Change Password Sub-panel -->
                            <Border x:Name="ChangePasswordPanel" Background="#141519" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="تغییر رمز عبور اصلی" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="رمز عبور فعلی:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtCurrentPassword" Grid.Column="1" Height="26" Background="#1E2028" Foreground="White" BorderBrush="#333846" Padding="4,2"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="رمز عبور جدید:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtNewPassword" Grid.Column="1" Height="26" Background="#1E2028" Foreground="White" BorderBrush="#333846" Padding="4,2"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="تکرار رمز عبور جدید:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtConfirmNewPassword" Grid.Column="1" Height="26" Background="#1E2028" Foreground="White" BorderBrush="#333846" Padding="4,2"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnCancelChangePassword" Click="BtnCancelChangePassword_Click" Content="انصراف" Height="26" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button x:Name="BtnSubmitChangePassword" Click="BtnSubmitChangePassword_Click" Content="ذخیره رمز جدید" Height="26" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Language & General -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconGlobe}" Fill="#4ADE80" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="زبان و رابط کاربری (Language &amp; Display)" FontSize="12.5" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="زبان برنامه (Application Language):" FontSize="11.5" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="140" Height="28" VerticalContentAlignment="Center" Background="#1E2028" Foreground="White">
                                    <ComboBoxItem Content="فارسی (Persian)" Tag="fa"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Storage & Folders -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconFolder}" Fill="#FBBF24" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسیرهای ذخیره‌سازی و رسانه (Storage &amp; Folders)" FontSize="12.5" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Save Path -->
                            <TextBlock Text="مسیر پیش‌فرض ذخیره تصاویر:" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsSavePath" IsReadOnly="True" Height="28" Padding="6,2" VerticalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240" FlowDirection="LeftToRight"/>
                                <Button Grid.Column="1" Content="انتخاب..." Click="BtnBrowseSavePath_Click" Width="70" Height="28" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>

                            <!-- Gallery Path -->
                            <TextBlock Text="مسیر گالری تصاویر:" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsGalleryPath" IsReadOnly="True" Height="28" Padding="6,2" VerticalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240" FlowDirection="LeftToRight"/>
                                <Button Grid.Column="1" Content="انتخاب..." Click="BtnBrowseGalleryPath_Click" Width="70" Height="28" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>

                            <!-- Shared Data Folder -->
                            <CheckBox x:Name="ChkUseCustomDataFolder" Content="استفاده از پوشه مشترک برای پرامپت‌ها و لایبرری" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomDataFolder" IsReadOnly="True" Height="28" Padding="6,2" VerticalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240" FlowDirection="LeftToRight"/>
                                <Button Grid.Column="1" Content="انتخاب..." Click="BtnBrowseCustomDataFolder_Click" Width="70" Height="28" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Mini-Clip Automation -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconCombiner}" Fill="#A78BFA" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="اتوماسیون کلیپ‌بورد (Mini-Clip Automation)" FontSize="12.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkAutoSaveEnabled" Content="ذخیره خودکار تصاویر کلیپ‌بورد" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkAutoSaveDelay" Content="تأخیر در ذخیره خودکار:" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtAutoSaveDelaySeconds" Text="10" Width="45" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240"/>
                                <TextBlock Text="ثانیه" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="6,0,16,0"/>
                                
                                <TextBlock Text="تعداد تصاویر قبل از ذخیره:" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtAutoSaveCount" Text="1" Width="45" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkAutoCaptureExtraTemplate" Content="دریافت و جایگزینی خودکار قالب [extra]" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkAutoCopyExtraTemplateOutput" Content="کپی خودکار نتیجه ترکیب Extra در کلیپ‌بورد" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkAutoCopyTagReplacerOutput" Content="کپی خودکار خروجی Tag Replacer در کلیپ‌بورد" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkReplacePositivePromptOnClipboardText" Content="به‌روزرسانی پرامپت مثبت با کپی متن جدید" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkSpiSyncPreserveBasePrompt" Content="حفظ پرامپت مبنا در هماهنگ‌سازی SPI Sync" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,6,6"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="ChkUseTagReplacerForMiniClip" Content="استفاده از Tag Replacer با پیشوند:" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtTagReplacerPrefix" Text="PH_" Width="60" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 5: Image Dimensions & Auto Import -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconDownload}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فیلتر ابعاد و ورود خودکار (Filters &amp; Auto Import)" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Dimensions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="حداقل عرض تصویر (px):" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtMinImageWidth" Text="50" Width="55" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240" Margin="0,0,16,0"/>
                                <TextBlock Text="حداقل ارتفاع تصویر (px):" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtMinImageHeight" Text="50" Width="55" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240"/>
                            </StackPanel>

                            <!-- Auto Import -->
                            <CheckBox x:Name="ChkAutoImportEnabled" Content="مانیتورینگ پوشه دانلود و ورود خودکار تصاویر" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAutoImportPath" IsReadOnly="True" Height="28" Padding="6,2" VerticalContentAlignment="Center" Background="#141519" Foreground="White" BorderBrush="#2D3240" FlowDirection="LeftToRight"/>
                                <Button Grid.Column="1" Content="انتخاب..." Click="BtnBrowseAutoImport_Click" Width="70" Height="28" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </Grid>

        </Grid>
    </Border>
</Window>
