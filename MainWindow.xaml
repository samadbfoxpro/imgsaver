<Window x:Class="imgsaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Saver Pro" Width="600"
        SizeToContent="Height"
        MinHeight="400" MinWidth="550"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="8" BorderThickness="1" BorderBrush="#333" Margin="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E1E" Offset="0"/>
                <GradientStop Color="#121212" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="📷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Image Saver Pro" Foreground="{StaticResource ForegroundBrush}" 
                                   FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>

                        <!-- Version Box in Title Bar -->
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersion" Text="v1.0.0" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="□" Click="BtnMaximize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Attractive Header Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="IMAGE SAVER PRO" FontSize="34" FontWeight="Black" 
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="PREMIUM DATASET COLLECTION SUITE" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8" Margin="4,4">
                                            <Grid>
                                                <Border x:Name="HoverLayer" Background="Black" Opacity="0" CornerRadius="7"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontSize="20" 
                                                               Foreground="{TemplateBinding Foreground}"
                                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="9" FontWeight="SemiBold" 
                                                               Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="MINI CLIP" Tag="📋" Click="BtnMiniClipboard_Click" Style="{StaticResource NavButtonStyle}" Background="#1B5E20" Foreground="White"/>
                        <Button Grid.Column="1" Content="PERSONA" Tag="🎭" Click="BtnPersona_Click" Style="{StaticResource NavButtonStyle}" Background="#4A148C" Foreground="White"/>
                    </Grid>

                    <Button Grid.Row="1" Content="GALLERY" Tag="🖼️" Click="BtnGallery_Click" Style="{StaticResource NavButtonStyle}" Margin="0,4"/>

                    <UniformGrid Grid.Row="2" Columns="4">
                        <Button Content="CLIP SAVER" Tag="⚡" Click="BtnQuickClipboard_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="SNIPPETS" Tag="📜" Click="BtnSnippets_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="QUICK SAVE" Tag="⚡📸" Click="BtnMiniQuickSave_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="REMOTE" x:Name="BtnRemote" Tag="📱" Click="BtnRemote_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="CLOUD LINK" Tag="☁️" Click="BtnCloudLink_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="ARCHIVE" Tag="📦" Click="BtnArchive_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}"/>
                        <Button Content="ZIP &amp; SHARE" Tag="📤" Click="BtnZipShare_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="#8B8000" Foreground="White"/>
                        <Button Content="BROWSER" Tag="🌐" Click="BtnBrowser_Click" Style="{StaticResource NavButtonStyle}" 
                                Background="#005A9E" Foreground="White"/>
                        <Button Content="TUTORIAL" Tag="🎓" Click="BtnTutorial_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="INPUT RECORDER" Tag="⏺️" Click="BtnOpenRecorder_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="SETTINGS" Tag="⚙️" Click="BtnSettings_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="NETWORK SCANNER" Tag="🌐" Click="BtnNetworkScanner_Click" Style="{StaticResource NavButtonStyle}"
                                Background="#005A9E" Foreground="White"/>
                    </UniformGrid>
                </Grid>

                <Button Grid.Row="2" x:Name="BtnToggleInput" Click="BtnToggleInput_Click" 
                        Background="Transparent" BorderThickness="0" Margin="0,0,0,16" Cursor="Hand"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtToggleArrow" Text="▼" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,1,6,0"/>
                        <TextBlock Text="Show New Image Panel" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel x:Name="InputPanel" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="IMAGE NAME (Ctrl+V to Paste)" Foreground="{StaticResource AccentBrush}" 
                                           FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                                <CheckBox x:Name="ChkDescription" Content="📝 Add Description" 
                                          Checked="ChkDescription_CheckedChanged" Unchecked="ChkDescription_CheckedChanged"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                          Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                            </Grid>
                            <TextBox x:Name="TxtImageName" Height="40" FontSize="14" VerticalContentAlignment="Center" 
                                     PreviewKeyDown="TxtImageName_PreviewKeyDown" Padding="10"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,16" Height="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="POSITIVE PROMPT" Foreground="{StaticResource SuccessBrush}" 
                                           FontWeight="SemiBold" Margin="0,0,0,6" FontSize="11"/>
                                <TextBox x:Name="TxtPositive" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="PromptBox_PreviewKeyDown" Padding="10" VerticalContentAlignment="Top"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="NEGATIVE PROMPT" Foreground="{StaticResource ErrorBrush}" 
                                           FontWeight="SemiBold" Margin="0,0,0,6" FontSize="11"/>
                                <TextBox x:Name="TxtNegative" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="PromptBox_PreviewKeyDown" Padding="10" VerticalContentAlignment="Top"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="DescriptionPanel" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="DESCRIPTION (Optional)" Foreground="{StaticResource ForegroundMutedBrush}" 
                                       FontWeight="SemiBold" Margin="0,0,0,6" FontSize="11"/>
                            <TextBox x:Name="TxtDescription" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Height="60"
                                     PreviewKeyDown="PromptBox_PreviewKeyDown" Padding="10" VerticalContentAlignment="Top"/>
                        </Grid>

                        <Border x:Name="PreviewBorder" Margin="0,0,0,16" 
                                Background="#000000" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Height="140">
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4"/>
                                <Button Click="BtnDeleteImage_Click" Background="#AA000000" Foreground="White" BorderThickness="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Width="24" Height="24" Padding="0" Cursor="Hand" ToolTip="Remove Image">
                                    <TextBlock Text="✕" FontSize="12"/>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Button x:Name="BtnSave" Content="SAVE IMAGE &amp; PROMPTS" Click="BtnSave_Click" 
                                Height="44" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </ScrollViewer>

                <StatusBar Grid.Row="4" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                    <StatusBarItem>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#444" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtServerStatus" Text="Remote Server: Offline" FontSize="10" 
                                       Foreground="{StaticResource ForegroundMutedBrush}"/>
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
