<Window x:Class="imgsaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Saver Pro" Width="680"
        SizeToContent="Height"
        MinHeight="450" MinWidth="620"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#3A3A3C" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1B1E" Offset="0"/>
                <GradientStop Color="#121315" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Modern TitleBar -->
            <Border Grid.Row="0" Background="#222327" CornerRadius="12,12,0,0"
                    FlowDirection="LeftToRight"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Border Background="#007ACC" CornerRadius="6" Width="22" Height="22" Margin="0,0,10,0">
                            <TextBlock Text="📷" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Image Saver Pro" Foreground="#E0E0E0" 
                                   FontSize="13" VerticalAlignment="Center" FontWeight="Bold"/>

                        <!-- Version Badge -->
                        <Border Background="#2A394A" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersion" Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="#3794FF" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="□" Click="BtnMaximize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,12">
                <StackPanel>
                    <StackPanel.Resources>
                        <!-- Card Style -->
                        <Style x:Key="CardPanelStyle" TargetType="Border">
                            <Setter Property="Background" Value="#1E1F23"/>
                            <Setter Property="BorderBrush" Value="#2D2F36"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,0,0,14"/>
                        </Style>

                        <!-- Primary Card Action Button -->
                        <Style x:Key="HeroTileButtonStyle" TargetType="Button">
                            <Setter Property="Height" Value="64"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}" 
                                                CornerRadius="8" BorderThickness="1" Opacity="0.95" Padding="10,6">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#2D2F36"/>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="iconBox" Width="38" Height="38" CornerRadius="6" Background="#20FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Opacity" Value="1"/>
                                                <Setter TargetName="iconBox" Property="Background" Value="#35FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="cardBorder" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Grid Tile Action Button -->
                        <Style x:Key="GridTileButtonStyle" TargetType="Button">
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Margin" Value="3"/>
                            <Setter Property="Background" Value="#222429"/>
                            <Setter Property="Foreground" Value="#C2C6D0"/>
                            <Setter Property="BorderBrush" Value="#2F323A"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" CornerRadius="7"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Background="{TemplateBinding Background}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0">
                                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold" 
                                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#32363F"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#444954"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter TargetName="icon" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1C1E23"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#282A30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Section 1: Core Workflow Tools -->
                    <Border Style="{StaticResource CardPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="⚡ ابزارهای اصلی گردش کار" FontSize="11" FontWeight="Bold" Foreground="#007ACC" Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Btn_MiniClip}" Tag="📋" Click="BtnMiniClipboard_Click" 
                                        Style="{StaticResource HeroTileButtonStyle}" Background="#1E4D2B"/>
                                <Button Grid.Column="1" Content="{DynamicResource Btn_Browser}" Tag="🌐" Click="BtnBrowser_Click" 
                                        Style="{StaticResource HeroTileButtonStyle}" Background="#005A9E"/>
                                <Button Grid.Column="2" Content="{DynamicResource Btn_Persona}" Tag="🎭" Click="BtnPersona_Click" 
                                        Style="{StaticResource HeroTileButtonStyle}" Background="#3D1C6D"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Media & Gallery Management -->
                    <Border Style="{StaticResource CardPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="🖼️ مدیریت رسانه و گالری" FontSize="11" FontWeight="Bold" Foreground="#89D185" Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Button Grid.Row="0" Content="{DynamicResource Btn_Gallery}" Tag="🖼️" Click="BtnGallery_Click" 
                                        Style="{StaticResource HeroTileButtonStyle}" Background="#143A52" Margin="4,0,4,6"/>
                                
                                <UniformGrid Grid.Row="1" Columns="4">
                                    <Button Content="{DynamicResource Btn_QuickSave}" Tag="⚡" Click="BtnMiniQuickSave_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                    <Button Content="{DynamicResource Btn_ClipSaver}" Tag="📥" Click="BtnQuickClipboard_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                    <Button Content="{DynamicResource Btn_Archive}" Tag="📦" Click="BtnArchive_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                    <Button Content="{DynamicResource Btn_ZipShare}" Tag="📤" Click="BtnZipShare_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Advanced Utilities & Tools -->
                    <Border Style="{StaticResource CardPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="⚙️ ابزارها و اتوماسیون پیشرفته" FontSize="11" FontWeight="Bold" Foreground="#CCA700" Margin="4,0,0,8"/>
                            <UniformGrid Columns="3">
                                <Button Content="{DynamicResource Btn_PromptTags}" Tag="🏷️" Click="BtnPromptTags_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                <Button Content="{DynamicResource Btn_Snippets}" Tag="📜" Click="BtnSnippets_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                <Button Content="{DynamicResource Btn_ExtraFloat}" Tag="🧩" Click="BtnExtraFloat_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                <Button Content="{DynamicResource Btn_InputRecorder}" Tag="⏺️" Click="BtnOpenRecorder_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                <Button Content="{DynamicResource Btn_Remote}" x:Name="BtnRemote" Tag="📱" Click="BtnRemote_Click" Style="{StaticResource GridTileButtonStyle}"/>
                                <Button Content="{DynamicResource Btn_CloudLink}" Tag="☁️" Click="BtnCloudLink_Click" Style="{StaticResource GridTileButtonStyle}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: System & Help -->
                    <Grid Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Btn_Settings}" Tag="⚙️" Click="BtnSettings_Click" Style="{StaticResource GridTileButtonStyle}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Btn_Tutorial}" Tag="🎓" Click="BtnTutorial_Click" Style="{StaticResource GridTileButtonStyle}"/>
                        
                        <Button Grid.Column="2" Content="Exit App" Tag="🚪" Click="BtnExit_Click" Width="105" Height="52" Margin="3,3,0,3"
                                Style="{StaticResource GridTileButtonStyle}" Background="#3A181C" BorderBrush="#E81123" Foreground="#FF8F8F"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#161719" BorderBrush="#25272C" BorderThickness="0,1,0,0" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#666666" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtServerStatus" Text="Remote Server: Offline" FontSize="11" 
                                   Foreground="{StaticResource ForegroundMutedBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Image Saver Pro Suite" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
