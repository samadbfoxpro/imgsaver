<Window x:Class="imgsaver.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Application" 
        Width="380" Height="175"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1.2" CornerRadius="10" 
            Background="#121216" BorderBrush="#E81123" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Minimal Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="🚪" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Exit Application" Foreground="#FF5252" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Compact Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,12">
                <TextBlock Text="Are you sure you want to exit Image Saver Pro?" 
                           Foreground="#F0F0F0" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Text="All running background tasks and services will be closed." 
                           Foreground="#888899" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Minimal Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True"
                        Width="85" Height="28" Margin="0,0,8,0" Cursor="Hand"
                        FontSize="11" FontWeight="SemiBold" Foreground="#CCC">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#22222A" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#323240"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Exit App" Click="BtnConfirmExit_Click" IsDefault="True"
                        Width="95" Height="28" Cursor="Hand"
                        FontSize="11" FontWeight="Bold" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#E81123" BorderBrush="#FF4D4D" BorderThickness="1" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF1E2F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
