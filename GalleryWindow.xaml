<Window x:Class="imgsaver.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Gallery" Height="850" Width="1100"
        MinHeight="650" MinWidth="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Address Bar -->
                <RowDefinition Height="Auto"/> <!-- Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Navigation Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- VS Code Style Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🖼️" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Image Gallery" Foreground="{StaticResource ForegroundBrush}" 
                                   FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImageCount" Text="0 Images" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Content="─" Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Address Bar -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16,8,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="📂" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                    
                    <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                        <TextBox x:Name="TxtGalleryPath" Background="Transparent" BorderThickness="0" 
                                 Foreground="{StaticResource ForegroundBrush}" FontSize="12" VerticalAlignment="Center"
                                 KeyDown="TxtGalleryPath_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <Button x:Name="BtnBrowse" Grid.Column="2" Content="..." Click="BtnSelectFolder_Click"
                            Width="30" Height="28" Background="{StaticResource InputBrush}" 
                            Foreground="{StaticResource ForegroundBrush}" BorderThickness="0" Cursor="Hand" ToolTip="Browse Folder">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="{StaticResource InputBrush}" CornerRadius="4" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}" FontSize="13" VerticalAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search filenames and prompts..." 
                                       Foreground="{StaticResource ForegroundMutedBrush}" FontSize="13" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Click="BtnClearSearch_Click"
                                    Visibility="Collapsed" Width="22" Height="22" FontSize="10" Cursor="Hand"
                                    Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <TextBlock x:Name="TxtSearchResults" Grid.Column="1" Text="" Foreground="{StaticResource AccentBrush}" 
                               FontSize="11" VerticalAlignment="Center" Margin="12,0,12,0"/>

                    <!-- Unorganized Toggle &amp; Selection -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button x:Name="BtnDeleteSelected" Content="Delete Selected" Click="BtnDeleteSelected_Click" 
                                Visibility="Collapsed" Style="{StaticResource TitleBarCloseButtonStyle}" 
                                Padding="12,4" FontSize="11" Margin="0,0,8,0" Height="28"/>
                        
                        <Button x:Name="BtnRandomGallery" Content="🎲 Random" Click="BtnRandomGallery_Click" 
                                Width="90" Height="28" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnPrivacyMode" Click="BtnPrivacyMode_Click" 
                                Width="32" Height="28" FontSize="14" Margin="0,0,12,0" Cursor="Hand"
                                ToolTip="Toggle Privacy Blur (👁️)"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock x:Name="txt" Text="👁️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <CheckBox x:Name="ChkSelectMode" Content="Select Mode" 
                                  Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12"
                                  VerticalContentAlignment="Center" Cursor="Hand" Margin="0,0,12,0"
                                  Checked="ChkSelectMode_Changed" Unchecked="ChkSelectMode_Changed"/>

                        <CheckBox x:Name="ChkShowUnorganized" Content="Show Unorganized" 
                                  Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12"
                                  VerticalContentAlignment="Center" Cursor="Hand"
                                  Checked="ChkShowUnorganized_Changed" Unchecked="ChkShowUnorganized_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar: Date + Calendar Toggle -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,1,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Prev Button -->
                    <Button x:Name="BtnPrevDate" Content="◄ Prev" Click="BtnPrevDate_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11"/>
                    
                    <!-- Center: Current Date + Calendar Button -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="TxtCurrentDate" Text="Today" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDateInfo" Text="0 Images" FontSize="11"
                                       Foreground="{StaticResource ForegroundMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnShowCalendar" Content="📅" Click="BtnToggleCalendar_Click" 
                                Width="36" Height="36" FontSize="16" Cursor="Hand" ToolTip="Show Calendar"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right: Next Button -->
                    <Button x:Name="BtnNextDate" Content="Next ►" Click="BtnNextDate_Click" 
                            Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11"/>

                    <!-- Refresh Button (Overlay for center) -->
                    <Button x:Name="BtnRefreshRandom" Content="🔄 Refresh" Click="BtnRefreshRandom_Click" 
                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="Collapsed" Width="90" Height="28" FontSize="11" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="4">
                <!-- Gallery Images -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Image Grid -->
                        <UniformGrid x:Name="ImageGrid" Columns="4"/>

                        <!-- Pagination UI -->
                        <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed">
                            <Button x:Name="BtnPrevPage" Content="◄ Prev Page" Click="BtnPrevPage_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1" Foreground="{StaticResource ForegroundBrush}" 
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Button x:Name="BtnNextPage" Content="Next Page ►" Click="BtnNextPage_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                        </StackPanel>

                        <!-- Empty State -->
                        <Border x:Name="EmptyState" Visibility="Collapsed" Padding="40" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                </Border>
                                <TextBlock x:Name="TxtEmptyMessage" Text="No images found for this day" 
                                           Foreground="{StaticResource ForegroundMutedBrush}" 
                                           FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Calendar Popup -->
                <Border x:Name="CalendarPanel" Background="#E6000000" Visibility="Collapsed" MouseLeftButtonDown="CalendarOverlay_Click">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" 
                            Width="380" Height="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MouseLeftButtonDown="CalendarPanel_Click" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Calendar Header -->
                            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button x:Name="BtnPrevMonth" Content="◄" Click="BtnPrevMonth_Click" 
                                            Width="32" Height="32" FontSize="12" Cursor="Hand"
                                            Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    
                                    <TextBlock x:Name="TxtCalendarMonth" Grid.Column="1" Text="December 2025" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Button x:Name="BtnNextMonth" Content="►" Click="BtnNextMonth_Click" 
                                            Grid.Column="2" Width="32" Height="32" FontSize="12" Cursor="Hand"
                                            Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Calendar Content -->
                            <StackPanel Grid.Row="1" Margin="16">
                                <!-- Weekday Headers -->
                                <UniformGrid Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Thu" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </UniformGrid>

                                <!-- Days Grid -->
                                <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- Loading Indicator -->
                <Border x:Name="LoadingIndicator" Background="#CC000000" Visibility="Collapsed" CornerRadius="0,0,8,8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="32,24">
                            <StackPanel>
                                <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="Loading..." Foreground="{StaticResource ForegroundBrush}" FontSize="14" 
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
