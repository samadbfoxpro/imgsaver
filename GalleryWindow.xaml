<Window x:Class="imgsaver.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گالری تصاویر (Image Gallery)" Height="850" Width="1100"
        MinHeight="650" MinWidth="900"
        Background="#18191C"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" 
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Vector Icon Geometries -->
        <StreamGeometry x:Key="IconGallery">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.23L20.82,18.45C20.55,19.36 19.83,20 19,20Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconDice">M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M7,5A2,2 0 0,0 5,7A2,2 0 0,0 7,9A2,2 0 0,0 9,7A2,2 0 0,0 7,5M17,15A2,2 0 0,0 15,17A2,2 0 0,0 17,19A2,2 0 0,0 19,17A2,2 0 0,0 17,15M17,5A2,2 0 0,0 15,7A2,2 0 0,0 17,9A2,2 0 0,0 19,7A2,2 0 0,0 17,5M7,15A2,2 0 0,0 5,17A2,2 0 0,0 7,19A2,2 0 0,0 9,17A2,2 0 0,0 7,15M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeOff">M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.79 8.06,5.32L10.12,7.38C10.71,7.14 11.34,7 12,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconCalendar">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronLeft">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconSparkles">M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.34,7.9L10.9,10.34L13.34,12.78M9.9,13.78L13.34,17.22L16.78,13.78L13.34,10.34L9.9,13.78Z</StreamGeometry>
        <StreamGeometry x:Key="IconLock">M18,8H17V6A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 15,6V8H9V6M18,20H6V10H18V20Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M0,0 L10,0</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M1,1 L9,1 L9,9 L1,9 Z M0,0 L10,0 L10,10 L0,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M3,1 L9,1 L9,7 L8,7 L8,2 L3,2 Z M1,3 L7,3 L7,9 L1,9 Z M0,2 L8,2 L8,10 L0,10 Z</StreamGeometry>
    </Window.Resources>

    <Border x:Name="MainBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Address Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Controls Bar -->
                <RowDefinition Height="Auto"/> <!-- Date & Navigation Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- TOP TITLE BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Image Count Badge (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#0C242B" BorderBrush="#0891B2" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGallery}" Fill="#06B6D4" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="گالری تصاویر (Image Gallery)" Foreground="{StaticResource ForegroundBrush}" 
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImageCount" Text="۰ تصویر" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Standard Caption Buttons (Right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnLockApp" Style="{StaticResource CaptionBtnStyle}" Click="BtnLockApp_Click" ToolTip="قفل سریع برنامه (Ctrl + L)" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconLock}" Fill="#949BA4" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="کوچک کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconMinimize}" Fill="#949BA4" Width="10" Height="2" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="بزرگ کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIconPath" Data="{StaticResource IconMaximize}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="بستن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconClose}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- ADDRESS / PATH BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16,8,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Path Data="{StaticResource IconFolder}" Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" BorderBrush="#2F333D" BorderThickness="1">
                        <TextBox x:Name="TxtGalleryPath" Background="Transparent" BorderThickness="0" 
                                 Foreground="{StaticResource ForegroundBrush}" FontSize="12.5" VerticalAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 KeyDown="TxtGalleryPath_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <Button x:Name="BtnBrowse" Grid.Column="2" Click="BtnSelectFolder_Click"
                            Width="36" Height="32" Background="{StaticResource InputBrush}" 
                            Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D" Cursor="Hand" ToolTip="انتخاب پوشه تصاویر">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <Path Data="{StaticResource IconFolderOpen}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- SEARCH & ACTIONS TOOLBAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Input Box -->
                    <Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="10,6" BorderBrush="#2F333D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Path Data="{StaticResource IconSearch}" Fill="#64748B" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}" FontSize="12.5" VerticalAlignment="Center"
                                     FlowDirection="LeftToRight"
                                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="جستجو در نام فایل‌ها و متن پرامپت‌ها..." 
                                       Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Click="BtnClearSearch_Click"
                                    Visibility="Collapsed" Width="22" Height="22" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11">
                                            <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Search Results Badge -->
                    <TextBlock x:Name="TxtSearchResults" Grid.Column="1" Text="" Foreground="{StaticResource AccentBrush}" 
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,12,0"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">

                        <!-- Delete Selected -->
                        <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" 
                                Visibility="Collapsed" Style="{StaticResource TitleBarCloseButtonStyle}" 
                                Padding="12,4" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTrash}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="حذف موارد انتخابی" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Random Gallery -->
                        <Button x:Name="BtnRandomGallery" Click="BtnRandomGallery_Click" 
                                Height="32" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconDice}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="تصادفی" FontSize="11.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Privacy Blur Mode -->
                        <Button x:Name="BtnPrivacyMode" Click="BtnPrivacyMode_Click" 
                                Width="34" Height="32" Margin="0,0,12,0" Cursor="Hand"
                                ToolTip="حالت حریم خصوصی (تار کردن تصاویر)"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <Path x:Name="PrivacyIconPath" Data="{StaticResource IconEye}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Checkboxes -->
                        <CheckBox x:Name="ChkSelectMode" Content="حالت انتخاب" 
                                  Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12" FontWeight="SemiBold"
                                  VerticalContentAlignment="Center" Cursor="Hand" Margin="0,0,12,0"
                                  Checked="ChkSelectMode_Changed" Unchecked="ChkSelectMode_Changed"/>

                        <CheckBox x:Name="ChkShowUnorganized" Content="دسته‌بندی‌نشده" 
                                  Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12" FontWeight="SemiBold"
                                  VerticalContentAlignment="Center" Cursor="Hand"
                                  Checked="ChkShowUnorganized_Changed" Unchecked="ChkShowUnorganized_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- DATE NAVIGATION & CALENDAR BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,1,0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Prev Day Button -->
                    <Button x:Name="BtnPrevDate" Click="BtnPrevDate_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconChevronLeft}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="روز قبل" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Center: Current Date & Calendar Trigger -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentDate" Text="امروز" FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDateInfo" Text="۰ تصویر" FontSize="11"
                                       Foreground="{StaticResource ForegroundMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnShowCalendar" Click="BtnToggleCalendar_Click" 
                                Width="34" Height="34" Cursor="Hand" ToolTip="مشاهده تقویم و انتخاب تاریخ"
                                Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <Path Data="{StaticResource IconCalendar}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right: Next Day Button -->
                    <Button x:Name="BtnNextDate" Click="BtnNextDate_Click" 
                            Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="روز بعد" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Path Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Random Button -->
                    <Button x:Name="BtnRefreshRandom" Click="BtnRefreshRandom_Click" 
                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="Collapsed" Height="32" Padding="12,0" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بارگذاری مجدد" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- MAIN GALLERY CONTENT AREA -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4">
                <!-- Gallery Images Scrollable Container -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Image Grid -->
                        <UniformGrid x:Name="ImageGrid" Columns="4"/>

                        <!-- Pagination UI -->
                        <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed">
                            <Button x:Name="BtnPrevPage" Click="BtnPrevPage_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Height="30" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconChevronLeft}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="صفحه قبل" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <TextBlock x:Name="TxtPageInfo" Text="صفحه ۱ از ۱" Foreground="{StaticResource ForegroundBrush}" 
                                       VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Margin="0,0,12,0"/>
                            
                            <Button x:Name="BtnNextPage" Click="BtnNextPage_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Height="30">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="صفحه بعد" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Path Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Empty State Indicator -->
                        <Border x:Name="EmptyState" Visibility="Collapsed" Padding="40" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconGallery}" Fill="#475569" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtEmptyMessage" Text="هیچ تصویری برای این تاریخ یافت نشد" 
                                           Foreground="{StaticResource ForegroundMutedBrush}" 
                                           FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- CALENDAR MODAL POPUP -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Border x:Name="CalendarPanel" Background="#E6000000" Visibility="Collapsed" MouseLeftButtonDown="CalendarOverlay_Click">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" 
                            Width="380" Height="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MouseLeftButtonDown="CalendarPanel_Click" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Calendar Header -->
                            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="10,10,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button x:Name="BtnPrevMonth" Click="BtnPrevMonth_Click" 
                                            Width="32" Height="32" Cursor="Hand"
                                            Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <Path Data="{StaticResource IconChevronLeft}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    
                                    <TextBlock x:Name="TxtCalendarMonth" Grid.Column="1" Text="December 2025" FontSize="15" FontWeight="Bold" 
                                               Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Button x:Name="BtnNextMonth" Click="BtnNextMonth_Click" 
                                            Grid.Column="2" Width="32" Height="32" Cursor="Hand"
                                            Background="{StaticResource InputBrush}" Foreground="{StaticResource ForegroundBrush}" BorderThickness="1" BorderBrush="#2F333D">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <Path Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Calendar Content -->
                            <StackPanel Grid.Row="1" Margin="16">
                                <!-- Weekday Headers -->
                                <UniformGrid Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Thu" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>

                                <!-- Days Grid -->
                                <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- LOADING INDICATOR OVERLAY -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Border x:Name="LoadingIndicator" Background="#CC000000" Visibility="Collapsed" CornerRadius="0,0,8,8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="32,24" BorderBrush="#2F333D" BorderThickness="1">
                            <StackPanel>
                                <Path Data="{StaticResource IconRefresh}" Fill="#38BDF8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="در حال بارگذاری تصاویر..." Foreground="{StaticResource ForegroundBrush}" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
