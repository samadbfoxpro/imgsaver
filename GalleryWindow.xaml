<Window x:Class="imgsaver.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گالری تصاویر (Image Gallery)" Height="850" Width="1100"
        MinHeight="650" MinWidth="900"
        Background="#090D1A"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}" 
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Icon="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Vector Icon Geometries -->
        <StreamGeometry x:Key="IconGallery">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.23L20.82,18.45C20.55,19.36 19.83,20 19,20Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <StreamGeometry x:Key="IconDice">M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M7,5A2,2 0 0,0 5,7A2,2 0 0,0 7,9A2,2 0 0,0 9,7A2,2 0 0,0 7,5M17,15A2,2 0 0,0 15,17A2,2 0 0,0 17,19A2,2 0 0,0 19,17A2,2 0 0,0 17,15M17,5A2,2 0 0,0 15,7A2,2 0 0,0 17,9A2,2 0 0,0 19,7A2,2 0 0,0 17,5M7,15A2,2 0 0,0 5,17A2,2 0 0,0 7,19A2,2 0 0,0 9,17A2,2 0 0,0 7,15M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeOff">M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.27,4.79 8.06,5.32L10.12,7.38C10.71,7.14 11.34,7 12,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconCalendar">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronLeft">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconLock">M18,8H17V6A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 15,6V8H9V6M18,20H6V10H18V20Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M0,0 L10,0</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M1,1 L9,1 L9,9 L1,9 Z M0,0 L10,0 L10,10 L0,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M3,1 L9,1 L9,7 L8,7 L8,2 L3,2 Z M1,3 L7,3 L7,9 L1,9 Z M0,2 L8,2 L8,10 L0,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
    </Window.Resources>

    <Border x:Name="MainBorder" CornerRadius="8" BorderThickness="1" BorderBrush="#1C2438" Margin="0" Background="#090D1A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Address Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Controls Bar -->
                <RowDefinition Height="Auto"/> <!-- Date & Navigation Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP TITLE BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#0C1122" CornerRadius="8,8,0,0"
                    FlowDirection="LeftToRight"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderThickness="0,0,0,1" BorderBrush="#161E34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Image Count Badge (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border CornerRadius="8" Width="26" Height="26" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <Path Data="{StaticResource IconGallery}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="گالری تصاویر (Image Gallery)" Foreground="#F0F6FC" 
                                   FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                        <Border Background="#122040" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImageCount" Text="۰ تصویر" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Standard Caption Buttons (Right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnLockApp" Click="BtnLockApp_Click" Style="{StaticResource CaptionBtnStyle}" ToolTip="قفل سریع برنامه (Ctrl + L)" Width="38" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Background="#132347" CornerRadius="6" Width="24" Height="24">
                                <Path Data="{StaticResource IconLock}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="کوچک کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Rectangle Width="10" Height="1.5" Fill="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="بزرگ کردن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeIconPath" Data="{StaticResource IconMaximize}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="بستن" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconClose}" Fill="#949BA4" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 2. ADDRESS / PATH BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#080C18" BorderThickness="0,0,0,1" BorderBrush="#141C30" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Path Data="{StaticResource IconFolder}" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Border Grid.Column="1" Background="#0C1222" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" BorderBrush="#1C2744" BorderThickness="1">
                        <TextBox x:Name="TxtGalleryPath" Background="Transparent" BorderThickness="0" 
                                 Foreground="#F0F6FC" FontSize="12.5" VerticalAlignment="Center"
                                 CaretBrush="#38BDF8" SelectionBrush="#2563EB"
                                 FlowDirection="LeftToRight"
                                 KeyDown="TxtGalleryPath_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="#38BDF8"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <Button x:Name="BtnBrowse" Grid.Column="2" Click="BtnSelectFolder_Click"
                            Width="36" Height="32" Cursor="Hand" ToolTip="انتخاب پوشه تصاویر">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#121A30" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8">
                                    <Path Data="{StaticResource IconFolderOpen}" Fill="#38BDF8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 3. SEARCH & ACTIONS TOOLBAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#080C18" BorderThickness="0,0,0,1" BorderBrush="#141C30" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Input Box -->
                    <Border Background="#0C1222" CornerRadius="8" Padding="10,6" BorderBrush="#1C2744" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Path Data="{StaticResource IconSearch}" Fill="#60A5FA" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="#F0F6FC" FontSize="12.5" VerticalAlignment="Center"
                                     CaretBrush="#38BDF8" SelectionBrush="#2563EB"
                                     FlowDirection="LeftToRight"
                                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="CaretBrush" Value="#38BDF8"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="جستجو در نام فایل‌ها و متن پرامپت‌ها..." 
                                       Foreground="#5A6B87" FontSize="12" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Click="BtnClearSearch_Click"
                                    Visibility="Collapsed" Width="22" Height="22" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                            <Path Data="{StaticResource IconClose}" Fill="#8FA0BA" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#223050"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Search Results Badge -->
                    <Border Grid.Column="1" Background="#122040" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0" VerticalAlignment="Center" Visibility="{Binding ElementName=TxtSearchResults, Path=Text, Converter={x:Null}}">
                        <TextBlock x:Name="TxtSearchResults" Text="" Foreground="#38BDF8" 
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Delete Selected (Danger Neon Pill) -->
                        <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" 
                                Visibility="Collapsed" Height="34" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="8" Background="#260C14" BorderThickness="1.5" BorderBrush="#E11D48" Padding="12,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E11D48" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTrash}" Fill="#FB7185" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="حذف موارد انتخابی" FontSize="11.5" FontWeight="Bold" Foreground="#FDA4AF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#38101E"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#FB7185"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Random Gallery (Purple Neon Pill) -->
                        <Button x:Name="BtnRandomGallery" Click="BtnRandomGallery_Click" 
                                Height="34" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#120E28" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="sh" Color="#7C3AED" BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="ico" Data="{StaticResource IconDice}" Fill="#C084FC" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Text="تصادفی" FontSize="11.5" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1C143C"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="bd" Property="Background" Value="#7C3AED"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#C084FC"/>
                                            <Setter TargetName="ico" Property="Fill" Value="White"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Privacy Blur Mode Button -->
                        <Button x:Name="BtnPrivacyMode" Click="BtnPrivacyMode_Click" 
                                Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand"
                                ToolTip="حالت حریم خصوصی (تار کردن تصاویر)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#121A30" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8">
                                        <Path x:Name="PrivacyIconPath" Data="{StaticResource IconEye}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="bd" Property="Background" Value="#0E2850"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Select Mode Toggle Chip -->
                        <CheckBox x:Name="ChkSelectMode" Margin="0,0,8,0" Cursor="Hand"
                                  Checked="ChkSelectMode_Changed" Unchecked="ChkSelectMode_Changed">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="bd" Background="#0C1222" BorderBrush="#1C2744" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="ico" Data="{StaticResource IconCheck}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Text="حالت انتخاب" FontSize="11.5" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#141E38"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="ico" Property="Fill" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0E2850"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                            <Setter TargetName="ico" Property="Fill" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Show Unorganized Toggle Chip -->
                        <CheckBox x:Name="ChkShowUnorganized" Cursor="Hand"
                                  Checked="ChkShowUnorganized_Changed" Unchecked="ChkShowUnorganized_Changed">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="bd" Background="#0C1222" BorderBrush="#1C2744" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="ico" Data="{StaticResource IconFilter}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Text="دسته‌بندی‌نشده" FontSize="11.5" FontWeight="SemiBold" Foreground="#8FA0BA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#141E38"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="ico" Property="Fill" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0E2850"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                            <Setter TargetName="ico" Property="Fill" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#38BDF8"/>
                                            <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 4. DATE NAVIGATION & CALENDAR BAR -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#0C1122" BorderBrush="#161E34" 
                    BorderThickness="0,0,0,1" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Prev Day Button -->
                    <Button x:Name="BtnPrevDate" Click="BtnPrevDate_Click" 
                            Height="34" Padding="14,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#0E1730" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconChevronLeft}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="روز قبل" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Center: Current Date & Calendar Trigger -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentDate" Text="امروز" FontSize="15" FontWeight="Bold" 
                                       Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDateInfo" Text="۰ تصویر" FontSize="10.5"
                                       Foreground="#7E90B0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnShowCalendar" Click="BtnToggleCalendar_Click" 
                                Width="34" Height="34" Cursor="Hand" ToolTip="مشاهده تقویم و انتخاب تاریخ">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#121A30" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8">
                                        <Path Data="{StaticResource IconCalendar}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right: Next Day Button -->
                    <Button x:Name="BtnNextDate" Click="BtnNextDate_Click" 
                            Grid.Column="2" Height="34" Padding="14,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#0E1730" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="روز بعد" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Path Data="{StaticResource IconChevronRight}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Refresh Random Button (shown only in random mode) -->
                    <Button x:Name="BtnRefreshRandom" Click="BtnRefreshRandom_Click" 
                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="Collapsed" Height="34" Padding="12,0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#120E28" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#C084FC" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="بارگذاری مجدد" FontSize="11.5" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1C143C"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#C084FC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- 5. MAIN GALLERY CONTENT AREA -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4">
                <!-- Gallery Images Scrollable Container -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <!-- Image Grid -->
                        <UniformGrid x:Name="ImageGrid" Columns="4"/>

                        <!-- Pagination UI -->
                        <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed">
                            <Button x:Name="BtnPrevPage" Click="BtnPrevPage_Click" 
                                    Height="32" Padding="12,0" Margin="0,0,12,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#0E1730" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconChevronLeft}" Fill="#38BDF8" Width="9" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="صفحه قبل" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Border Background="#0C1222" BorderBrush="#1C2744" BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPageInfo" Text="صفحه ۱ از ۱" Foreground="#38BDF8" 
                                           VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            
                            <Button x:Name="BtnNextPage" Click="BtnNextPage_Click" 
                                    Height="32" Padding="12,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#0E1730" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="صفحه بعد" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Path Data="{StaticResource IconChevronRight}" Fill="#38BDF8" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Empty State Indicator -->
                        <Border x:Name="EmptyState" Visibility="Collapsed" Padding="40" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#0C1222" BorderBrush="#1C2744" BorderThickness="1" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconGallery}" Fill="#38BDF8" Opacity="0.6" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtEmptyMessage" Text="هیچ تصویری برای این تاریخ یافت نشد" 
                                           Foreground="#7E90B0" 
                                           FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- CALENDAR MODAL POPUP -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Border x:Name="CalendarPanel" Background="#D902040A" Visibility="Collapsed" MouseLeftButtonDown="CalendarOverlay_Click">
                    <Border Background="#0C1122" CornerRadius="14" 
                            Width="390" Height="430" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MouseLeftButtonDown="CalendarPanel_Click" BorderBrush="#1D4ED8" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#000818" BlurRadius="30" ShadowDepth="4" Opacity="0.9"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Calendar Header -->
                            <Border Grid.Row="0" Background="#090D1A" CornerRadius="14,14,0,0" Padding="16,12" BorderBrush="#161E34" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button x:Name="BtnPrevMonth" Click="BtnPrevMonth_Click" 
                                            Width="32" Height="32" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#121A30" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="6">
                                                    <Path Data="{StaticResource IconChevronLeft}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    
                                    <TextBlock x:Name="TxtCalendarMonth" Grid.Column="1" Text="December 2025" FontSize="14" FontWeight="Bold" 
                                               Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Button x:Name="BtnNextMonth" Click="BtnNextMonth_Click" 
                                            Grid.Column="2" Width="32" Height="32" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#121A30" BorderBrush="#1E2A4A" BorderThickness="1" CornerRadius="6">
                                                    <Path Data="{StaticResource IconChevronRight}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1D2D54"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Calendar Content -->
                            <StackPanel Grid.Row="1" Margin="16">
                                <!-- Weekday Headers -->
                                <UniformGrid Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Thu" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>

                                <!-- Days Grid -->
                                <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ════════════════════════════════════════════════════════════ -->
                <!-- LOADING INDICATOR OVERLAY -->
                <!-- ════════════════════════════════════════════════════════════ -->
                <Border x:Name="LoadingIndicator" Background="#CC030610" Visibility="Collapsed" CornerRadius="0,0,14,14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#0C1222" CornerRadius="14" Padding="32,24" BorderBrush="#1D4ED8" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <Path Data="{StaticResource IconRefresh}" Fill="#38BDF8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="در حال بارگذاری تصاویر..." Foreground="#F0F6FC" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
