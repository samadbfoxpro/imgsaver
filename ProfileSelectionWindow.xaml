<Window x:Class="imgsaver.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Account Profile" Height="480" Width="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="*"/>    <!-- Profile Cards List -->
                <RowDefinition Height="Auto"/> <!-- Action Controls -->
                <RowDefinition Height="Auto"/> <!-- Footer Checkbox & Launch -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="22" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Select Account Profile" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                        <TextBlock Text="Choose which isolated account profile to launch in Browser" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="BtnClose_Click" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Foreground="#AAAAAA"
                        Cursor="Hand" FontSize="13" ToolTip="Cancel / Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                <TextBlock Text="✕" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Profiles List -->
            <ListBox x:Name="LstProfiles" Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                     Margin="0,0,0,12" Padding="6" MouseDoubleClick="LstProfiles_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="Background" Value="#252525"/>
                        <Setter Property="BorderBrush" Value="#333333"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2F2F2F"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#2ECC71"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1E3A29"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#2ECC71"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icon & Color Badge -->
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#1A1A1A"
                                    BorderBrush="{Binding ColorHex}" BorderThickness="2" Margin="0,0,12,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Profile Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#AAAAAA" Visibility="{Binding DescriptionVisibility}"/>
                            </StackPanel>

                            <!-- Selection Indicator -->
                            <TextBlock Grid.Column="2" Text="➜" FontSize="14" Foreground="#2ECC71" VerticalAlignment="Center" Margin="10,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Action Controls (Add/Edit/Delete) -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnAddAccount" Content="+ Add Account" Click="BtnAddAccount_Click"
                            Height="28" Padding="12,0" Background="#252525" BorderBrush="#2ECC71" BorderThickness="1"
                            Foreground="#2ECC71" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2ECC71"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnEditAccount" Content="✏️ Rename" Click="BtnEditAccount_Click"
                            Height="28" Padding="10,0" Background="#252525" BorderBrush="#444444" BorderThickness="1"
                            Foreground="#CCCCCC" FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>

                    <Button x:Name="BtnDeleteAccount" Content="🗑️ Delete" Click="BtnDeleteAccount_Click"
                            Height="28" Padding="10,0" Background="#252525" BorderBrush="#E81123" BorderThickness="1"
                            Foreground="#FF5555" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Footer & Launch Button -->
            <Grid Grid.Row="3">
                <CheckBox x:Name="ChkAlwaysAsk" Content="Always ask account profile when opening Browser"
                          IsChecked="True" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>

                <Button x:Name="BtnLaunch" Click="BtnLaunch_Click"
                        HorizontalAlignment="Right" Height="36" Padding="0" FontSize="12" FontWeight="Bold"
                        Background="#145A32" BorderBrush="#2ECC71" BorderThickness="1.2" Foreground="#FFFFFF" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="13" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Launch Selected Account" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1D7A44"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
