<Window x:Class="imgsaver.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب کاربر و اکانت" Height="580" Width="820"
        MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#18191C"
        Foreground="#F2F3F5"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#18191C"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#1E1F22"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2B2D30"/>
        <SolidColorBrush x:Key="BgHover" Color="#35373C"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#36393E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#60A5FA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#949BA4"/>

        <!-- Vector Path Geometries for Avatars -->
        <StreamGeometry x:Key="AvatarIcon_User">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Briefcase">M10,2H14A2,2 0 0,1 16,4V6H20A2,2 0 0,1 22,8V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V8A2,2 0 0,1 4,6H8V4A2,2 0 0,1 10,2M14,6V4H10V6H14Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Gamepad">M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M6,13H5V11H6V10H7V11H8V13H7V14H6V13M15.5,14A1.5,1.5 0 1,1 17,12.5A1.5,1.5 0 0,1 15.5,14M18.5,11A1.5,1.5 0 1,1 20,9.5A1.5,1.5 0 0,1 18.5,11Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Code">M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Rocket">M2.81,14.12L5.64,11.29L8.46,14.12L5.64,16.95L2.81,14.12M21.19,2.81C17.65,2.81 14.82,4.93 13.41,7.05L7.05,13.41L10.59,16.95L16.95,10.59C19.07,9.18 21.19,6.35 21.19,2.81Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Laptop">M20,18H4V6H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Palette">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A3.5,3.5 0 0,0 15.5,18.5C15.5,17.5 14.7,16.7 13.7,16.7H12.3A2.3,2.3 0 0,1 10,14.4A2.3,2.3 0 0,1 12.3,12.1H14A6,6 0 0,0 20,6.1C20,3.8 16.4,2 12,2M6.5,12A1.5,1.5 0 1,1 8,10.5A1.5,1.5 0 0,1 6.5,12M9.5,8A1.5,1.5 0 1,1 11,6.5A1.5,1.5 0 0,1 9.5,8M14.5,8A1.5,1.5 0 1,1 16,6.5A1.5,1.5 0 0,1 14.5,8M17.5,12A1.5,1.5 0 1,1 19,10.5A1.5,1.5 0 0,1 17.5,12Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Star">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Bot">M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Lightning">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Coffee">M2,21H20V19H2M20,8H18V5H20M20,3H4V13A4,4 0 0,0 8,17H14A4,4 0 0,0 18,13V10H20A2,2 0 0,0 22,8V5C22,3.89 21.1,3 20,3Z</StreamGeometry>
        <StreamGeometry x:Key="AvatarIcon_Heart">M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z</StreamGeometry>

        <!-- Tab Close Button Style -->
        <Style x:Key="CardCloseBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#949BA4"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <TextBlock Text="✕" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2B2D30"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderBrush" Value="#36393E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35373C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Profiles WrapPanel -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,32,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Border Width="34" Height="34" CornerRadius="8" Background="#3B82F6" Margin="0,0,10,0">
                    <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Dataset Browser" FontWeight="Bold" FontSize="22" Foreground="#F2F3F5" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="چه کسی از مرورگر استفاده می‌کند؟" FontWeight="Bold" FontSize="19" Foreground="#F2F3F5" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="یک اکانت را برای ورود انتخاب کنید یا پروفایل جدیدی بسازید" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Profiles Container -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <WrapPanel x:Name="ProfilesWrapPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                
                <!-- Dynamic Profile Cards are injected here in code-behind -->
                
                <!-- Add New Profile Card -->
                <Border x:Name="BtnAddProfileCard"
                        Width="160" Height="190"
                        Margin="12"
                        Background="#2B2D30"
                        BorderBrush="#36393E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Cursor="Hand"
                        MouseLeftButtonDown="BtnAddProfileCard_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.85"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Setter Property="Background" Value="#35373C"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34" Background="#1E1F22" BorderBrush="#36393E" BorderThickness="1.5" Margin="0,0,0,14">
                            <TextBlock Text="+" FontSize="28" FontWeight="Light" Foreground="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <TextBlock Text="افزودن اکانت جدید" FontWeight="SemiBold" FontSize="14" Foreground="#F2F3F5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#2B2D30" BorderBrush="#36393E" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Guest / Default Mode -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- Startup Option Checkbox -->
                </Grid.ColumnDefinitions>

                <!-- Quick Guest Mode Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Click="BtnGuestMode_Click"
                        Height="32"
                        Padding="12,0"
                        ToolTip="ورود سریع با اکانت پیش‌فرض">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ورود با اکانت اول" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Show on Startup Checkbox -->
                <CheckBox x:Name="ChkAlwaysAsk"
                          Grid.Column="2"
                          Content="نمایش این پنجره هنگام اجرای مرورگر"
                          IsChecked="True"
                          Foreground="#949BA4"
                          FontSize="12"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MODAL DIALOG: ADD / EDIT PROFILE               -->
        <!-- ============================================== -->
        <Grid x:Name="AddProfileModal" Grid.Row="0" Grid.RowSpan="3" Background="#B0000000" Visibility="Collapsed">
            <Border Width="420"
                    Background="#25272B"
                    BorderBrush="#36393E"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock x:Name="TxtModalTitle" Text="ساخت اکانت جدید" FontSize="17" FontWeight="Bold" Foreground="#F2F3F5"/>
                        <Button Style="{StaticResource CardCloseBtnStyle}" HorizontalAlignment="Right" Click="CloseModal_Click"/>
                    </Grid>

                    <!-- Avatar Preview -->
                    <Border x:Name="AvatarPreviewCircle"
                            Width="74" Height="74"
                            CornerRadius="37"
                            Background="#3B82F6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Path x:Name="AvatarPreviewPath" Fill="White" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name Input -->
                    <TextBlock Text="نام اکانت" FontWeight="SemiBold" FontSize="13" Foreground="#F2F3F5" Margin="0,0,0,6"/>
                    <Border Background="#1E1F22" CornerRadius="8" BorderBrush="#36393E" BorderThickness="1" Height="38" Margin="0,0,0,16">
                        <TextBox x:Name="TxtModalProfileName"
                                 Text="Account New"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F2F3F5"
                                 CaretBrush="#00E5FF"
                                 FontSize="13"
                                 Padding="10,0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtModalProfileName_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#F2F3F5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CaretBrush" Value="#00E5FF"/>
                                    <Setter Property="SelectionBrush" Value="#3B82F6"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"
                                                              VerticalAlignment="Center"
                                                              Margin="0"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Color Picker -->
                    <TextBlock Text="انتخاب رنگ زمینه" FontWeight="SemiBold" FontSize="13" Foreground="#F2F3F5" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ColorPickerPanel" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <!-- Color buttons populated dynamically -->
                    </WrapPanel>

                    <!-- Icon / Vector Picker -->
                    <TextBlock Text="انتخاب نماد آواتار" FontWeight="SemiBold" FontSize="13" Foreground="#F2F3F5" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="IconPickerPanel" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <!-- Vector buttons populated dynamically -->
                    </WrapPanel>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimaryBtnStyle}" Content="ذخیره و ورود" Click="BtnConfirmCreateProfile_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtnStyle}" Content="انصراف" Click="CloseModal_Click" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
