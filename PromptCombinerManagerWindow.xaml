<Window x:Class="imgsaver.PromptCombinerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Combiner Manager" Width="800" Height="580"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🧩 Smart Prompt Combiner Manager" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Main Content Area (2 Columns) -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Folders -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <TextBlock Text="📁 Categories" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="LstFolders" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LstFolders_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Folder Custom Placement Rule Panel -->
                        <Border x:Name="FolderRulePanel" Grid.Row="2" Background="#1D1D20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,8,6,8" Margin="0,4,0,4">
                            <StackPanel>
                                <TextBlock Text="📍 Folder Placement Rule:" FontSize="10" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboFolderPlacement" Height="24" FontSize="11" Margin="0,0,0,4" SelectionChanged="CboFolderPlacement_SelectionChanged">
                                    <ComboBoxItem Content="After Comma #" Tag="0"/>
                                    <ComboBoxItem Content="At Start (Prepend)" Tag="1"/>
                                    <ComboBoxItem Content="At End (Append)" Tag="2"/>
                                </ComboBox>
                                <StackPanel x:Name="PnlFolderCommaIndex" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="Comma #:" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtFolderCommaIndex" Width="44" Height="26" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" Padding="0,2,0,0" FontSize="13" FontWeight="Bold" Background="#2D2D30" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderBrush="#555555" BorderThickness="1" TextChanged="TxtFolderCommaIndex_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddFolder" Grid.Column="0" Content="+ Category" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="6,0" FontSize="11" Click="BtnAddFolder_Click"/>
                            <Button x:Name="BtnDeleteFolder" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="28" Margin="6,0,0,0" Click="BtnDeleteFolder_Click" ToolTip="Delete Category" Padding="0">
                                <TextBlock Text="🗑" Foreground="#FF6B6B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Column: Snippet Items & Settings -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Snippets List Box -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button x:Name="BtnAddItem" Content="+ Add Snippet Button" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" FontSize="11" DockPanel.Dock="Right" Click="BtnAddItem_Click"/>
                                <TextBlock x:Name="TxtCurrentFolderHeader" Text="Prompt Buttons in Folder" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListBox x:Name="LstItems" Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1AFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#3498DB"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource ForegroundMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0" Click="BtnEditItem_Click" Tag="{Binding}" ToolTip="Edit Snippet Button" Padding="0">
                                                        <TextBlock Text="✏" Foreground="#64B5F6" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>
                                                    <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0" Click="BtnDeleteItem_Click" Tag="{Binding}" ToolTip="Delete Snippet Button" Padding="0">
                                                        <TextBlock Text="🗑" Foreground="#FF6B6B" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Placement Rules Card -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="⚙ Placement &amp; Insertion Rules (No Tags Needed)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,8"/>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mode 1: After N-th Comma -->
                                <RadioButton x:Name="RadAfterComma" Content="After Comma #" Foreground="{StaticResource ForegroundBrush}" FontSize="11" VerticalAlignment="Center" IsChecked="True" Margin="0,0,4,0" Checked="RadPlacementMode_Changed"/>
                                <TextBox x:Name="TxtCommaIndex" Width="44" Height="26" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="12" FontWeight="Bold" Background="{StaticResource InputBrush}" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0" TextChanged="TxtCommaIndex_TextChanged"/>

                                <!-- Mode 2: At Start -->
                                <RadioButton x:Name="RadAtStart" Content="At Start (Prepend)" Foreground="{StaticResource ForegroundBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" Checked="RadPlacementMode_Changed"/>

                                <!-- Mode 3: At End -->
                                <RadioButton x:Name="RadAtEnd" Content="At End (Append)" Foreground="{StaticResource ForegroundBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" Checked="RadPlacementMode_Changed"/>

                                <!-- Mode 4: Per Folder Rule -->
                                <RadioButton x:Name="RadPerFolder" Content="📂 Per-Folder Rules" Foreground="#2ECC71" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Checked="RadPlacementMode_Changed" ToolTip="Each folder uses its own custom placement rule!"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Action Controls -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <DockPanel LastChildFill="False">
                    <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="16,0" DockPanel.Dock="Right" Click="BtnSave_Click"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="16,0" Margin="0,0,8,0" DockPanel.Dock="Right" Click="BtnClose_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
